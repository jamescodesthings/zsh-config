#!/usr/bin/env zsh

source "${0:a:h}/_stub"

if is not debian; then
  echo "$c[info]skipping:$c[reset] apt base packages are Debian only"
  exit 0
fi

# The list lives in configs/apt/base so updaters/000-debian installs the same one.
PACKAGES=(${(f)"$(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$REPO_DIR/configs/apt/base")"})

echo "$c[info]installing:$c[reset] base packages via apt"
sudo apt-get update || exit 1
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${PACKAGES[@]}" || {
  echo "$c[error]error:$c[reset] apt install failed"
  exit 1
}
echo "$c[success]success:$c[reset] base packages installed"
