#!/usr/bin/env zsh
# Installs the Nerd Font kitty asks for (configs/kitty/kitty.conf:
# DejaVuSansM Nerd Font Mono), so the nf-md icons the CLI helpers print
# (cli-icon) render instead of showing as boxes. Skips when it is there.
# Also run by updaters/125-fonts, so existing machines get it through update.
# Wrapped in braces so zsh parses the whole file before running it.
{
source "${0:a:h}/_stub"

FONT_NAME="DejaVuSansM Nerd Font Mono"
CASK="font-dejavu-sans-mono-nerd-font"
ZIP_URL="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/DejaVuSansMono.zip"

function font-installed() {
  if is osx; then
    [[ -n "$(print -l ~/Library/Fonts/DejaVuSansMNerdFont*(N) /Library/Fonts/DejaVuSansMNerdFont*(N))" ]]
  else
    is available fc-list && fc-list : family | grep -qF "$FONT_NAME"
  fi
}

if font-installed; then
  say info "current: $FONT_NAME"
  exit 0
fi

if is osx; then
  if is not available brew; then
    say fail "homebrew is needed for the $CASK cask (installers/01-homebrew)"
    exit 1
  fi
  say info "installing $FONT_NAME ($CASK)"
  if ! brew install --cask "$CASK"; then
    say fail "could not install the $CASK cask"
    exit 1
  fi
else
  for tool in curl unzip; do
    if is not available "$tool"; then
      say fail "$tool is needed to install $FONT_NAME"
      exit 1
    fi
  done
  dest="$HOME/.local/share/fonts/DejaVuSansMNerdFont"
  tmp="$(mktemp -d)"
  say info "installing $FONT_NAME from the Nerd Fonts release into $dest"
  if ! curl -fsSL -o "$tmp/font.zip" "$ZIP_URL" || ! mkdir -p "$dest" || ! unzip -oq "$tmp/font.zip" 'DejaVuSansMNerdFontMono-*.ttf' -d "$dest"; then
    rm -rf "$tmp"
    say fail "could not download or unpack $ZIP_URL"
    exit 1
  fi
  rm -rf "$tmp"
  is available fc-cache && fc-cache -f "$dest" > /dev/null
fi

if font-installed; then
  say ok "$FONT_NAME installed; restart kitty to use it"
  exit 0
fi
say fail "$FONT_NAME still not found after installing"
exit 1
}
