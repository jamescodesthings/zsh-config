#!/usr/bin/env zsh

source "${0:a:h}/_stub"

check-or-load install-release

if is debian; then
  install-release glow || exit 1
  exit 0
fi

if is available glow; then
  say info "skipping glow already installed"
  exit 0
fi

say info "installing glow via homebrew"
if brew install glow; then
  say ok "glow installed"
  exit 0
fi

say fail "homebrew install failed"
say info "install instructions: https://github.com/charmbracelet/glow"
exit 1
