#!/usr/bin/env zsh

source "${0:a:h}/_stub"

check-or-load install-link
check-or-load link-cheatsheets
check-or-load cheatsheet-test

DEST_DIR=$HOME/.custom
DEST_ZSHRC=$HOME/.zshrc
DEST_ZSHENV=$HOME/.zshenv

mkdir -p $HOME/.local/bin

install-link $REPO_DIR $DEST_DIR
install-link $REPO_DIR/.zshrc $DEST_ZSHRC
install-link $REPO_DIR/.zshenv $DEST_ZSHENV
install-link $REPO_DIR/.zprofile $HOME/.zprofile
install-link $REPO_DIR/configs/python/.default-python-packages $HOME/.default-python-packages
install-link $REPO_DIR/configs/bash/bashrc $HOME/.bashrc
install-link $REPO_DIR/configs/bash/bash_profile $HOME/.bash_profile
link-cheatsheets "$REPO_DIR/cheatsheets"
if ! cheatsheet-test "$REPO_DIR/cheatsheets"; then
  echo "$c[warn]warning:$c[reset] the cheatsheets above will not render with cheat"
fi

echo "$c[success]zshconfig install complete$c[reset]"