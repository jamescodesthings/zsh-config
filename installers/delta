#!/usr/bin/env zsh

source "${0:a:h}/_stub"

check-or-load install-release

if is debian; then
  install-release delta || exit 1
  local site="$HOME/.local/share/zsh/site-functions"
  mkdir -p "$site" || exit 1
  if ! "$HOME/.local/bin/delta" --generate-completion zsh > "$site/_delta"; then
    say fail "could not write the delta zsh completion"
    exit 1
  fi
  exit 0
fi

if is available delta; then
  say info "skipping: delta is already installed"
  exit 0
fi

say info "installing: delta via homebrew"
if brew install git-delta; then
  say ok "delta installed"
  exit 0
fi

say fail "homebrew install failed"
say info "install instructions: https://github.com/dandavison/delta"
exit 1
