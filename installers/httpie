#!/usr/bin/env zsh

source "${0:a:h}/_stub"

if is debian; then
  say info "skipping: httpie is installed by 02-apt-base on Debian"
  exit 0
fi

if is available http; then
  say info "skipping: httpie already installed"
  exit 0
fi

say info "installing: httpie via homebrew"
if brew install httpie; then
  say ok "httpie installed"
  exit 0
fi

say fail "homebrew install failed"
exit 1
