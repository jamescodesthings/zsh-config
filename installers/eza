#!/usr/bin/env zsh

source "${0:a:h}/_stub"

check-or-load install-release

if is debian; then
  install-release eza || exit 1
  exit 0
fi

if is available eza; then
  say info "skipping: eza already installed"
  exit 0
fi

say info "installing: eza via homebrew"
if brew install eza; then
  say ok "eza installed"
  exit 0
fi

say fail "homebrew install failed"
say info "install instructions: https://github.com/eza-community/eza"
exit 1
