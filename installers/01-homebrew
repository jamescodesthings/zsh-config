#!/usr/bin/env zsh

INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh

source "${0:a:h}/_stub"

if is not osx; then
  echo "$c[info]skipping:$c[reset] homebrew is macos only"
  exit 0
fi

# homebrew and the language builds need the Xcode command line tools. The
# install dialog is graphical and cannot be finished from here.
if ! xcode-select -p >/dev/null 2>&1; then
  xcode-select --install
  echo "$c[warn]warning:$c[reset] finish the Xcode command line tools dialog, then run ./install again"
  exit 1
fi

if is available brew; then
  echo "$c[info]skipping:$c[reset] homebrew already installed"
else
  echo "$c[info]installing:$c[reset] homebrew"
  /bin/bash -c "$(curl -fsSL $INSTALL_SCRIPT_URL)"

  if is not equal "$?" "0"; then
    echo "$c[error]error:$c[reset] homebrew install failed"
    exit 1
  fi

  echo "$c[success]success:$c[reset] homebrew installed"

  # a fresh install is not on PATH yet
  for prefix in /opt/homebrew /usr/local; do
    if is executable "$prefix/bin/brew"; then
      eval "$("$prefix/bin/brew" shellenv)"
      break
    fi
  done
fi

# installers/asdf compiles python and ruby, which needs the Brewfile libraries
echo "$c[info]installing:$c[reset] the Brewfile packages"
brew bundle install --no-upgrade --file "$REPO_DIR/configs/brew/Brewfile"

if is not equal "$?" "0"; then
  echo "$c[error]error:$c[reset] brew bundle install failed"
  exit 1
fi

echo "$c[success]success:$c[reset] Brewfile packages installed"
