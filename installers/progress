#!/usr/bin/env zsh

source "${0:a:h}/_stub"

if is debian; then
  say info "skipping progress is installed by 02-apt-base on Debian"
  exit 0
fi

if is available progress; then
  say info "skipping progress already installed"
  exit 0
fi

say info "installing progress via homebrew"
if brew install progress; then
  say ok "progress installed"
  exit 0
fi

say fail "homebrew install failed"
exit 1
