#!/usr/bin/env zsh

source "${0:a:h}/_stub"

check-or-load install-release

if is debian; then
  install-release bat || exit 1
  exit 0
fi

if is available bat; then
  say info "skipping: bat already installed"
  exit 0
fi

say info "installing: bat via homebrew"
if brew install bat; then
  say ok "bat installed"
  exit 0
fi

say fail "homebrew install failed"
say info "install instructions: https://github.com/sharkdp/bat"
exit 1
