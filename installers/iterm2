#!/usr/bin/env zsh
# iTerm2 on macOS: links the zsh-config Dynamic Profile into iTerm2's
# DynamicProfiles folder and writes the global settings in
# configs/iterm2/defaults, taking a backup of the current settings first when
# anything will change. iTerm2 itself comes from the Brewfile. Linux skips.

source "${0:a:h}/_stub"

{
  if ! is osx; then
    say info "skipping: iTerm2 is macOS only"
    exit 0
  fi

  check-or-load install-link

  local app="${ITERM2_APP:-/Applications/iTerm.app}"
  local domain=com.googlecode.iterm2
  local src="$REPO_DIR/configs/iterm2"
  local profiles="$HOME/Library/Application Support/iTerm2/DynamicProfiles"
  local backups="${XDG_STATE_HOME:-$HOME/.local/state}/zsh-config/iterm2-backups"

  if [[ ! -d "$app" ]]; then
    problem "iTerm2 is not installed"
    fix "brew install --cask iterm2" "install it, or run update to install the Brewfile"
    problems
    exit 1
  fi

  # The profile: a Dynamic Profile, which iTerm2 reloads when the file changes
  install-link "$src/zsh-config.json" "$profiles/zsh-config.json" || {
    problem "could not link the iTerm2 profile"
    fix "ls -ld ${(q)profiles}" "check the folder"
  }

  # The iTerm2 utilities (imgcat, it2copy and the rest), fetched once each into
  # ~/.iterm2; path.zsh puts that folder on PATH. iTerm2's own installer is not
  # run, since it also appends to ~/.zshrc, which is this repo's file.
  local utildir="$HOME/.iterm2" u tmp
  local -i fetched=0
  command mkdir -p "$utildir"
  for u in ${(f)"$(<"$src/utilities")"}; do
    [[ -z "$u" || "$u" == \#* || -x "$utildir/$u" ]] && continue
    tmp="$utildir/.$u.part"
    if command curl -fsSL "https://iterm2.com/utilities/$u" -o "$tmp" && command chmod +x "$tmp" && command mv -f "$tmp" "$utildir/$u"; then
      fetched+=1
    else
      command rm -f "$tmp"
      problem "could not fetch the iTerm2 utility $u"
      fix "curl -fsSL https://iterm2.com/utilities/$u -o ~/.iterm2/$u" "fetch it by hand"
    fi
  done
  (( fetched )) && say ok "installed $fetched iTerm2 utilities into $utildir"

  # Global settings, written only where they differ, after one backup
  local line key type value current
  local -i backed_up=0 changed=0
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    key="${line%%|*}"; line="${line#*|}"
    type="${line%%|*}"; value="${line#*|}"
    current="$(command defaults read "$domain" "$key" 2>/dev/null)"
    local want="$value"
    if [[ "$type" == bool ]]; then
      [[ "$value" == true ]] && want=1 || want=0
    fi
    [[ "$current" == "$want" ]] && continue
    if (( ! backed_up )); then
      command mkdir -p "$backups"
      local backup="$backups/$(command date +%Y-%m-%d-%H%M%S).plist"
      if ! command defaults export "$domain" "$backup" 2>/dev/null; then
        problem "could not back up the iTerm2 settings, so none were changed"
        fix "defaults export $domain ~/iterm2-backup.plist" "take a backup by hand"
        problems
        exit 1
      fi
      say info "backed up the iTerm2 settings to $backup"
      backed_up=1
    fi
    command defaults write "$domain" "$key" "-$type" "$value"
    changed+=1
  done < "$src/defaults"

  # Menu shortcuts (configs/iterm2/menu-keys) go into NSUserKeyEquivalents one
  # title at a time with -dict-add, so shortcuts set elsewhere stay. The file's
  # content is remembered once applied, so a rerun writes nothing.
  local menukeys="$src/menu-keys" applied="${XDG_STATE_HOME:-$HOME/.local/state}/zsh-config/iterm2-menu-keys.applied"
  if [[ -f "$menukeys" ]] && ! { [[ -f "$applied" ]] && [[ "$(<"$applied")" == "$(<"$menukeys")" ]] }; then
    if (( ! backed_up )); then
      command mkdir -p "$backups"
      local backup="$backups/$(command date +%Y-%m-%d-%H%M%S).plist"
      if ! command defaults export "$domain" "$backup" 2>/dev/null; then
        problem "could not back up the iTerm2 settings, so the menu shortcuts were not changed"
        fix "defaults export $domain ~/iterm2-backup.plist" "take a backup by hand"
        problems
        exit 1
      fi
      say info "backed up the iTerm2 settings to $backup"
      backed_up=1
    fi
    local title spec
    while IFS='|' read -r title spec; do
      [[ -z "$title" || "$title" == \#* ]] && continue
      command defaults write "$domain" NSUserKeyEquivalents -dict-add "$title" "$spec"
      changed+=1
    done < "$menukeys"
    command mkdir -p "${applied:h}" && command cp "$menukeys" "$applied"
  fi

  # Actions (configs/iterm2/actions.json): the managed ones by title, plus any
  # the user made in iTerm2 that the file does not name, written as one
  # array once per change of the file, after the backup
  # (plus actions.fork.json where a fork keeps its own)
  local actions="$src/actions.json" actions_applied="${XDG_STATE_HOME:-$HOME/.local/state}/zsh-config/iterm2-actions.applied"
  local -a actionsrc=("$src"/actions.json(N) "$src"/actions.fork.json(N))
  local actionsum=""
  (( ${#actionsrc} )) && actionsum="$(command cat "${actionsrc[@]}")"
  if (( ${#actionsrc} )) && ! { [[ -f "$actions_applied" ]] && [[ "$(<"$actions_applied")" == "$actionsum" ]] }; then
    if (( ! backed_up )); then
      command mkdir -p "$backups"
      local backup="$backups/$(command date +%Y-%m-%d-%H%M%S).plist"
      if ! command defaults export "$domain" "$backup" 2>/dev/null; then
        problem "could not back up the iTerm2 settings, so the actions were not changed"
        fix "defaults export $domain ~/iterm2-backup.plist" "take a backup by hand"
        problems
        exit 1
      fi
      say info "backed up the iTerm2 settings to $backup"
      backed_up=1
    fi
    local live; live="$(command mktemp)"
    command defaults export "$domain" "$live" 2>/dev/null
    local xml
    xml="$(command python3 -I -c '
import json, plistlib, sys
managed = []
for f in sys.argv[2:]:
    managed += json.load(open(f))
try:
    current = plistlib.load(open(sys.argv[1], "rb")).get("Actions", [])
except Exception:
    current = []
titles = {a["title"] for a in managed}
merged = [a for a in current if a.get("title") not in titles] + managed
sys.stdout.write(plistlib.dumps(merged).decode())
' "$live" "${actionsrc[@]}")"
    command rm -f "$live"
    if [[ -n "$xml" ]] && command defaults write "$domain" Actions "$xml"; then
      changed+=1
      command mkdir -p "${actions_applied:h}" && print -r -- "$actionsum" > "$actions_applied"
    else
      problem "could not write the iTerm2 actions"
      fix "python3 -m json.tool ${(q)actions}" "check the file"
    fi
  fi

  # Snippets live in iTerm2's own file, not in its settings. The managed ones
  # (configs/iterm2/snippets.json, plus snippets.fork.json where a fork keeps
  # its own) are known by guid; a user's snippet is never changed, and a managed
  # one sharing its title or command is left out, so none is doubled. Once
  # per change of the files, after a backup of the snippets file.
  local snipfile="$HOME/Library/Application Support/iTerm2/snippets.plist"
  local -a snipsrc=("$src"/snippets.json(N) "$src"/snippets.fork.json(N))
  local snips_applied="${XDG_STATE_HOME:-$HOME/.local/state}/zsh-config/iterm2-snippets.applied"
  local snipsum=""
  (( ${#snipsrc} )) && snipsum="$(command cat "${snipsrc[@]}")"
  if (( ${#snipsrc} )) && ! { [[ -f "$snips_applied" ]] && [[ "$(<"$snips_applied")" == "$snipsum" ]] }; then
    command mkdir -p "$backups" "${snipfile:h}"
    if [[ -f "$snipfile" ]]; then
      command cp "$snipfile" "$backups/$(command date +%Y-%m-%d-%H%M%S).snippets.plist"
    fi
    if command python3 -I -c '
import json, plistlib, sys, os
out = sys.argv[1]
managed = []
for f in sys.argv[2:]:
    managed += json.load(open(f))
try:
    current = plistlib.load(open(out, "rb")).get("snippets", [])
except Exception:
    current = []
# ours are known by guid; everything else belongs to the user and stays as it is
ours = {m["guid"] for m in managed}
kept = [s for s in current if s.get("guid") not in ours]
taken_titles = {s.get("title", "").lower() for s in kept}
taken_values = {s.get("value", "").strip() for s in kept}
merged = kept + [m for m in managed
                 if m["title"].lower() not in taken_titles and m["value"].strip() not in taken_values]
tmp = out + ".part"
plistlib.dump({"snippets": merged}, open(tmp, "wb"))
os.replace(tmp, out)
' "$snipfile" "${snipsrc[@]}"; then
      changed+=1
      command mkdir -p "${snips_applied:h}" && print -r -- "$snipsum" > "$snips_applied"
    else
      problem "could not write the iTerm2 snippets"
      fix "python3 -m json.tool ${(q)src}/snippets.json" "check the file"
    fi
  fi

  if (( changed )); then
    say ok "iTerm2: profile linked, $changed settings written; quit and reopen iTerm2 to pick them up"
  else
    say ok "iTerm2: profile linked, settings already current"
  fi
  say info "to make iTerm2 the default terminal: iTerm2 menu, Make iTerm2 Default Term"

  problems || exit 1
  exit 0
}
