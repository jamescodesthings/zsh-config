#!/usr/bin/env zsh

source "${0:a:h}/_stub"

check-or-load install-release

if is debian; then
  install-release tldr || exit 1
  exit 0
fi

if is available tldr; then
  say info "skipping tldr already installed"
  exit 0
fi

say info "installing tldr via homebrew"
if brew install tlrc; then
  say ok "tldr installed"
  exit 0
fi

say fail "homebrew install failed"
say info "install instructions: https://github.com/tldr-pages/tlrc"
exit 1
