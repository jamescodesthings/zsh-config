# iTerm2 global settings that installers/iterm2 writes with `defaults write
# com.googlecode.iterm2`, one per line: key|type|value (type is bool, int,
# float or string). The profile itself is the Dynamic Profile zsh-config.json.
# Default profile: the zsh-config Dynamic Profile
Default Bookmark Guid|string|6F1D3A52-4C2B-4E8A-9B1E-2A7C5D9E0F11
# Copy on select, without the trailing newline
CopySelection|bool|true
CopyLastNewline|bool|false
# Let programs (micro, tmux, ssh sessions) set the clipboard with OSC 52
AllowClipboardAccess|bool|true
# Keep checking for updates
SUEnableAutomaticChecks|bool|true
# Inactive split panes: dimmed a little, text and background together, so
# they stay readable (iTerm2's default dims far more); background windows
# are not dimmed
DimInactiveSplitPanes|bool|true
SplitPaneDimmingAmount|float|0.05
DimOnlyText|bool|false
DimBackgroundWindows|bool|false
# The status bar sits at the bottom (the user's choice, set in iTerm2's
# settings and adopted here); iTerm2 opens a window at launch
StatusBarPosition|int|1
OpenNoWindowsAtStartup|bool|false
