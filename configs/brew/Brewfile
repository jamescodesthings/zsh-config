# The base stack the updaters and the asdf language builds depend on.
# updaters/010-brew installs whatever is missing from this list before the
# later updaters run:
#
#   brew bundle install --no-upgrade --file=configs/brew/Brewfile
#
# It is not an inventory of the machine. uv and bun are not here on purpose:
# their updaters install them when no copy exists, because both are often
# installed by their own installers and a second copy from brew would shadow
# or be shadowed by the first.

# Tools an updater drives
brew "git"
brew "gh"
brew "mas"
brew "asdf"
brew "tlrc"
brew "xcodes"
brew "aria2"       # xcodes downloads Xcode 3 to 5 times faster through it

# Shell tools
brew "glow"
brew "eza"
brew "git-delta"
# git helpers: a terminal UI, and fixups folded into the right commits
brew "lazygit"
brew "git-absorb"
brew "bat"
brew "micro"
brew "httpie"
brew "progress"
brew "direnv"

# The terminal on macOS (a trial replacing kitty; kitty is no longer installed
# here, but its config in configs/kitty stays linked). installers/iterm2 links
# its profile and settings.
cask "iterm2"

# The Nerd Font the terminal profiles use, so the CLI helpers' icons render
# (installers/fonts does the same on Debian)
cask "font-dejavu-sans-mono-nerd-font"

# md-to-html and md-to-pdf
brew "pandoc"
brew "weasyprint"
brew "exiftool"
brew "qpdf"

# python-build: asdf compiles every python from source
brew "openssl@3"
brew "readline"
brew "sqlite"
brew "xz"
brew "zlib"
brew "zstd"
brew "libb2"
brew "tcl-tk"
brew "pkgconf"

# ruby-build, on top of openssl and readline above
brew "libyaml"
brew "gmp"
brew "autoconf"

# node-build installs prebuilt binaries on macOS and needs nothing from here.
# A version with no binary is compiled instead, which takes python (above),
# make and a C++ compiler; Xcode's command line tools provide the last two.
