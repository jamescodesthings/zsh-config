#!/usr/bin/env zsh
# Checks that every `cheat <words>` named in the index sheets (help.md, which
# `cheat help` shows, changes*.md, aliases*.md, setup, troubleshoot and keys) is a sheet that exists: <words> joined with - must
# be a file in this repo's cheatsheets/ or in the cheatsheets/ of a sibling
# repo (../hub, ../readerr, ../pkms, any ../*/cheatsheets). A name found
# nowhere fails. Reads files only; runs no tool.
# Run: tests/help-sheet. Exit 1 on any failure.

REPO_DIR="${0:a:h:h}"
SHEET="$REPO_DIR/cheatsheets/help.md"
# Index sheets whose cheat pointers are checked
INDEXES=("$REPO_DIR"/cheatsheets/{help,changes,changes-older,aliases,aliases-*,setup,troubleshoot,keys,iterm2,iterm2-*}.md(N))
failed=0
fail() { print -r -- "fail: $1"; failed=1 }

[[ -f "$SHEET" ]] || { fail "cheatsheets/help.md is missing"; exit 1 }

dirs=("$REPO_DIR/cheatsheets" "${REPO_DIR:h}"/*/cheatsheets(N/))

# Every `cheat ...` inside backticks; words stop at a bracket or flag
names=()
for ref in ${(f)"$(grep -ohE '`cheat [a-z0-9 -]+`' $INDEXES)"}; do
  local_words="${${ref#\`cheat }%\`}"
  words=(${=local_words})
  words=(${words:#-*})
  (( ${#words} )) || continue
  names+=("${(j:-:)words}")
done
(( ${#names} )) || fail "help.md names no sheets"

unique=(${(u)names})
for name in $unique; do
  found=0
  for d in $dirs; do
    [[ -f "$d/$name.md" ]] && { found=1; break }
  done
  # cheat also takes a unique prefix of a top sheet's name for the first word
  if (( ! found )); then
    first="${name%%-*}" rest="${name#$first}"
    cands=()
    for d in $dirs; do cands+=("$d"/${first}*.md(N)); done
    cands=(${(u)${cands:t:r}}); cands=(${cands:#*-*})
    if (( $#cands == 1 )); then
      for d in $dirs; do [[ -f "$d/${cands[1]}$rest.md" ]] && { found=1; break }; done
    fi
  fi
  (( found )) || fail "an index sheet names cheat ${name//-/ }, but no $name.md exists"
done

(( failed )) && exit 1
print -r -- "ok: every sheet the index sheets name exists (${#unique} checked)"
