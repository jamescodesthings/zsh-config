#!/usr/bin/env zsh
# Tests functions/cheatsheet-test from a plain `zsh -f -c`, as another
# project's script would call it, under shell options that once broke it.
# Run: tests/cheatsheet-test. Exit 1 on any failure.

REPO_DIR="${0:a:h:h}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# A folder name with a space and a glob character, so quoting is tested too
GOOD="$TMP/good [sheets]"
BAD="$TMP/bad"
mkdir -p "$GOOD" "$BAD"
printf '# a\n\n> A sheet.\n\n- Run it:\n\n`a --flag`\n' > "$GOOD/a.md"
printf '# b\n\n> Another.\n\n- `-x`: an option\n' > "$GOOD/b.md"
printf '# c\n\n## not a tldr heading\n' > "$BAD/c.md"

# The shared structure: a top sheet and a child sheet that follow it, and a
# pair that do not
SHAPED="$TMP/shaped"
UNSHAPED="$TMP/unshaped"
mkdir -p "$SHAPED" "$UNSHAPED"
printf '# t\n\n> A tool.\n\n# Getting started\n\n- `t` - start\n\n# See also\n\n- `cheat t go` - go\n' > "$SHAPED/t.md"
printf '# t go\n\n> Go.\n\n# Options\n\n- `--far` - further\n\n# Variables\n\n- `T_FAR` - how far\n\n# See also\n\n- `cheat t`\n' > "$SHAPED/t-go.md"
printf '# u\n\n> A tool.\n\n# Usage\n\n- Start:\n\n`u`\n' > "$UNSHAPED/u.md"
printf '# u go\n\n> Go.\n\n# Options\n\n- `--far`: further\n' > "$UNSHAPED/u-go.md"

failed=0

# expect <exit code> <description> <shell options> <args...>
function expect() {
  local want="$1" what="$2" opts="$3"
  shift 3
  local out code
  out="$(zsh -f -c '
    fpath=("$1/functions" $fpath)
    autoload -Uz is cheat cheat-help cheatsheet-test cheat-render col
    eval "$2"
    shift 2
    cheatsheet-test "$@"
  ' _ "$REPO_DIR" "$opts" "$@" 2>&1)"
  code=$?
  if [[ "$code" == "$want" ]]; then
    echo "ok: $what${opts:+ ($opts)}"
  else
    echo "FAIL: $what${opts:+ ($opts)}: exit $code, wanted $want"
    echo "$out" | sed 's/^/    /'
    failed=1
  fi
}

for opts in '' 'setopt sh_glob' 'setopt no_bare_glob_qual' 'setopt no_glob' 'setopt null_glob' 'setopt ksh_glob' 'emulate sh'; do
  expect 0 "a folder of good sheets passes" "$opts" "$GOOD"
  expect 1 "a folder with a bad sheet fails" "$opts" "$BAD"
done
expect 0 "one good sheet passes" '' "$GOOD/a.md"
expect 1 "a missing path fails" '' "$TMP/nope"
expect 1 "an empty folder fails" '' "$TMP"
expect 0 "sheets in the shared structure pass --strict" '' --strict "$SHAPED"
expect 0 "sheets out of the structure only warn without --strict" '' "$UNSHAPED"
expect 1 "sheets out of the structure fail --strict" '' --strict "$UNSHAPED"

# The row rules, one broken sheet each (all children of the shaped t.md)
ROWS="$TMP/rows"
mkdir -p "$ROWS"
cp "$SHAPED/t.md" "$ROWS/"
printf '# t a\n\n> A.\n\n- `t a`: the old separator\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-a.md"
expect 0 "a colon row only warns without --strict" '' "$ROWS/t-a.md"
expect 1 "a colon row fails --strict" '' --strict "$ROWS/t-a.md"
printf '# t b\n\n> B.\n\n- `t b -v|--verbose` - says more\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-b.md"
expect 1 "flag alternatives outside [ ] fail --strict" '' --strict "$ROWS/t-b.md"
printf '# t c\n\n> C.\n\n- `t c`     - padded by hand\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-c.md"
expect 1 "a row padded by hand fails --strict" '' --strict "$ROWS/t-c.md"
printf '# t d\n\n> D.\n\n# Variables\n\n- `T_D` - d\n\n# Examples\n\n- `t d` - run\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-d.md"
expect 1 "Variables away from just before the last section fails --strict" '' --strict "$ROWS/t-d.md"
printf '# t e\n\n> E.\n\n- a [word]{.nosuch} here\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-e.md"
expect 1 "a span with an unknown colour fails, strict or not" '' "$ROWS/t-e.md"
MORE="$TMP/more"
mkdir -p "$MORE"
printf '# m\n\n> M.\n\n# Getting started\n\n- `m` - start\n\n# More\n\n- `cheat x` - x\n' > "$MORE/m.md"
expect 1 "a top sheet ending in More, not See also, fails --strict" '' --strict "$MORE/m.md"
printf '# m\n\n> M.\n\n# Getting started\n\n- `m` - start\n\n# See Also\n\n- `cheat x` - x\n' > "$MORE/m.md"
expect 1 "the last heading is exactly See also" '' --strict "$MORE/m.md"
HEADS="$TMP/heads"
mkdir -p "$HEADS"
cp "$SHAPED/t.md" "$HEADS/"
printf '# t h\n\n> H.\n\n# Getting Started\n\n- `t h` - go\n\n# See also\n\n- `cheat t` - the t command\n' > "$HEADS/t-h.md"
expect 1 "a standard heading spelled differently fails --strict" '' --strict "$HEADS/t-h.md"
printf '# t i\n\n> I.\n\n# Examples\n\n- `t i` - go\n\n# Options\n\n- `[-f]` - far\n\n# See also\n\n- `cheat t` - the t command\n' > "$HEADS/t-i.md"
expect 1 "standard headings out of order fail --strict" '' --strict "$HEADS/t-i.md"
printf '# t j\n\n> J.\n\n# Usage\n\n- `t j` - go\n\n# Shortcuts\n\n- `t j -q` - quietly\n\n# Options\n\n- `[-q]` - quiet\n\n# Examples\n\n- `t j x` - on x\n\n# Variables\n\n- `T_J` - j\n\n# See also\n\n- `cheat t` - the t command\n' > "$HEADS/t-j.md"
expect 0 "standard headings in order, with a custom one between, pass --strict" '' --strict "$HEADS/t-j.md"
printf '# t k\n\n> K.\n\n- `t k`, `t kk`: two commands, old separator\n\n# See also\n\n- `cheat t` - the t command\n' > "$HEADS/t-k.md"
expect 1 "a row with several commands and the old separator fails --strict" '' --strict "$HEADS/t-k.md"

# Examples are rows and See also holds only cheat or tldr pointers
EX="$TMP/ex"
mkdir -p "$EX"
cp "$SHAPED/t.md" "$EX/"
printf '# t x\n\n> X.\n\n# Examples\n\n`t x now`\n\n# See also\n\n- `cheat t`\n' > "$EX/t-x.md"
expect 0 "a bare backtick example only warns without --strict" '' "$EX/t-x.md"
expect 1 "a bare backtick example fails --strict" '' --strict "$EX/t-x.md"
printf '# t y\n\n> Y.\n\n# Examples\n\n- `t y now` - run it now\n\n# See also\n\n- `cheat t`\n- `tldr tar`\n' > "$EX/t-y.md"
expect 0 "example rows and cheat or tldr pointers pass --strict" '' --strict "$EX/t-y.md"
printf '# t z\n\n> Z.\n\n# Examples\n\n- `t z now` - run it now\n\n# See also\n\n- `cheat t`\n- Exit: 2 on a bad flag\n' > "$EX/t-z.md"
expect 0 "a See also row that is not a pointer only warns without --strict" '' "$EX/t-z.md"
expect 1 "a See also row that is not a pointer fails --strict" '' --strict "$EX/t-z.md"
printf '# t w\n\n> W.\n\n# Examples\n\n- `t w now` - run it now\n\n# See also\n\n- `t w` - a command, not a cheat sheet\n' > "$EX/t-w.md"
expect 1 "a See also row naming a plain command fails --strict" '' --strict "$EX/t-w.md"
printf '# t v\n\n> V.\n\n# Notes\n\n- Exit: 2 on a bad flag\n\n# See also\n\n- `cheat t`\n' > "$EX/t-v.md"
expect 0 "quirks in Notes above a pointer-only See also pass --strict" '' --strict "$EX/t-v.md"

# Skill sheets: lighter rules, found by path or by --skill
SK="$TMP/repo/claude/skills/demo"
SKW="$TMP/repo/shared/skills-wip/demo"
mkdir -p "$SK" "$SKW"
{ printf '# skill demo\n\n> Does a thing.\n\n# Invoke\n\n'; for n in {1..50}; do printf -- '- `demo %s` - step\n' $n; done; printf '\n# See also\n\n- `cheat demo`\n'; } > "$SK/cheatsheet.md"
cp "$SK/cheatsheet.md" "$SKW/cheatsheet.md"
cp "$SK/cheatsheet.md" "$TMP/foo.md"
expect 0 "a skill sheet by path passes --strict (no Getting started, 50 rows)" '' --strict "$SK/cheatsheet.md"
expect 0 "a skills-* folder counts too" '' --strict "$SKW/cheatsheet.md"
expect 0 "a skills folder is searched for cheatsheet.md" '' --strict "$TMP/repo/claude/skills"
expect 1 "the same content as foo.md fails --strict" '' --strict "$TMP/foo.md"
expect 0 "--skill on a plain path passes --strict" '' --skill --strict "$TMP/foo.md"
printf '# skill demo\n\n> Does a thing.\n\n# Invoke\n\n- `demo` - go\n' > "$SK/cheatsheet.md"
expect 0 "a skill sheet may omit See also" '' --strict "$SK/cheatsheet.md"
printf '# skill demo\n\n> Does a thing.\n\n# See also\n\n- `cheat demo`\n\n# Invoke\n\n- `demo` - go\n' > "$SK/cheatsheet.md"
expect 1 "a skill sheet with See also not last fails --strict" '' --strict "$SK/cheatsheet.md"
printf '# skill demo\n\n- `demo` - go\n' > "$SK/cheatsheet.md"
expect 1 "a skill sheet without a purpose line fails --strict" '' --strict "$SK/cheatsheet.md"
printf '# skill demo\n\n> Does a thing.\n\n- `demo`: go\n' > "$SK/cheatsheet.md"
expect 1 "a skill sheet with a colon row fails --strict" '' --strict "$SK/cheatsheet.md"
printf '# skill demo\n\n> Does a thing.\n\n- `demo`     - go\n' > "$SK/cheatsheet.md"
expect 1 "a skill sheet with a padded row fails --strict" '' --strict "$SK/cheatsheet.md"
printf '# skill demo\n\n> Does a thing.\n\n# Invoke\n\n`demo`\n' > "$SK/cheatsheet.md"
expect 0 "a skill sheet keeps its bare example lines under --strict" '' --strict "$SK/cheatsheet.md"
printf '# skill demo\n\n> Does a thing.\n\n# See also\n\n- Exit: 2\n' > "$SK/cheatsheet.md"
expect 1 "a skill sheet with a non-pointer See also row fails --strict" '' --strict "$SK/cheatsheet.md"

# Index sheets (hub, hub-action, help) may run to about 90 rendered lines;
# grouped subheads are short phrases with one > tagline; a group may end
# with its own pointer row; one command per row
IDX="$TMP/idx"
mkdir -p "$IDX"
long() { local n=$1; printf '# %s\n\n> An index.\n\n# Getting started\n\n- `%s` - start\n\n# Starting, waking or stopping (safely)\n\n> when you begin or end a day\n\n' "$2" "$2"; for (( k = 1; k <= n; k++ )); do printf -- '- `%s up%s` - row\n' "$2" $k; done; printf -- '- `cheat %s up` - see also\n\n# See also\n\n- `cheat %s go` - go\n' "$2" "$2"; }
long 60 help > "$IDX/help.md"
expect 0 "an index sheet (help) of about 75 lines passes --strict" '' --strict "$IDX/help.md"
long 60 hub > "$IDX/hub.md"
long 60 hub > "$IDX/hub-action.md"
sed -i '' 's/^# hub$/# hub action/' "$IDX/hub-action.md"
expect 0 "hub and hub-action are index sheets too" '' --strict "$IDX/hub.md" "$IDX/hub-action.md"
long 80 help > "$IDX/help.md"
expect 1 "an index sheet past 90 rendered lines fails --strict" '' --strict "$IDX/help.md"
long 60 tool > "$IDX/tool.md"
expect 1 "any other top sheet past 35 lines still fails --strict" '' --strict "$IDX/tool.md"
JOIN="$TMP/join"
mkdir -p "$JOIN"
cp "$SHAPED/t.md" "$JOIN/"
printf '# t p\n\n> P.\n\n# Usage\n\n- `t up|down` - two commands in one row\n\n# See also\n\n- `cheat t`\n' > "$JOIN/t-p.md"
expect 0 "a row joining commands with | only warns without --strict" '' "$JOIN/t-p.md"
expect 1 "a row joining commands with | fails --strict" '' --strict "$JOIN/t-p.md"
printf '# t q\n\n> Q.\n\n# Usage\n\n- `t q --to claude|xirp` - one option, two values\n- `t q [-v|--verbose] <a|b>` - spellings of one option\n\n# See also\n\n- `cheat t`\n' > "$JOIN/t-q.md"
expect 0 "| between values or spellings of one option passes --strict" '' --strict "$JOIN/t-q.md"
printf '# t r\n\n> R.\n\n# Usage\n\n- `t r [--sort ctx|age|name] [-n N|all]` - values in brackets\n- `T_R=always|never t r` - a variable value\n- `t r on|off` - a positional value\n\n# See also\n\n- `cheat t`\n' > "$JOIN/t-r.md"
expect 0 "values after a subcommand, in [ ] or after = pass --strict" '' --strict "$JOIN/t-r.md"
printf '# t s\n\n> S.\n\n# Usage\n\n- `t s add|edit` - two subcommands with sheets\n\n# See also\n\n- `cheat t`\n' > "$JOIN/t-s.md"
printf '# t s add\n\n> A.\n\n# See also\n\n- `cheat t s`\n' > "$JOIN/t-s-add.md"
expect 1 "subcommand words that have their own sheets fail --strict" '' --strict "$JOIN/t-s.md"

exit $failed
