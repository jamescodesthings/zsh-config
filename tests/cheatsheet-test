#!/usr/bin/env zsh
# Tests functions/cheatsheet-test from a plain `zsh -f -c`, as another
# project's script would call it, under shell options that once broke it.
# Run: tests/cheatsheet-test. Exit 1 on any failure.

REPO_DIR="${0:a:h:h}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# A folder name with a space and a glob character, so quoting is tested too
GOOD="$TMP/good [sheets]"
BAD="$TMP/bad"
mkdir -p "$GOOD" "$BAD"
printf '# a\n\n> A sheet.\n\n- Run it:\n\n`a --flag`\n' > "$GOOD/a.md"
printf '# b\n\n> Another.\n\n- `-x`: an option\n' > "$GOOD/b.md"
printf '# c\n\n## not a tldr heading\n' > "$BAD/c.md"

# The shared structure: a top sheet and a child sheet that follow it, and a
# pair that do not
SHAPED="$TMP/shaped"
UNSHAPED="$TMP/unshaped"
mkdir -p "$SHAPED" "$UNSHAPED"
printf '# t\n\n> A tool.\n\n# Getting started\n\n- Start:\n\n`t`\n\n# See also\n\n- `cheat t go [-f|--far]` - go\n' > "$SHAPED/t.md"
printf '# t go\n\n> Go.\n\n# Options\n\n- `--far` - further\n\n# Variables\n\n- `T_FAR` - how far\n\n# See also\n\n- `cheat t`\n' > "$SHAPED/t-go.md"
printf '# u\n\n> A tool.\n\n# Usage\n\n- Start:\n\n`u`\n' > "$UNSHAPED/u.md"
printf '# u go\n\n> Go.\n\n# Options\n\n- `--far`: further\n' > "$UNSHAPED/u-go.md"

failed=0

# expect <exit code> <description> <shell options> <args...>
function expect() {
  local want="$1" what="$2" opts="$3"
  shift 3
  local out code
  out="$(zsh -f -c '
    fpath=("$1/functions" $fpath)
    autoload -Uz is cheat cheat-help cheatsheet-test cheat-render col
    eval "$2"
    shift 2
    cheatsheet-test "$@"
  ' _ "$REPO_DIR" "$opts" "$@" 2>&1)"
  code=$?
  if [[ "$code" == "$want" ]]; then
    echo "ok: $what${opts:+ ($opts)}"
  else
    echo "FAIL: $what${opts:+ ($opts)}: exit $code, wanted $want"
    echo "$out" | sed 's/^/    /'
    failed=1
  fi
}

for opts in '' 'setopt sh_glob' 'setopt no_bare_glob_qual' 'setopt no_glob' 'setopt null_glob' 'setopt ksh_glob' 'emulate sh'; do
  expect 0 "a folder of good sheets passes" "$opts" "$GOOD"
  expect 1 "a folder with a bad sheet fails" "$opts" "$BAD"
done
expect 0 "one good sheet passes" '' "$GOOD/a.md"
expect 1 "a missing path fails" '' "$TMP/nope"
expect 1 "an empty folder fails" '' "$TMP"
expect 0 "sheets in the shared structure pass --strict" '' --strict "$SHAPED"
expect 0 "sheets out of the structure only warn without --strict" '' "$UNSHAPED"
expect 1 "sheets out of the structure fail --strict" '' --strict "$UNSHAPED"

# The row rules, one broken sheet each (all children of the shaped t.md)
ROWS="$TMP/rows"
mkdir -p "$ROWS"
cp "$SHAPED/t.md" "$ROWS/"
printf '# t a\n\n> A.\n\n- `t a`: the old separator\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-a.md"
expect 0 "a colon row only warns without --strict" '' "$ROWS/t-a.md"
expect 1 "a colon row fails --strict" '' --strict "$ROWS/t-a.md"
printf '# t b\n\n> B.\n\n- `t b -v|--verbose` - says more\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-b.md"
expect 1 "flag alternatives outside [ ] fail --strict" '' --strict "$ROWS/t-b.md"
printf '# t c\n\n> C.\n\n- `t c`     - padded by hand\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-c.md"
expect 1 "a row padded by hand fails --strict" '' --strict "$ROWS/t-c.md"
printf '# t d\n\n> D.\n\n# Variables\n\n- `T_D` - d\n\n# Examples\n\n- `t d` - run\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-d.md"
expect 1 "Variables away from just before the last section fails --strict" '' --strict "$ROWS/t-d.md"
printf '# t e\n\n> E.\n\n- a [word]{.nosuch} here\n\n# See also\n\n- `cheat t`\n' > "$ROWS/t-e.md"
expect 1 "a span with an unknown colour fails, strict or not" '' "$ROWS/t-e.md"
MORE="$TMP/more"
mkdir -p "$MORE"
printf '# m\n\n> M.\n\n# Getting started\n\n- `m` - start\n\n# More\n\n- `cheat x` - x\n' > "$MORE/m.md"
expect 1 "a top sheet ending in More, not See also, fails --strict" '' --strict "$MORE/m.md"
printf '# m\n\n> M.\n\n# Getting started\n\n- `m` - start\n\n# See Also\n\n- `cheat x` - x\n' > "$MORE/m.md"
expect 1 "the last heading is exactly See also" '' --strict "$MORE/m.md"

exit $failed
