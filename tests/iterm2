#!/usr/bin/env zsh
# Tests installers/iterm2 and load-iterm2.zsh from a plain zsh, with an empty
# temp HOME and working folder. uname and defaults are stubs: defaults keeps
# its values in a temp folder and logs every call, so the real iTerm2 prefs
# are never read or written. ITERM2_APP points at a temp folder for the app.
# Run: tests/iterm2. Exit 1 on any failure.

REPO_DIR="${0:a:h:h}"
TMP="$(mktemp -d)"; TMP="${TMP:A}"
trap 'rm -rf "$TMP"' EXIT
failed=0
BIN="$TMP/bin"
mkdir -p "$BIN" "$TMP/home" "$TMP/work" "$TMP/prefs" "$TMP/app"
for c in mkdir ln mv rm readlink dirname basename cat date head cp; do
  ln -s "$(command -v $c)" "$BIN/$c"
done
cat > "$BIN/uname" <<'S'
#!/bin/sh
case "$1" in -m) echo arm64 ;; *) echo "${FAKE_OS:-Darwin}" ;; esac
S
# defaults read|write|export <domain> <key> [-type value]
cat > "$BIN/defaults" <<'S'
#!/bin/sh
echo "defaults $*" >> "$PREFS/log"
cmd="$1"; shift; domain="$1"; shift
case "$cmd" in
  read) if [ -d "$PREFS/$1.d" ]; then echo "{"; for f in "$PREFS/$1.d"/*; do printf '    "%s" = "%s";\n' "$(basename "$f")" "$(cat "$f")"; done; echo "}"; exit 0; fi
    [ -f "$PREFS/$1" ] && cat "$PREFS/$1" && exit 0; exit 1 ;;
  write) key="$1"; shift
    if [ "$1" = -dict-add ]; then shift; mkdir -p "$PREFS/$key.d"; printf '%s\n' "$2" > "$PREFS/$key.d/$1"; exit 0; fi
    shift; v="$1"; [ "$v" = true ] && v=1; [ "$v" = false ] && v=0; printf '%s\n' "$v" > "$PREFS/$key" ;;
  export) echo "PLIST" > "$1" ;;
esac
S
# curl -fsSL <url> -o <file>: writes a fake script, logs the url
cat > "$BIN/curl" <<'S'
#!/bin/sh
out=""; url=""
while [ $# -gt 0 ]; do case "$1" in -o) out="$2"; shift ;; -*) ;; *) url="$1" ;; esac; shift; done
echo "$url" >> "$PREFS/curl.log"
printf '#!/bin/sh\necho fake\n' > "$out"
S
ln -s "$(command -v chmod)" "$BIN/chmod"
chmod +x "$BIN"/*

check() { if eval "$2"; then print "ok: $1"; else print "FAIL: $1"; print -r -- "    code $CODE: $OUT"; failed=1; fi }

run() {
  OUT="$(cd "$TMP/work" && env -i HOME="$TMP/home" PATH="$BIN" PREFS="$TMP/prefs" FAKE_OS="${FAKE_OS:-Darwin}" \
    ITERM2_APP="$TMP/app" CUSTOM_DIR="$REPO_DIR" CLI_PLAIN=1 "${commands[zsh]:-/bin/zsh}" "$REPO_DIR/installers/iterm2" "$@" 2>&1 < /dev/null)"
  CODE=$?
}
PROFILE="$TMP/home/Library/Application Support/iTerm2/DynamicProfiles/zsh-config.json"
GUID="$(sed -n '/^Default Bookmark Guid|/s/.*|//p' "$REPO_DIR/configs/iterm2/defaults")"

# the profile in the repo is valid JSON with the fields the sheet promises
check "profile is valid json" '/usr/bin/plutil -lint "$REPO_DIR/configs/iterm2/zsh-config.json" >/dev/null 2>&1 || python3 -m json.tool "$REPO_DIR/configs/iterm2/zsh-config.json" >/dev/null'
for want in '"Terminal Type": "xterm-256color"' '"Option Key Sends": 2' '"Mouse Reporting": true' '"Unlimited Scrollback": true' '"Silence Bell": true' '"Normal Font": "DejaVuSansMNFM 14"'; do
  check "profile has $want" '[[ "$(<"$REPO_DIR/configs/iterm2/zsh-config.json")" == *"$want"* ]]'
done

# the hotkey profile inherits the main one and has a hotkey; the main one has no status bar
check "hotkey profile present" '[[ "$(<"$REPO_DIR/configs/iterm2/zsh-config.json")" == *"\"Dynamic Profile Parent Name\": \"zsh-config\""* && "$(<"$REPO_DIR/configs/iterm2/zsh-config.json")" == *"\"Has Hotkey\": true"* ]]'
check "no status bar" '[[ "$(<"$REPO_DIR/configs/iterm2/zsh-config.json")" == *"\"Show Status Bar\": false"* && "$(<"$REPO_DIR/configs/iterm2/zsh-config.json")" != *"Status Bar Layout"* ]]'

# ctrl+shift+arrows swap panes (iTerm2 actions 53 to 56, read from a key map made in its settings)
check "ctrl+shift+arrows swap panes" '[[ "$(python3 -c "import json;d=json.load(open(\"$REPO_DIR/configs/iterm2/zsh-config.json\"));k=d[\"Profiles\"][0][\"Keyboard Map\"];print(*[k[x][\"Action\"] for x in [\"0xf702-0x260000-0x7b-0x1\",\"0xf703-0x260000-0x7c-0x1\",\"0xf700-0x260000-0x7e-0x1\",\"0xf701-0x260000-0x7d-0x1\"]])")" == "53 54 55 56" ]]'

# the micro profile inherits the main one, switches on for the micro job, and sends ctrl keys
check "micro profile inherits" '[[ "$(python3 -c "import json;d=json.load(open(\"$REPO_DIR/configs/iterm2/zsh-config.json\"));p=[x for x in d[\"Profiles\"] if x[\"Name\"]==\"zsh-config micro\"][0];print(p[\"Dynamic Profile Parent Name\"],p[\"Bound Hosts\"][0],p[\"Keyboard Map\"][\"0x73-0x100000\"][\"Text\"],p[\"Keyboard Map\"][\"0x7f-0x100000\"][\"Text\"],p[\"Keyboard Map\"][\"0x64-0x100000\"][\"Text\"])")" == "zsh-config &micro 0x13 [3;5~ 0x04" ]]'

# Linux: skipped, nothing written
FAKE_OS=Linux run
# (_stub refuses a Linux that is not Debian; either way nothing is written)
check "linux: no defaults calls" '[[ ! -f "$TMP/prefs/log" ]]'

# macOS: profile linked, prefs written, a backup taken first
run
check "mac: exit 0" '(( CODE == 0 ))'
check "mac: profile linked" '[[ -L "$PROFILE" && "$(readlink "$PROFILE")" == "$REPO_DIR/configs/iterm2/zsh-config.json" ]]'
check "mac: default profile set" '[[ "$(<"$TMP/prefs/Default Bookmark Guid")" == "$GUID" ]]'
check "mac: counts the settings it wrote" '[[ "$OUT" == *" 23 settings written"* ]]'
check "mac: inactive panes barely dimmed" '[[ "$(<"$TMP/prefs/SplitPaneDimmingAmount")" == 0.05 && "$(<"$TMP/prefs/DimBackgroundWindows")" == 0 ]]'
check "mac: copy on select" '[[ "$(<"$TMP/prefs/CopySelection")" == 1 ]]'
check "mac: backup before the first write" '[[ "$(grep -E "defaults (export|write)" "$TMP/prefs/log" | head -1)" == "defaults export com.googlecode.iterm2 "* ]]'
check "mac: backup file kept" '[[ -n "$(echo "$TMP"/home/.local/state/zsh-config/iterm2-backups/*.plist(N))" ]]'
check "mac: names the default-terminal step" '[[ "$OUT" == *"Make iTerm2 Default Term"* ]]'

# the utilities: every one in configs/iterm2/utilities, executable, in ~/.iterm2
for u in ${(f)"$(grep -v '^#' "$REPO_DIR/configs/iterm2/utilities")"}; do
  check "utility $u installed" '[[ -x "$TMP/home/.iterm2/$u" ]]'
done
check "utilities fetched from iterm2.com" 'grep -q "^https://iterm2.com/utilities/imgcat$" "$TMP/prefs/curl.log"'

# menu shortcuts: every line of configs/iterm2/menu-keys lands in NSUserKeyEquivalents
while IFS='|' read -r title spec; do
  [[ -z "$title" || "$title" == \#* ]] && continue
  want="$spec"
  check "menu key $title" '[[ "$(<"$TMP/prefs/NSUserKeyEquivalents.d/$title")" == "$want" ]]'
done < "$REPO_DIR/configs/iterm2/menu-keys"
check "Open Quickly is cmd+shift+a" 'grep -qx "Open Quickly|@\$a" "$REPO_DIR/configs/iterm2/menu-keys"'
check "split side by side is cmd+enter" '[[ "$(grep "^Split Vertically with Current Profile|" "$REPO_DIR/configs/iterm2/menu-keys")" == *"|@↩" ]]'

# rerun: nothing changes, no new backup, no writes
: > "$TMP/prefs/log"
run
check "rerun: exit 0" '(( CODE == 0 ))'
check "rerun: no writes" '! grep -q "defaults write" "$TMP/prefs/log"'
check "rerun: utilities not fetched again" '[[ "$(grep -c . "$TMP/prefs/curl.log")" == "$(grep -vc "^#" "$REPO_DIR/configs/iterm2/utilities")" ]]'
check "rerun: no backup when nothing changes" '! grep -q "defaults export" "$TMP/prefs/log"'

# never the custom prefs folder: iTerm2 would write its whole plist into the repo
check "never sets LoadPrefsFromCustomFolder" '[[ ! -f "$TMP/prefs/LoadPrefsFromCustomFolder" ]]'

# iTerm2 missing: a problem with the brew fix
rm -rf "$TMP/app"
run
check "no app: exit 1" '(( CODE == 1 ))'
check "no app: names brew" '[[ "$OUT" == *"brew install --cask iterm2"* ]]'
mkdir -p "$TMP/app"

# load-iterm2.zsh: loads only on macOS inside iTerm2
loads() {
  env -i HOME="$TMP/home" PATH="$BIN" FAKE_OS="$1" TERM_PROGRAM="$2" CUSTOM_DIR="$REPO_DIR" "${commands[zsh]:-/bin/zsh}" -f -c '
    fpath=("$CUSTOM_DIR/functions" $fpath); autoload -Uz is
    function zinit() { print -r -- "zinit $*" }
    source "$CUSTOM_DIR/load-iterm2.zsh"' 2>&1
}
check "iTerm2 on macOS loads the integration" '[[ "$(loads Darwin iTerm.app)" == *"zinit snippet"*"shell_integration/zsh"* ]]'
check "kitty on macOS does not" '[[ -z "$(loads Darwin kitty)" ]]'
check "Linux does not" '[[ -z "$(loads Linux iTerm.app)" ]]'

exit $failed
