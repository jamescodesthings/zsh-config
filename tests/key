#!/usr/bin/env zsh
# Tests functions/key against a stub `op` and a scratch store. Run: tests/key.
# Exit 1 on any failure.

REPO_DIR="${0:a:h:h}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
failed=0
mkdir -p "$TMP/bin" "$TMP/zd" "$TMP/work"
KD="$TMP/store"
OPLOG="$TMP/oplog"

# The stub op: logs its argv; `read` prints $STUBDIR/stubkey (exit 1 when
# $STUBDIR/failread exists); `item get` succeeds when $STUBDIR/exists does;
# `item create|edit` copies the --template file to $STUBDIR/template.cap.
cat > "$TMP/bin/op" <<'STUB'
#!/bin/sh
echo "$*" >> "$OPLOG"
case "$1" in
  read)
    [ -e "$STUBDIR/failread" ] && exit 1
    cat "$STUBDIR/stubkey"
    exit 0 ;;
  item)
    case "$2" in
      get) [ -e "$STUBDIR/exists" ] && exit 0
           if [ -e "$STUBDIR/getfail" ]; then echo "network unreachable" >&2; exit 1; fi
           echo "\"x\" isn't an item in the \"V\" vault" >&2; exit 1 ;;
      create|edit)
        for a in "$@"; do
          case "$a" in --template=*) cp "${a#--template=}" "$STUBDIR/template.cap" ;; esac
        done
        exit 0 ;;
    esac ;;
esac
exit 1
STUB
chmod +x "$TMP/bin/op"

I_ERR=$'\U000f0159'

# run <code>: sets OUT, ERR, CODE. STDIN names a file fed to stdin.
function run() {
  OUT="$(env -i HOME="$TMP" PATH=/usr/bin:/bin ZDOTDIR="$TMP/zd" CLI_PLAIN=1 KEY_DIR="$KD" \
    KEY_OP_BIN="$TMP/bin/op" STUBDIR="$TMP" OPLOG="$OPLOG" ${=EXTRA_ENV} zsh -f -c '
    fpath=("$1/functions" $fpath)
    autoload -Uz col cli-init cli-icon say cheat-help key
    export CUSTOM_DIR="$1"
    eval "$2"
  ' _ "$REPO_DIR" "$1" 2> "$TMP/err" < "${STDIN:-/dev/null}")"
  CODE=$?
  ERR="$(< "$TMP/err")"
}

function same() {
  if [[ "$2" == "$3" ]]; then echo "ok: $1"
  else echo "FAIL: $1: got ${(q+)2}, wanted ${(q+)3} (exit $CODE)"; failed=1; fi
}
function mode() { stat -f %Lp "$1" 2>/dev/null || stat -c %a "$1"; }
function fresh() { rm -rf "$KD" "$TMP/work"/*(N) "$TMP"/{oplog,exists,failread,getfail,template.cap}(N); print -r -- "stub-key-from-op" > "$TMP/stubkey"; }
print -r -- y > "$TMP/yes"; print -r -- n > "$TMP/no"

