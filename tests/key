run "key export n --var V --to $TMP/work/x"
same "hub export form" "$CODE|$(< $TMP/work/x)|$(cat $OPLOG)" "0|V=imported-k|"
run "key pull n -y --to=$TMP/work/y --var=V"
same "pull without a terminal still exits 1 even with -y" "$CODE" "1"
run "key export --var V n --to $TMP/work/z"
same "options come in any position" "$CODE|$(< $TMP/work/z)" "0|V=imported-k"

# --- required flags and refused options
run "key import n"
same "import without --from exits 2" "$CODE" "2"
run "key export n"
same "export without --to exits 2" "$CODE" "2"
: > $OPLOG
run "key import n --from $TMP/work/i --op op://V/i/f"
same "import refuses --op" "$CODE" "2"
run "key export n --to $TMP/work/z --op op://V/i/f"
same "export refuses --op" "$CODE" "2"
run "key export n --to $TMP/work/z --from $TMP/work/i"
same "export refuses --from" "$CODE" "2"
EXTRA_ENV="KEY_FORCE_TTY=1" run "key pull n --from $TMP/work/i"
same "pull refuses --from" "$CODE" "2"
run "key push n --to $TMP/work/z -y"
same "push refuses --to" "$CODE" "2"
run "key create q --from $TMP/work/i"
same "create refuses --from" "$CODE" "2"
same "none of those called op" "$(cat $OPLOG)" ""
run "key import n --var V --from $TMP/work/i"
same "import takes --var" "$CODE" "0"

# --- old sync forms: exit 2, nothing changed, no op call, a fix naming the new form
function oldsync() {  # oldsync <args> <expected fix>
  fresh; mkdir -p $KD; print -r -- keep > $KD/n.key
  EXTRA_ENV="KEY_FORCE_TTY=1" run "key sync $1"
  same "key sync $1: exit 2" "$CODE" "2"
  same "key sync $1: fix names ${2}" "$([[ $ERR == *"$2"* ]] && echo yes)" "yes"
  same "key sync $1: op never called, store unchanged" "$(cat $OPLOG 2>/dev/null)|$(< $KD/n.key)|$(ls $KD | tr '\n' ' ')" "|keep|n.key "
}
oldsync "n" "key pull n"
oldsync "n --to $TMP/work/f" "key pull n --to $TMP/work/f"
oldsync "n --push" "key push n"
oldsync "n --push -y" "key push n"
oldsync "n -l --to $TMP/work/f" "key export n --to $TMP/work/f"
oldsync "n --local --to $TMP/work/f" "key export n --to $TMP/work/f"
oldsync "n --from $TMP/work/f" "key import n --from $TMP/work/f"
oldsync "n --from $TMP/work/f --push" "key push n --from $TMP/work/f"

exit $failed
