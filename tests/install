#!/usr/bin/env zsh
# Tests install.zsh against a temp installers dir of stubs (INSTALL_INSTALLERS_DIR),
# never the real installers. Run: tests/install. Exit 1 on any failure.

REPO_DIR="${0:a:h:h}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
failed=0
E=$'\e'

mkdir -p "$TMP/inst" "$TMP/home"
printf '#!/usr/bin/env zsh\necho "stub one ran"\nexit 0\n' > "$TMP/inst/10-good"
printf '#!/usr/bin/env zsh\necho "stub two ran"\nexit 1\n' > "$TMP/inst/20-bad"
printf '#!/usr/bin/env zsh\necho "stub three ran"\nexit 0\n' > "$TMP/inst/30-after"
printf '#!/usr/bin/env zsh\necho "never"\n' > "$TMP/inst/_skipme"
chmod +x "$TMP/inst/10-good" "$TMP/inst/20-bad" "$TMP/inst/30-after" "$TMP/inst/_skipme"

# Guard: a stub say binary first on PATH, so macOS /usr/bin/say can never speak
# during the test. It records a call and exits 99; ours must be the function.
mkdir -p "$TMP/bin"
printf '#!/bin/sh\necho called >> "%s/say-called"\nexit 99\n' "$TMP" > "$TMP/bin/say"
chmod +x "$TMP/bin/say"

function check() {
  if eval "$2"; then echo "ok: $1"; else echo "FAIL: $1"; failed=1; fi
}

# run <args...>: sets OUT, ERR, CODE
function run() {
  OUT="$(env -u CUSTOM_DIR -u CLI_PALETTE PATH="$TMP/bin:$PATH" INSTALL_INSTALLERS_DIR="$TMP/inst" HOME="$TMP/home" timeout 300 zsh "$REPO_DIR/install.zsh" "$@" </dev/null 2> "$TMP/err")"
  CODE=$?
  ERR="$(< "$TMP/err")"
}

run --plain
check "exit 1 when an installer failed" '(( CODE == 1 ))'
check "later installers still run" '[[ "$OUT" == *"stub three ran"* ]]'
check "underscore files are skipped" '[[ "$OUT" != *never* ]]'
check "live output is shown" '[[ "$OUT" == *"stub one ran"* ]]'
check "problems block names the failing installer" '[[ "$ERR" == *"20-bad failed"* ]]'
check "problems block does not name the good one" '[[ "$ERR" != *"10-good failed"* ]]'
check "fix line gives the installer path" '[[ "$ERR" == *"$TMP/inst/20-bad"* ]]'
check "plain output has no escape codes" '[[ "$OUT$ERR" != *$E* ]]'

rm "$TMP/inst/20-bad"
run --plain
check "exit 0 when all pass" '(( CODE == 0 ))'
check "no problems block when all pass" '[[ -z "$ERR" ]]'

run --plain -q
check "-q keeps installer output but exits 0" '(( CODE == 0 )) && [[ "$OUT" == *"stub one ran"* ]]'

# a fresh machine: empty HOME, colour forced, no ~/.custom yet
run -q
check "no palette errors on a fresh machine" '[[ "$ERR" != *"no colour called"* ]]'
OUT="$(env -u CUSTOM_DIR -u CLI_PALETTE PATH="$TMP/bin:$PATH" CLICOLOR_FORCE=1 INSTALL_INSTALLERS_DIR="$TMP/inst" HOME="$TMP/home" timeout 300 zsh -c 'source "$1/installers/_stub"; say ok hello; whence -w say' _ "$REPO_DIR" </dev/null 2> "$TMP/err")"
ERR="$(< "$TMP/err")"
check "stub: no palette errors with colour forced" '[[ "$ERR" != *"no colour called"* && "$OUT" == *hello* ]]'
check "stub: say is our function" '[[ "$OUT" == *"say: function"* ]]'

run --help
check "--help exits 0" '(( CODE == 0 ))'

# A fresh box: ./install runs before any .zshenv, so CHEATSHEET_DIR and PATH are
# unset. _stub must default them. Everything runs under env -i, an empty HOME and
# a PATH of symlinks to harmless basics, in an empty working folder. _stub's
# path.zsh can add a real Homebrew bin to that PATH, so the test bodies call
# only _stub, zsh builtins and link-cheatsheets.
ZSH_BIN="${commands[zsh]}"
mkdir -p "$TMP/fresh/bin" "$TMP/fresh/home" "$TMP/fresh/cwd" "$TMP/fresh/sheets" "$TMP/fresh/elsewhere"
for t in uname mkdir ln rm readlink dirname basename; do
  ln -s "$(command -v $t)" "$TMP/fresh/bin/$t"
done
print -r -- '# demo' > "$TMP/fresh/sheets/demo.md"

# fresh <extra env assignment or -> <zsh code>: sets OUT
function fresh() {
  local extra="$1"; shift
  local -a envx=()
  [[ "$extra" != - ]] && envx=("$extra")
  OUT="$(cd "$TMP/fresh/cwd" && env -i HOME="$TMP/fresh/home" PATH="$TMP/fresh/bin" R="$REPO_DIR" T="$TMP/fresh" "${envx[@]}" "$ZSH_BIN" -f -c 'source "$R/installers/_stub" --plain; '"$1" </dev/null 2>&1)"
}

fresh - 'print -r -- "CS=[$CHEATSHEET_DIR]"'
check "fresh: _stub defaults CHEATSHEET_DIR" '[[ "$OUT" == *"CS=[$TMP/fresh/home/cheatsheets]"* ]]'

fresh - 'autoload -Uz link-cheatsheets; link-cheatsheets "$T/sheets"'
check "fresh: link-cheatsheets does not skip" '[[ "$OUT" != *"CHEATSHEET_DIR is not set"* ]]'
check "fresh: link-cheatsheets links the sheet" '[[ -L "$TMP/fresh/home/cheatsheets/demo.md" ]]'

fresh "CHEATSHEET_DIR=$REPO_DIR/cheatsheets" 'print -r -- "CS=[$CHEATSHEET_DIR]"'
check "fresh: CHEATSHEET_DIR inside the repo is replaced" '[[ "$OUT" == *"CS=[$TMP/fresh/home/cheatsheets]"* ]]'

fresh "CHEATSHEET_DIR=$TMP/fresh/elsewhere" 'print -r -- "CS=[$CHEATSHEET_DIR]"'
check "fresh: CHEATSHEET_DIR outside the repo is kept" '[[ "$OUT" == *"CS=[$TMP/fresh/elsewhere]"* ]]'

mkdir -p "$TMP/fresh/home/.local/bin"
fresh - 'print -r -- "PATH=[$PATH]"'
check "fresh: ~/.local/bin is on PATH" '[[ "$OUT" == *"$TMP/fresh/home/.local/bin"* ]]'

check "the say binary was never called" '[[ ! -e "$TMP/say-called" ]]'

(( failed )) && exit 1
exit 0
