#!/bin/sh
# Bootstrap: a fresh Debian may not have zsh, and install.zsh needs it.
if ! command -v zsh >/dev/null 2>&1; then
  if [ -f /etc/debian_version ]; then
    sudo apt-get update && sudo apt-get install -y zsh || exit 1
  else
    echo "this config is built for macOS and Debian; get the clanker to port it"
    exit 1
  fi
fi
exec zsh "$(dirname "$0")/install.zsh" "$@"
