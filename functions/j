#!/usr/bin/env zsh

function _j_data_file() {
  local f="${_Z_DATA:-$HOME/.z}"
  if is not file "$f"; then
    touch "$f" 2>/dev/null || {
      say fail "cannot create z data file: $f"
      return 1
    }
  fi
  echo "$f"
}

function _j_read_entries() {
  local data_file
  data_file=$(_j_data_file) || return 1
  sort -t'|' -k2 -rn "$data_file"
}

function _j_print_entries() {
  while IFS='|' read -r _jp rank _; do
    printf '  %s %s%s%s\n' "$_jp" "${_N}" "$rank" "${_R}"
  done
}

function _j_max_rank() {
  local data_file
  data_file=$(_j_data_file) || { echo "0"; return 0; }
  awk -F'|' 'BEGIN{m=0} {if ($2+0 > m) m=$2+0} END{print m}' "$data_file"
}

function _j_validate_regex() {
  local query="$1"
  printf '' | grep -qE -- "$query" 2>/dev/null
  if (( $? == 2 )); then
    say fail "invalid regex: $query"
    return 1
  fi
}

function _j_match_paths() {
  local query="$1" data_file="$2"
  while IFS='|' read -r _jp _ _; do
    printf '%s\n' "$_jp" | grep -qE -- "$query" 2>/dev/null && printf '%s\n' "$_jp"
  done < "$data_file"
}

# Rewrite z entries under <old> to <new>. Entries that land on an existing path
# are merged: ranks summed, time the larger. Other lines keep their order.
# Args: [--dry-run] <old> <new>
function _j_move() {
  local dry=0
  local -a args=()
  local a
  for a in "$@"; do
    if [[ "$a" == --dry-run ]]; then dry=1; else args+=("$a"); fi
  done
  if (( ${#args[@]} != 2 )) || [[ -z "${args[1]}" || -z "${args[2]}" ]]; then
    say fail "j move requires <old> and <new>"
    return 1
  fi
  local old="${args[1]:a}" new="${args[2]:a}"
  old="${old%/}"; new="${new%/}"
  if [[ -z "$old" || "$new" == "$old" ]]; then
    say fail "<old> and <new> must be different folders"
    return 1
  fi
  if [[ -z "$new" || "$new" == "$old"/* ]]; then
    say fail "<new> must not be inside <old>"
    return 1
  fi

  local data_file; data_file=$(_j_data_file) || return 1
  local tmp report
  tmp=$(mktemp "${data_file}.XXXXXX") || return 1
  report=$(mktemp "${data_file}.XXXXXX") || { rm -f "$tmp"; return 1; }
  # Output goes to $tmp; a line "old -> new" per rewritten path goes to $report
  awk -F'|' -v old="$old" -v new="$new" -v report="$report" '
    BEGIN { ol = length(old) }
    {
      p = $1; moved = 0
      if (p == old || substr(p, 1, ol + 1) == old "/") {
        p = new substr(p, ol + 1); moved = 1
        print $1 " -> " p > report
      }
      if (moved || (p in idx)) {
        if (p in idx && (moved || mv[p])) {
          i = idx[p]; rank[i] += $2; if ($3 + 0 > time[i] + 0) time[i] = $3
          mv[p] = 1; next
        }
      }
      n++; idx[p] = n; path[n] = p; rank[n] = $2; time[n] = $3; mv[p] = moved; raw[n] = $0; mvd[n] = moved
    }
    END {
      for (i = 1; i <= n; i++) {
        if (mv[path[i]]) print path[i] "|" rank[i] "|" time[i]
        else print raw[i]
      }
    }
  ' "$data_file" > "$tmp"
  local count; count=$(wc -l < "$report" | tr -d ' ')
  if (( count == 0 )); then
    rm -f "$tmp" "$report"
    say fail "no entries under $old"
    return 1
  fi
  local line
  if (( dry )); then
    while IFS= read -r line; do echo "would move $line"; done < "$report"
    say info "dry run: would move ${count} entries"
    rm -f "$tmp" "$report"
    return 0
  fi
  command mv "$tmp" "$data_file" || { command rm -f "$tmp" "$report"; return 1; }
  while IFS= read -r line; do print -r -- "${_O}moved${_R} $line"; done < "$report"
  say ok "moved ${count} entries"
  rm -f "$report"
}

# Aliases: fixed bookmarks, one "name<TAB>path" line each, sorted by name, in
# ${XDG_CONFIG_HOME:-$HOME/.config}/zsh-config/j-aliases.
function _j_alias_file() {
  print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/zsh-config/j-aliases"
}

# _j_alias_get <name>: print the path stored for <name>; return 1 when unknown
function _j_alias_get() {
  local file; file="$(_j_alias_file)"
  is file "$file" || return 1
  local n p
  while IFS=$'\t' read -r n p; do
    if [[ "$n" == "$1" ]]; then
      print -r -- "$p"
      return 0
    fi
  done < "$file"
  return 1
}

function _j_alias_names() {
  local file; file="$(_j_alias_file)"
  is file "$file" || return 0
  local n p
  while IFS=$'\t' read -r n p; do print -r -- "$n"; done < "$file"
}

# _j_alias_write <drop-name> [<name> <path>]: rewrite the store without
# <drop-name>, adding <name> <path> when given, sorted, written atomically
function _j_alias_write() {
  local file; file="$(_j_alias_file)"
  command mkdir -p "${file:h}" || return 1
  local tmp; tmp="$(mktemp "${file}.XXXXXX")" || return 1
  {
    if is file "$file"; then
      local n p
      while IFS=$'\t' read -r n p; do
        [[ "$n" == "$1" || ( -n "$2" && "$n" == "$2" ) ]] && continue
        print -r -- "$n"$'\t'"$p"
      done < "$file"
    fi
    [[ -n "$2" ]] && print -r -- "$2"$'\t'"$3"
  } | LC_ALL=C sort -t $'\t' -k1,1 > "$tmp" && command mv "$tmp" "$file" || {
    command rm -f "$tmp"
    return 1
  }
}

# _j_alias_check_name <name>: exit 2 for a name j could not jump to
function _j_alias_check_name() {
  local -a reserved=(list search add bump reorder edit delete clean move stats help alias)
  if is empty "$1" || [[ "$1" == -* || "$1" == *[/[:space:]]* ]]; then
    say fail "j alias: a name has no spaces or slashes and does not start with -: $1"
    return 2
  fi
  if (( ${reserved[(Ie)$1]} )); then
    say fail "j alias: $1 is a j command, pick another name"
    return 2
  fi
}

# _j_alias_pick <what> -v VAR: ask for a missing alias name
function _j_alias_pick() {
  local -a names=("${(@f)$(_j_alias_names)}")
  names=("${names[@]:#}")
  if (( ${#names} == 0 )); then
    say fail "j alias: no aliases yet; add one with j alias add <name> [path]"
    return 1
  fi
  autoload -Uz pick
  pick "$1" "${names[@]}" -v "$2"
}

# _j_distance <a> <b>: print the edit distance between two words
function _j_distance() {
  local a="$1" b="$2"
  local -a prev cur
  local i j cost
  for (( j = 0; j <= ${#b}; j++ )); do prev[j+1]=$j; done
  for (( i = 1; i <= ${#a}; i++ )); do
    cur=($i)
    for (( j = 1; j <= ${#b}; j++ )); do
      [[ "${a[i]}" == "${b[j]}" ]] && cost=0 || cost=1
      cur[j+1]=$(( prev[j+1] + 1 ))
      (( cur[j] + 1 < cur[j+1] )) && cur[j+1]=$(( cur[j] + 1 ))
      (( prev[j] + cost < cur[j+1] )) && cur[j+1]=$(( prev[j] + cost ))
    done
    prev=("${cur[@]}")
  done
  print -r -- "${prev[-1]}"
}

function _j_alias() {
  local sub="$1"
  (( $# )) && shift
  local name dir old file
  case "$sub" in
    add)
      name="$1"
      if is empty "$name"; then
        say fail "j alias add needs a name: j alias add <name> [path]"
        return 2
      fi
      _j_alias_check_name "$name" || return $?
      dir="${${2:-.}:A}"
      if is not dir "$dir"; then
        say fail "not a folder: ${2:-.}"
        return 1
      fi
      old="$(_j_alias_get "$name")"
      _j_alias_write "$name" "$name" "$dir" || { say fail "cannot write $(_j_alias_file)"; return 1 }
      if is not empty "$old"; then
        say ok "updated $name: $dir"
      else
        say ok "added $name: $dir"
      fi
      ;;
    show)
      name="$1"
      if is empty "$name"; then
        _j_alias_pick "show which alias" name || return $?
      fi
      if ! dir="$(_j_alias_get "$name")"; then
        say fail "no alias called $name"
        return 1
      fi
      print -r -- "$dir"
      ;;
    rename)
      if is empty "$1" || is empty "$2"; then
        say fail "j alias rename needs two names: j alias rename <old> <new>"
        return 2
      fi
      _j_alias_check_name "$2" || return $?
      if ! dir="$(_j_alias_get "$1")"; then
        say fail "no alias called $1"
        return 1
      fi
      if _j_alias_get "$2" > /dev/null; then
        say fail "an alias called $2 already exists; remove it first: j alias rm $2"
        return 1
      fi
      _j_alias_write "$1" "$2" "$dir" || { say fail "cannot write $(_j_alias_file)"; return 1 }
      say ok "renamed $1 to $2"
      ;;
    rm)
      name="$1"
      if is empty "$name"; then
        _j_alias_pick "remove which alias" name || return $?
      fi
      if ! _j_alias_get "$name" > /dev/null; then
        say fail "no alias called $name"
        return 1
      fi
      _j_alias_write "$name" || { say fail "cannot write $(_j_alias_file)"; return 1 }
      say ok "removed $name"
      ;;
    list|"")
      file="$(_j_alias_file)"
      local json=0 n p first=1
      [[ "$1" == --json ]] && json=1
      if (( json )); then
        printf '['
        if is file "$file"; then
          while IFS=$'\t' read -r n p; do
            (( first )) || printf ','
            first=0
            n="${n//\\/\\\\}"; n="${n//\"/\\\"}"
            p="${p//\\/\\\\}"; p="${p//\"/\\\"}"
            printf '{"name":"%s","path":"%s"}' "$n" "$p"
          done < "$file"
        fi
        printf ']\n'
        return 0
      fi
      if ! is file "$file" || ! is not empty "$(<"$file")"; then
        say info "no aliases yet; add one with j alias add <name> [path]"
        return 0
      fi
      while IFS=$'\t' read -r n p; do
        if is dir "$p"; then
          print -r -- "  ${_T}${n}${_R} $p"
        else
          print -r -- "  ${_T}${n}${_R} ${_W}${p} (missing)${_R}"
        fi
      done < "$file"
      ;;
    _names)
      _j_alias_names
      ;;
    *)
      local -a subs=(add show rename rm list)
      local s guess best=99 d
      for s in $subs; do
        d="$(_j_distance "$sub" "$s")"
        (( d < best )) && { best=$d; guess=$s }
      done
      if (( best <= 2 )); then
        say fail "j alias: no subcommand called $sub; did you mean $guess?"
      else
        say fail "j alias: no subcommand called $sub; use add, show, rename, rm or list"
      fi
      return 2
      ;;
  esac
}

function j() {
  cheat-help j "$@" && return 0
  autoload -Uz cli-init say problem fix problems col
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"
  local _H _F _T _N _W _O _P _D _R
  col -v _H heading; col -v _F flag; col -v _T target; col -v _N num
  col -v _W warn; col -v _O ok; col -v _P prose; col -v _D dim
  [[ -n "$_H" ]] && _R=$'\e[0m'
  if (( ! $+functions[_z] )); then
    say fail "z plugin not loaded (rupa/z required)"
    return 1
  fi
  local DEPS=(awk sed sort)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  if [[ $# -eq 0 ]]; then
    _z
    return $?
  fi

  local subcmd="$1"
  shift

  case "$subcmd" in

    help)
      cheat j
      ;;

    list)
      _j_read_entries | _j_print_entries
      ;;

    search)
      if is empty "$1"; then _z "$subcmd"; return $?; fi
      local query="$1"
      _j_validate_regex "$query" || return 1
      local found=0
      while IFS='|' read -r _jp rank _; do
        if printf '%s\n' "$_jp" | grep -qE -- "$query" 2>/dev/null; then
          printf '  %s %s%s%s\n' "$_jp" "${_N}" "$rank" "${_R}"
          (( found++ ))
        fi
      done < <(_j_read_entries)
      (( found == 0 )) && say warn "no matches for \"$query\""
      ;;

    add)
      if is empty "$1"; then _z; return $?; fi
      local data_file; data_file=$(_j_data_file) || return 1
      local abs_path="${1:A}"
      local now; now=$(date +%s)
      if awk -F'|' -v p="$abs_path" '$1==p{found=1} END{exit !found}' "$data_file" 2>/dev/null; then
        local tmp; tmp=$(mktemp)
        awk -F'|' -v p="$abs_path" 'BEGIN{OFS="|"} $1==p{$2=$2+1} {print}' "$data_file" > "$tmp" && command mv "$tmp" "$data_file"
        say ok "incremented $abs_path"
      else
        printf '%s|1|%s\n' "$abs_path" "$now" >> "$data_file"
        say ok "added $abs_path"
      fi
      ;;

    delete)
      if is empty "$1"; then _z; return $?; fi
      local query="$1"
      _j_validate_regex "$query" || return 1
      local data_file; data_file=$(_j_data_file) || return 1
      local -a matches=("${(@f)$(_j_match_paths "$query" "$data_file")}")
      matches=("${matches[@]:#}")
      if (( ${#matches[@]} == 0 )); then
        say info "no matches found"; return 0
      fi
      print -r -- "${_H}Matches for '${query}':${_R}"
      for p in "${matches[@]}"; do echo "  $p"; done
      echo ""
      if confirm "Delete ${#matches[@]} entries?"; then
        local query_escaped="${query//\//\\/}"
        LC_ALL=C sed -i -E "/$query_escaped/d" "$data_file"
        say ok "deleted ${#matches[@]} entries"
      else
        say warn "cancelled"
      fi
      ;;

    bump)
      if is empty "$1"; then _z; return $?; fi
      local query="$1"
      _j_validate_regex "$query" || return 1
      local data_file; data_file=$(_j_data_file) || return 1
      local -a matches=("${(@f)$(_j_match_paths "$query" "$data_file")}")
      matches=("${matches[@]:#}")
      if (( ${#matches[@]} == 0 )); then
        say warn "no matches for \"$query\""; return 1
      fi
      if (( ${#matches[@]} > 1 )); then
        say fail "multiple matches - be more specific:"
        for p in "${matches[@]}"; do echo "  $p"; done
        return 1
      fi
      local target="${matches[1]}"
      local max_rank new_rank
      max_rank=$(_j_max_rank)
      new_rank=$(awk -v m="$max_rank" 'BEGIN{print m+1}')
      local tmp; tmp=$(mktemp)
      awk -F'|' -v p="$target" -v r="$new_rank" 'BEGIN{OFS="|"} $1==p{$2=r} {print}' "$data_file" > "$tmp" && command mv "$tmp" "$data_file"
      print -r -- "${_O}bumped${_R} $target ${_N}(rank → $new_rank)${_R}"
      ;;

    reorder)
      local count=10
      if is equal "$1" "--count" && is not empty "$2"; then count="$2"; fi
      local data_file; data_file=$(_j_data_file) || return 1
      local -a top_paths=() top_ranks=()
      local i=0
      while IFS='|' read -r _jp rank _; do
        if (( i >= count )); then break; fi
        top_paths+=("$_jp"); top_ranks+=("$rank")
        i=$(( i + 1 ))
      done < <(_j_read_entries)
      if (( ${#top_paths[@]} == 0 )); then
        say warn "no entries in z history"; return 0
      fi
      local tmp; tmp=$(mktemp)
      printf '%s\n' "${top_paths[@]}" > "$tmp"
      ${EDITOR:-micro} "$tmp"
      local -a new_paths=()
      while IFS= read -r p; do is not empty "$p" && new_paths+=("$p"); done < "$tmp"
      rm -f "$tmp"
      local -a valid_paths=()
      for p in "${new_paths[@]}"; do
        (( ${top_paths[(Ie)$p]} )) && valid_paths+=("$p")
      done
      if (( ${#valid_paths[@]} == 0 )); then
        say fail "no valid paths in reordered file"; return 1
      fi
      local -a sorted_ranks=("${(On)top_ranks[@]}")
      local -A new_rank_map=()
      for (( i=1; i<=${#valid_paths[@]}; i++ )); do
        new_rank_map["${valid_paths[$i]}"]="${sorted_ranks[$i]:-1}"
      done
      local tmp2; tmp2=$(mktemp)
      while IFS='|' read -r _jp rank ts; do
        if is not empty "${new_rank_map[$_jp]}"; then
          printf '%s|%s|%s\n' "$_jp" "${new_rank_map[$_jp]}" "$ts"
        else
          printf '%s|%s|%s\n' "$_jp" "$rank" "$ts"
        fi
      done < "$data_file" > "$tmp2"
      command mv "$tmp2" "$data_file"
      say ok "reordered ${#valid_paths[@]} entries"
      ;;

    clean)
      local data_file; data_file=$(_j_data_file) || return 1
      local -a stale=()
      while IFS='|' read -r _jp _ _; do
        is not existing "$_jp" && stale+=("$_jp")
      done < "$data_file"
      if (( ${#stale[@]} == 0 )); then
        say ok "no stale entries"; return 0
      fi
      print -r -- "${_H}Stale entries (directory no longer exists):${_R}"
      for p in "${stale[@]}"; do print -r -- "  ${_W}${p}${_R}"; done
      echo ""
      if confirm "Delete ${#stale[@]} stale entries?"; then
        local tmp; tmp=$(mktemp)
        while IFS='|' read -r _jp rank ts; do
          is existing "$_jp" && printf '%s|%s|%s\n' "$_jp" "$rank" "$ts"
        done < "$data_file" > "$tmp"
        command mv "$tmp" "$data_file"
        say ok "cleaned ${#stale[@]} entries"
      else
        say warn "cancelled"
      fi
      ;;

    alias)
      _j_alias "$@"
      return $?
      ;;

    move)
      _j_move "$@"
      return $?
      ;;

    stats)
      local data_file; data_file=$(_j_data_file) || return 1
      local total; total=$(wc -l < "$data_file" | tr -d ' ')
      print -r -- "${_H}j stats:${_R}"
      print -r -- "  ${_N}${total}${_R} total entries"
      echo ""
      print -r -- "${_H}Top 5 by rank:${_R}"
      _j_read_entries | head -5 | _j_print_entries
      echo ""
      print -r -- "${_H}Oldest entry:${_R}"
      sort -t'|' -k3 -n "$data_file" | head -1 | while IFS='|' read -r _jp rank ts; do
        local d; d=$(date -d "@$ts" 2>/dev/null || date -r "$ts" 2>/dev/null || echo "ts:$ts")
        printf '  %s %s%s%s (%s)\n' "$_jp" "${_N}" "$rank" "${_R}" "$d"
      done
      echo ""
      print -r -- "${_H}Newest entry:${_R}"
      sort -t'|' -k3 -rn "$data_file" | head -1 | while IFS='|' read -r _jp rank ts; do
        local d; d=$(date -d "@$ts" 2>/dev/null || date -r "$ts" 2>/dev/null || echo "ts:$ts")
        printf '  %s %s%s%s (%s)\n' "$_jp" "${_N}" "$rank" "${_R}" "$d"
      done
      ;;

    edit)
      local data_file; data_file=$(_j_data_file) || return 1
      ${EDITOR:-micro} "$data_file"
      ;;

    *)
      # A lone word that names an alias jumps there before z is asked
      local alias_path
      if (( $# == 0 )) && alias_path="$(_j_alias_get "$subcmd")"; then
        if is not dir "$alias_path"; then
          problem "alias $subcmd points at a missing folder: $alias_path"
          fix "j alias add $subcmd <path>" "point it somewhere else"
          fix "j alias rm $subcmd" "remove it"
          problems
          return 1
        fi
        cd -- "$alias_path"
        return $?
      fi
      _z "$subcmd" "$@"
      return $?
      ;;
  esac
}

j "$@"
