#!/usr/bin/env zsh

function _j_data_file() {
  local f="${_Z_DATA:-$HOME/.z}"
  if is not file "$f"; then
    touch "$f" 2>/dev/null || {
      echo "${c[error]}error:${c[reset]} cannot create z data file: $f" >&2
      return 1
    }
  fi
  echo "$f"
}

function _j_read_entries() {
  local data_file
  data_file=$(_j_data_file) || return 1
  sort -t'|' -k2 -rn "$data_file"
}

function _j_print_entries() {
  while IFS='|' read -r _jp rank _; do
    printf '  %s %s%s%s\n' "$_jp" "${c[info]}" "$rank" "${c[reset]}"
  done
}

function _j_max_rank() {
  local data_file
  data_file=$(_j_data_file) || { echo "0"; return 0; }
  awk -F'|' 'BEGIN{m=0} {if ($2+0 > m) m=$2+0} END{print m}' "$data_file"
}

function _j_validate_regex() {
  local query="$1"
  printf '' | grep -qE -- "$query" 2>/dev/null
  if (( $? == 2 )); then
    echo "${c[error]}error:${c[reset]} invalid regex: $query" >&2
    return 1
  fi
}

function _j_match_paths() {
  local query="$1" data_file="$2"
  while IFS='|' read -r _jp _ _; do
    printf '%s\n' "$_jp" | grep -qE -- "$query" 2>/dev/null && printf '%s\n' "$_jp"
  done < "$data_file"
}

# Rewrite z entries under <old> to <new>. Entries that land on an existing path
# are merged: ranks summed, time the larger. Other lines keep their order.
# Args: [--dry-run] <old> <new>
function _j_move() {
  local dry=0
  local -a args=()
  local a
  for a in "$@"; do
    if [[ "$a" == --dry-run ]]; then dry=1; else args+=("$a"); fi
  done
  if (( ${#args[@]} != 2 )) || [[ -z "${args[1]}" || -z "${args[2]}" ]]; then
    echo "${c[error]}error:${c[reset]} j move requires <old> and <new>"
    return 1
  fi
  local old="${args[1]:a}" new="${args[2]:a}"
  old="${old%/}"; new="${new%/}"
  if [[ -z "$old" || "$new" == "$old" ]]; then
    echo "${c[error]}error:${c[reset]} <old> and <new> must be different folders"
    return 1
  fi
  if [[ -z "$new" || "$new" == "$old"/* ]]; then
    echo "${c[error]}error:${c[reset]} <new> must not be inside <old>"
    return 1
  fi

  local data_file; data_file=$(_j_data_file) || return 1
  local tmp report
  tmp=$(mktemp "${data_file}.XXXXXX") || return 1
  report=$(mktemp "${data_file}.XXXXXX") || { rm -f "$tmp"; return 1; }
  # Output goes to $tmp; a line "old -> new" per rewritten path goes to $report
  awk -F'|' -v old="$old" -v new="$new" -v report="$report" '
    BEGIN { ol = length(old) }
    {
      p = $1; moved = 0
      if (p == old || substr(p, 1, ol + 1) == old "/") {
        p = new substr(p, ol + 1); moved = 1
        print $1 " -> " p > report
      }
      if (moved || (p in idx)) {
        if (p in idx && (moved || mv[p])) {
          i = idx[p]; rank[i] += $2; if ($3 + 0 > time[i] + 0) time[i] = $3
          mv[p] = 1; next
        }
      }
      n++; idx[p] = n; path[n] = p; rank[n] = $2; time[n] = $3; mv[p] = moved; raw[n] = $0; mvd[n] = moved
    }
    END {
      for (i = 1; i <= n; i++) {
        if (mv[path[i]]) print path[i] "|" rank[i] "|" time[i]
        else print raw[i]
      }
    }
  ' "$data_file" > "$tmp"
  local count; count=$(wc -l < "$report" | tr -d ' ')
  if (( count == 0 )); then
    rm -f "$tmp" "$report"
    echo "${c[error]}error:${c[reset]} no entries under $old"
    return 1
  fi
  local line
  if (( dry )); then
    while IFS= read -r line; do echo "would move $line"; done < "$report"
    echo "${c[info]}dry run: would move ${count} entries${c[reset]}"
    rm -f "$tmp" "$report"
    return 0
  fi
  mv "$tmp" "$data_file" || { rm -f "$tmp" "$report"; return 1; }
  while IFS= read -r line; do echo "${c[success]}moved${c[reset]} $line"; done < "$report"
  echo "${c[success]}moved ${count} entries${c[reset]}"
  rm -f "$report"
}

function j() {
  cheat-help j "$@" && return 0
  if (( ! $+functions[_z] )); then
    echo "${c[error]}error:${c[reset]} z plugin not loaded (rupa/z required)"
    return 1
  fi
  local DEPS=(awk sed sort)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  if [[ $# -eq 0 ]]; then
    _z
    return $?
  fi

  local subcmd="$1"
  shift

  case "$subcmd" in

    help)
      cheat j
      ;;

    list)
      _j_read_entries | _j_print_entries
      ;;

    search)
      if is empty "$1"; then _z "$subcmd"; return $?; fi
      local query="$1"
      _j_validate_regex "$query" || return 1
      local found=0
      while IFS='|' read -r _jp rank _; do
        if printf '%s\n' "$_jp" | grep -qE -- "$query" 2>/dev/null; then
          printf '  %s %s%s%s\n' "$_jp" "${c[info]}" "$rank" "${c[reset]}"
          (( found++ ))
        fi
      done < <(_j_read_entries)
      (( found == 0 )) && echo "${c[warn]}no matches for \"$query\"${c[reset]}"
      ;;

    add)
      if is empty "$1"; then _z; return $?; fi
      local data_file; data_file=$(_j_data_file) || return 1
      local abs_path="${1:A}"
      local now; now=$(date +%s)
      if awk -F'|' -v p="$abs_path" '$1==p{found=1} END{exit !found}' "$data_file" 2>/dev/null; then
        local tmp; tmp=$(mktemp)
        awk -F'|' -v p="$abs_path" 'BEGIN{OFS="|"} $1==p{$2=$2+1} {print}' "$data_file" > "$tmp" && mv "$tmp" "$data_file"
        echo "${c[success]}incremented:${c[reset]} $abs_path"
      else
        printf '%s|1|%s\n' "$abs_path" "$now" >> "$data_file"
        echo "${c[success]}added:${c[reset]} $abs_path"
      fi
      ;;

    delete)
      if is empty "$1"; then _z; return $?; fi
      local query="$1"
      _j_validate_regex "$query" || return 1
      local data_file; data_file=$(_j_data_file) || return 1
      local -a matches=("${(@f)$(_j_match_paths "$query" "$data_file")}")
      matches=("${matches[@]:#}")
      if (( ${#matches[@]} == 0 )); then
        echo "${c[info]}no matches found${c[reset]}"; return 0
      fi
      echo "${c[h2]}Matches for '${query}':${c[reset]}"
      for p in "${matches[@]}"; do echo "  $p"; done
      echo ""
      if confirm "${c[warn]}Delete ${#matches[@]} entries?${c[reset]}"; then
        local query_escaped="${query//\//\\/}"
        LC_ALL=C sed -i -E "/$query_escaped/d" "$data_file"
        echo "${c[success]}deleted ${#matches[@]} entries${c[reset]}"
      else
        echo "${c[warn]}cancelled${c[reset]}"
      fi
      ;;

    bump)
      if is empty "$1"; then _z; return $?; fi
      local query="$1"
      _j_validate_regex "$query" || return 1
      local data_file; data_file=$(_j_data_file) || return 1
      local -a matches=("${(@f)$(_j_match_paths "$query" "$data_file")}")
      matches=("${matches[@]:#}")
      if (( ${#matches[@]} == 0 )); then
        echo "${c[warn]}no matches for \"$query\"${c[reset]}"; return 1
      fi
      if (( ${#matches[@]} > 1 )); then
        echo "${c[error]}error:${c[reset]} multiple matches — be more specific:"
        for p in "${matches[@]}"; do echo "  $p"; done
        return 1
      fi
      local target="${matches[1]}"
      local max_rank new_rank
      max_rank=$(_j_max_rank)
      new_rank=$(awk -v m="$max_rank" 'BEGIN{print m+1}')
      local tmp; tmp=$(mktemp)
      awk -F'|' -v p="$target" -v r="$new_rank" 'BEGIN{OFS="|"} $1==p{$2=r} {print}' "$data_file" > "$tmp" && mv "$tmp" "$data_file"
      echo "${c[success]}bumped:${c[reset]} $target ${c[info]}(rank → $new_rank)${c[reset]}"
      ;;

    reorder)
      local count=10
      if is equal "$1" "--count" && is not empty "$2"; then count="$2"; fi
      local data_file; data_file=$(_j_data_file) || return 1
      local -a top_paths=() top_ranks=()
      local i=0
      while IFS='|' read -r _jp rank _; do
        if (( i >= count )); then break; fi
        top_paths+=("$_jp"); top_ranks+=("$rank")
        i=$(( i + 1 ))
      done < <(_j_read_entries)
      if (( ${#top_paths[@]} == 0 )); then
        echo "${c[warn]}no entries in z history${c[reset]}"; return 0
      fi
      local tmp; tmp=$(mktemp)
      printf '%s\n' "${top_paths[@]}" > "$tmp"
      ${EDITOR:-micro} "$tmp"
      local -a new_paths=()
      while IFS= read -r p; do is not empty "$p" && new_paths+=("$p"); done < "$tmp"
      rm -f "$tmp"
      local -a valid_paths=()
      for p in "${new_paths[@]}"; do
        (( ${top_paths[(Ie)$p]} )) && valid_paths+=("$p")
      done
      if (( ${#valid_paths[@]} == 0 )); then
        echo "${c[error]}error:${c[reset]} no valid paths in reordered file"; return 1
      fi
      local -a sorted_ranks=("${(On)top_ranks[@]}")
      local -A new_rank_map=()
      for (( i=1; i<=${#valid_paths[@]}; i++ )); do
        new_rank_map["${valid_paths[$i]}"]="${sorted_ranks[$i]:-1}"
      done
      local tmp2; tmp2=$(mktemp)
      while IFS='|' read -r _jp rank ts; do
        if is not empty "${new_rank_map[$_jp]}"; then
          printf '%s|%s|%s\n' "$_jp" "${new_rank_map[$_jp]}" "$ts"
        else
          printf '%s|%s|%s\n' "$_jp" "$rank" "$ts"
        fi
      done < "$data_file" > "$tmp2"
      mv "$tmp2" "$data_file"
      echo "${c[success]}reordered ${#valid_paths[@]} entries${c[reset]}"
      ;;

    clean)
      local data_file; data_file=$(_j_data_file) || return 1
      local -a stale=()
      while IFS='|' read -r _jp _ _; do
        is not existing "$_jp" && stale+=("$_jp")
      done < "$data_file"
      if (( ${#stale[@]} == 0 )); then
        echo "${c[success]}no stale entries${c[reset]}"; return 0
      fi
      echo "${c[h2]}Stale entries (directory no longer exists):${c[reset]}"
      for p in "${stale[@]}"; do echo "  ${c[warn]}${p}${c[reset]}"; done
      echo ""
      if confirm "Delete ${#stale[@]} stale entries?"; then
        local tmp; tmp=$(mktemp)
        while IFS='|' read -r _jp rank ts; do
          is existing "$_jp" && printf '%s|%s|%s\n' "$_jp" "$rank" "$ts"
        done < "$data_file" > "$tmp"
        mv "$tmp" "$data_file"
        echo "${c[success]}cleaned ${#stale[@]} entries${c[reset]}"
      else
        echo "${c[warn]}cancelled${c[reset]}"
      fi
      ;;

    move)
      _j_move "$@"
      return $?
      ;;

    stats)
      local data_file; data_file=$(_j_data_file) || return 1
      local total; total=$(wc -l < "$data_file" | tr -d ' ')
      echo "${c[h1]}j stats:${c[reset]}"
      echo "  ${c[info]}${total}${c[reset]} total entries"
      echo ""
      echo "${c[h2]}Top 5 by rank:${c[reset]}"
      _j_read_entries | head -5 | _j_print_entries
      echo ""
      echo "${c[h2]}Oldest entry:${c[reset]}"
      sort -t'|' -k3 -n "$data_file" | head -1 | while IFS='|' read -r _jp rank ts; do
        local d; d=$(date -d "@$ts" 2>/dev/null || date -r "$ts" 2>/dev/null || echo "ts:$ts")
        printf '  %s %s%s%s (%s)\n' "$_jp" "${c[info]}" "$rank" "${c[reset]}" "$d"
      done
      echo ""
      echo "${c[h2]}Newest entry:${c[reset]}"
      sort -t'|' -k3 -rn "$data_file" | head -1 | while IFS='|' read -r _jp rank ts; do
        local d; d=$(date -d "@$ts" 2>/dev/null || date -r "$ts" 2>/dev/null || echo "ts:$ts")
        printf '  %s %s%s%s (%s)\n' "$_jp" "${c[info]}" "$rank" "${c[reset]}" "$d"
      done
      ;;

    edit)
      local data_file; data_file=$(_j_data_file) || return 1
      ${EDITOR:-micro} "$data_file"
      ;;

    *)
      _z "$subcmd" "$@"
      return $?
      ;;
  esac
}

j "$@"
