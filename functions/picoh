#!/usr/bin/env zsh

function picoh() {
  cheat-help picoh "$@" && return 0
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  if is empty "$PICO8"; then
    say fail "PICO8 not set: set it to the path of your PICO-8 binary"
    return 1
  fi

  local extra_params=""
  if is not equal "$(get-hostname)" "zerocalc"; then
    extra_params="-width 512 -height 512 -window_x 0 -window_y 0"
  fi

  $PICO8 $extra_params -root_path "$(pwd)" &
}

picoh "$@"
