#!/usr/bin/env zsh

function git-branch() {
  cheat-help git-branch "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"

  local DEPS=(git)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi
  git rev-parse --abbrev-ref HEAD
}

git-branch "$@"
