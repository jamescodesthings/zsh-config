#!/usr/bin/env zsh

function install-box-config() {
  cheat-help install-box-config "$@" && return 0
  autoload -Uz cli-init say problem fix problems
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"
  if is empty "$@"; then
    problem "install-box-config needs a source and a destination"
    fix "cheat install-box-config" "how to use it"
    problems
    return 2
  fi

  local config_source="$1"
  local config_destination="$2"
  local config_dir="$(dirname "$config_source")"
  local config_filename="$(basename "$config_source")"
  local config_name="${config_filename%.*}"
  local config_extension="${config_filename##*.}"

  local hostname="$(get-hostname)"
  if is empty "$hostname"; then
    say fail "could not determine the hostname"
    return 1
  fi

  local host_overridden_config="$config_dir/$config_name.$hostname.$config_extension"
  if is file "$host_overridden_config"; then
    say info "installing host specific config: $host_overridden_config"
    install-link "$host_overridden_config" "$config_destination"
    return 0
  fi

  local os=""
  if is osx; then
    os="osx"
  elif is linux; then
    os="linux"
  else
    say fail "unsupported OS"
    return 1
  fi

  local os_overridden_config="$config_dir/$config_name.$os.$config_extension"
  if is file "$os_overridden_config"; then
    say info "installing OS specific config: $os_overridden_config"
    install-link "$os_overridden_config" "$config_destination"
    return 0
  fi

  if is file "$config_source"; then
    say info "installing default config: $config_source"
    install-link "$config_source" "$config_destination"
    return 0
  fi

  if is file "$config_destination"; then
    say warn "no config file found for $config_destination, but one already exists at the destination"
    say info "moving config into $host_overridden_config and symlinking it to the destination"
    command mv "$config_destination" "$host_overridden_config"
    install-link "$host_overridden_config" "$config_destination"
    return 0
  fi

  say warn "no config file found for $config_destination"
  return 0
}

install-box-config "$@"