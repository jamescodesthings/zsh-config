#!/usr/bin/env zsh

function npm-update-latest() {
  cheat-help npm-update-latest "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  if is not empty "$1"; then
    say fail "unknown argument: $1"
    return 2
  fi

  local DEPS=(npm)
  if ! deps $DEPS; then
    return 1
  fi

  local outdated_json
  outdated_json=$(npm outdated --json 2>/dev/null)

  if is empty "$outdated_json" || is equal "$outdated_json" "{}"; then
    say ok "all packages are up to date"
    return 0
  fi

  local packages
  packages=($(echo "$outdated_json" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for pkg in data:
    print(pkg)
" 2>/dev/null))

  if is empty "$packages"; then
    say ok "all packages are up to date"
    return 0
  fi

  local total=${#packages[@]}
  say warn "found $total outdated package(s)"
  echo ""

  echo "$outdated_json" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for pkg, info in data.items():
    current  = info.get('current',  'none')
    wanted   = info.get('wanted',   '?')
    latest   = info.get('latest',   '?')
    pkg_type = info.get('type',     '')
    label    = f'  ({pkg_type})' if pkg_type else ''
    print(f'  {pkg}{label}')
    print(f'    current: {current}  ->  wanted: {wanted}  ->  latest: {latest}')
" 2>/dev/null

  echo ""

  local updated=0
  local skipped=0

  for pkg in $packages; do
    local current latest pkg_type
    current=$(echo "$outdated_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('$pkg',{}).get('current','none'))" 2>/dev/null)
    latest=$(echo  "$outdated_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('$pkg',{}).get('latest','?'))"   2>/dev/null)
    pkg_type=$(echo "$outdated_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('$pkg',{}).get('type',''))"    2>/dev/null)

    local type_flag=""
    if is equal "$pkg_type" "devDependencies"; then
      type_flag="--save-dev"
    else
      type_flag="--save"
    fi

    print -r -- "$pkg  $current -> $latest"

    if confirm "  update ${pkg}@latest ($type_flag)?"; then
      say info "running: npm install ${pkg}@latest $type_flag"
      local npm_output npm_exit
      npm_output=$(npm install "${pkg}@latest" $type_flag 2>&1)
      npm_exit=$?
      if (( npm_exit == 0 )); then
        say ok "updated $pkg to latest"
        (( updated++ ))
      else
        print -r -- "$npm_output"
        problem "could not update $pkg"
        fix "npm install ${pkg}@latest $type_flag" "run it by hand to see the error"
      fi
    else
      say info "skipped $pkg"
      (( skipped++ ))
    fi

    echo ""
  done

  say ok "updated: $updated, skipped: $skipped"
  problems
}

npm-update-latest "$@"
