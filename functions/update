#!/usr/bin/env zsh

function update() {
  REPO_DIR=$CUSTOM_DIR/

  if is not dir "$REPO_DIR"; then
    echo "No repository found at $REPO_DIR. Please run 'install' first."
    return 1
  fi

  # --help, --list and updater names are all handled by the script itself.
  $REPO_DIR/update "$@"
}

update "$@"
