#!/usr/bin/env zsh

# Convert a per-dir history file path back to the directory it was recorded in.
# Strips $PER_DIRECTORY_HISTORY_BASE prefix and /$PER_DIRECTORY_HISTORY_FILE suffix.
function _hist_file_to_dir() {
  local base="${PER_DIRECTORY_HISTORY_BASE:-$HOME/.zsh_history_dirs}"
  local hist_file="${PER_DIRECTORY_HISTORY_FILE:-zsh-per-directory-history}"
  local file="$1"
  local dir="${file#$base}"
  dir="${dir%/$hist_file}"
  [[ -z "$dir" ]] && dir="/"
  echo "$dir"
}

# Print deduplicated history lines from a file.
# Strips ': timestamp:elapsed;' prefix. Groups dupes, appends ' (N)' count in info colour.
# Args: <file> [query] [quiet]
function _hist_print_deduped() {
  local file="$1" query="$2" quiet="$3"
  local indent="  "
  [[ -n "$quiet" ]] && indent=""
  [[ ! -f "$file" ]] && return

  local -A counts=()
  local -a order=()

  while IFS= read -r cmd; do
    [[ -z "$cmd" ]] && continue
    if [[ -n "$query" ]] && ! printf '%s\n' "$cmd" | grep -qE -- "$query" 2>/dev/null; then
      continue
    fi
    if (( ! ${+counts[(e)$cmd]} )); then
      order+=("$cmd")
      counts[(e)$cmd]=1
    else
      (( counts[(e)$cmd]++ ))
    fi
  done < <(sed 's/^: [0-9]*:[0-9]*;//' "$file")

  local n display
  for cmd in "${order[@]}"; do
    n=${counts[(e)$cmd]}
    display=""
    if [[ -n "$query" ]]; then
      display=$(printf '%s\n' "$cmd" | grep --color=always -E -- "$query" 2>/dev/null || printf '%s\n' "$cmd")
    else
      display="$cmd"
    fi
    if (( n > 1 )); then
      printf '%s%s %s(%d)%s\n' "$indent" "$display" "${c[info]}" "$n" "${c[reset]}"
    else
      printf '%s%s\n' "$indent" "$display"
    fi
  done
}

# Print raw (no dedup) history lines from a file, stripping timestamps.
# Args: <file> [query]
function _hist_print_raw() {
  local file="$1" query="$2"
  [[ ! -f "$file" ]] && return
  if [[ -n "$query" ]]; then
    sed 's/^: [0-9]*:[0-9]*;//' "$file" | grep --color=always -E -- "$query" 2>/dev/null
  else
    sed 's/^: [0-9]*:[0-9]*;//' "$file"
  fi
}

# List all per-directory history files, sorted.
function _hist_files() {
  local base="${PER_DIRECTORY_HISTORY_BASE:-$HOME/.zsh_history_dirs}"
  local hist_file="${PER_DIRECTORY_HISTORY_FILE:-zsh-per-directory-history}"
  find "$base" -name "$hist_file" 2>/dev/null | sort
}

# Print section header for a history file.
# Args: <file> [global_flag — non-empty to render as "(global)"]
function _hist_header() {
  local file="$1" is_global="$2"
  if [[ -n "$is_global" ]]; then
    local display="${file/#$HOME/~}"
    echo "${c[h2]}${display} (global):${c[reset]}"
  else
    local dir
    dir=$(_hist_file_to_dir "$file")
    echo "${c[h2]}${dir}:${c[reset]}"
  fi
}

# Merge two per-directory history files to stdout.
# When both start with a ': epoch:elapsed;' entry, entries (a header line plus
# any continuation lines of a multi-line command) are sorted by epoch, stable,
# so a multi-line entry stays whole. Otherwise the files are just concatenated,
# old then dest, because sorting plain lines is not safe.
function _hist_merge_files() {
  local dest="$1" old="$2" f first
  local ts_re='^: [0-9]+:[0-9]+;'
  local timestamped=1
  for f in "$dest" "$old"; do
    [[ -s "$f" ]] || continue
    IFS= read -r first < "$f"
    [[ "$first" =~ $ts_re ]] || timestamped=0
  done
  if (( ! timestamped )); then
    cat "$old" "$dest"
    return
  fi
  awk '
    function emit() { if (e != "") printf "%d\t%d\t%s\n", ts, ++n, e; e = "" }
    /^: [0-9]+:[0-9]+;/ { emit(); split($0, a, ":"); ts = a[2] + 0; e = $0; next }
    { e = e "\001" $0 }
    END { emit() }
  ' "$dest" "$old" | sort -s -t$'\t' -k1,1n -k2,2n | cut -f3- | tr '\001' '\n'
}

# Move per-directory history of <old> and its subfolders to <new>.
# Args: [--dry-run] <old> <new>
function _hist_move() {
  local base="${PER_DIRECTORY_HISTORY_BASE:-$HOME/.zsh_history_dirs}"
  local hist_file="${PER_DIRECTORY_HISTORY_FILE:-zsh-per-directory-history}"
  base="${base%/}"
  local dry=0
  local -a args=()
  local a
  for a in "$@"; do
    if [[ "$a" == --dry-run ]]; then dry=1; else args+=("$a"); fi
  done
  if (( ${#args[@]} != 2 )) || [[ -z "${args[1]}" || -z "${args[2]}" ]]; then
    echo "${c[error]}error:${c[reset]} hist move requires <old> and <new>"
    return 1
  fi
  local old="${args[1]:a}" new="${args[2]:a}"
  old="${old%/}"; new="${new%/}"
  if [[ -z "$old" || "$new" == "$old" ]]; then
    echo "${c[error]}error:${c[reset]} <old> and <new> must be different folders"
    return 1
  fi
  if [[ -z "$new" || "$new" == "$old"/* ]]; then
    echo "${c[error]}error:${c[reset]} <new> must not be inside <old>"
    return 1
  fi

  local -a files=()
  [[ -d "$base$old" ]] && files=("${(@f)$(find "$base$old" -type f -name "$hist_file" 2>/dev/null | sort)}")
  files=("${files[@]:#}")
  if (( ${#files[@]} == 0 )); then
    echo "${c[error]}error:${c[reset]} no history found under $old"
    return 1
  fi

  local f suffix dest tmp verb moved=0 merged=0 failed=0
  for f in "${files[@]}"; do
    suffix="${f#$base$old}"
    dest="$base$new$suffix"
    if [[ -e "$dest" ]]; then
      verb="merge"; (( merged++ ))
    else
      verb="move"
    fi
    if (( dry )); then
      echo "would $verb ${old}${suffix%/$hist_file} -> ${new}${suffix%/$hist_file}"
      (( moved++ ))
      continue
    fi
    mkdir -p "${dest:h}" || { failed=1; continue; }
    if [[ "$verb" == merge ]]; then
      tmp=$(mktemp "${dest}.XXXXXX") || { failed=1; continue; }
      if _hist_merge_files "$dest" "$f" > "$tmp"; then
        mv "$tmp" "$dest" && rm -f "$f"
      else
        rm -f "$tmp"; failed=1; continue
      fi
    else
      mv "$f" "$dest" || { failed=1; continue; }
    fi
    echo "${c[success]}${verb}d${c[reset]} ${old}${suffix%/$hist_file} -> ${new}${suffix%/$hist_file}"
    (( moved++ ))
  done

  # Remove the old folders that are now empty; never above the old folder itself
  (( dry )) || find "$base$old" -depth -type d -empty -delete 2>/dev/null
  local note=""
  (( merged )) && note=" (${merged} merged)"
  if (( dry )); then
    echo "${c[info]}dry run: would move ${moved} file(s)${note}${c[reset]}"
  else
    echo "${c[success]}moved ${moved} file(s)${note}${c[reset]}"
  fi
  return $failed
}

function hist() {
  cheat-help hist "$@" && return 0
  unset "history[$HISTCMD]"
  local DEPS=(grep sed confirm)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  local base="${PER_DIRECTORY_HISTORY_BASE:-$HOME/.zsh_history_dirs}"
  local hist_file="${PER_DIRECTORY_HISTORY_FILE:-zsh-per-directory-history}"
  local global_file="${_per_directory_history_main_histfile:-$HOME/.zsh_history}"

  local subcmd="${1:-list}"
  [[ $# -gt 0 ]] && shift

  case "$subcmd" in

    list)
      local quiet=""
      [[ "$1" == "-q" || "$1" == "--quiet" ]] && quiet=1
      [[ -z "$quiet" ]] && _hist_header "$global_file" global
      _hist_print_deduped "$global_file" "" "$quiet"
      while IFS= read -r f; do
        [[ "$f" == "$global_file" ]] && continue
        [[ -z "$quiet" ]] && { echo ""; _hist_header "$f"; }
        _hist_print_deduped "$f" "" "$quiet"
      done < <(_hist_files)
      ;;

    search)
      local quiet="" query=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -q|--quiet) quiet=1 ;;
          *) query="$1" ;;
        esac
        shift
      done
      if [[ -z "$query" ]]; then
        echo "${c[error]}error:${c[reset]} hist search requires a query"
        return 1
      fi
      printf '' | grep -qE -- "$query" 2>/dev/null
      if (( $? == 2 )); then
        echo "${c[error]}error:${c[reset]} invalid regex: $query"
        return 1
      fi
      if grep -qE -- "$query" "$global_file" 2>/dev/null; then
        [[ -z "$quiet" ]] && _hist_header "$global_file" global
        _hist_print_deduped "$global_file" "$query" "$quiet"
      fi
      while IFS= read -r f; do
        [[ "$f" == "$global_file" ]] && continue
        grep -qE -- "$query" "$f" 2>/dev/null || continue
        [[ -z "$quiet" ]] && { echo ""; _hist_header "$f"; }
        _hist_print_deduped "$f" "$query" "$quiet"
      done < <(_hist_files)
      ;;

    delete)
      local query="$1"
      if [[ -z "$query" ]]; then
        echo "${c[error]}error:${c[reset]} hist delete requires a query"
        return 1
      fi
      printf '' | grep -qE -- "$query" 2>/dev/null
      if (( $? == 2 )); then
        echo "${c[error]}error:${c[reset]} invalid regex: $query"
        return 1
      fi
      echo "${c[h2]}Matches for '${query}':${c[reset]}"
      local -a affected=()
      local total=0
      local n
      if grep -qE -- "$query" "$global_file" 2>/dev/null; then
        echo ""; _hist_header "$global_file" global
        _hist_print_raw "$global_file" "$query"
        n=$(grep -cE -- "$query" "$global_file" 2>/dev/null || echo 0)
        (( total += n ))
        affected+=("$global_file")
      fi
      while IFS= read -r f; do
        [[ "$f" == "$global_file" ]] && continue
        grep -qE -- "$query" "$f" 2>/dev/null || continue
        echo ""; _hist_header "$f"
        _hist_print_raw "$f" "$query"
        n=$(grep -cE -- "$query" "$f" 2>/dev/null || echo 0)
        (( total += n ))
        affected+=("$f")
      done < <(_hist_files)
      if (( total == 0 )); then
        echo "${c[info]}no matches found${c[reset]}"
        return 0
      fi
      echo ""
      if confirm "${c[warn]}Delete ${total} line(s) across ${#affected[@]} file(s)?${c[reset]}"; then
        local query_escaped="${query//\//\\/}"
        for f in "${affected[@]}"; do
          LC_ALL=C sed -i -E "/$query_escaped/d" "$f"
        done
        echo "${c[success]}deleted ${total} lines${c[reset]}"
      else
        echo "${c[warn]}cancelled${c[reset]}"
      fi
      ;;

    open)
      if is available xdg-open; then
        xdg-open "$base"
      elif is available open; then
        open "$base"
      else
        echo "$base"
      fi
      ;;

    clean)
      local -a stale=()
      while IFS= read -r f; do
        local dir
        dir=$(_hist_file_to_dir "$f")
        is not existing "$dir" && stale+=("$f")
      done < <(_hist_files)
      if (( ${#stale[@]} == 0 )); then
        echo "${c[success]}no stale history files${c[reset]}"
        return 0
      fi
      echo "${c[h2]}Stale files (directory no longer exists):${c[reset]}"
      for f in "${stale[@]}"; do
        local dir; dir=$(_hist_file_to_dir "$f")
        echo "  ${c[warn]}${dir}${c[reset]}"
      done
      echo ""
      if confirm "Delete ${#stale[@]} stale file(s)?"; then
        for f in "${stale[@]}"; do rm "$f"; done
        echo "${c[success]}cleaned ${#stale[@]} files${c[reset]}"
      else
        echo "${c[warn]}cancelled${c[reset]}"
      fi
      ;;

    move)
      _hist_move "$@"
      return $?
      ;;

    stats)
      echo "${c[h1]}History stats:${c[reset]}"
      local -a rows=()
      local global_count
      global_count=$(wc -l < "$global_file" 2>/dev/null | tr -d ' ' || echo 0)
      local global_display="${global_file/#$HOME/~} (global)"
      rows+=("${global_count} ${global_display}")
      while IFS= read -r f; do
        [[ "$f" == "$global_file" ]] && continue
        local count; count=$(wc -l < "$f" 2>/dev/null | tr -d ' ' || echo 0)
        local dir; dir=$(_hist_file_to_dir "$f")
        rows+=("${count} ${dir}")
      done < <(_hist_files)
      printf '%s\n' "${rows[@]}" | sort -rn | while IFS=" " read -r count rest; do
        printf '  %s%6d%s  %s\n' "${c[info]}" "$count" "${c[reset]}" "$rest"
      done
      ;;

    help)
      cheat hist
      ;;

    *)
      echo "${c[error]}error:${c[reset]} unknown subcommand: $subcmd"
      echo "see: cheat hist"
      return 1
      ;;
  esac
}

hist "$@"
