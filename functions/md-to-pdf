#!/usr/bin/env zsh

# Records a failure for the problems block, or says a warning at once.
# _md-to-pdf-report <error|warning> <text> [fix command] [reason]
function _md-to-pdf-report() {
  if [[ "$1" == warning ]]; then
    say warn "md-to-pdf: $2"
    return 0
  fi
  problem "md-to-pdf: $2"
  if is not empty "$3"; then
    fix "$3" "$4"
  fi
}

function _md-to-pdf-install() {
  if is osx; then
    print -r -- "brew install $1"
  else
    print -r -- "sudo apt install $2"
  fi
}

# _md-to-pdf-find <dir>: print every .md under <dir>, one per line, skipping
# hidden folders (.git and the like) and node_modules. Order: path order,
# compared byte by byte, except that a folder's README.md or index.md comes
# before everything else in that folder.
function _md-to-pdf-find() {
  setopt localoptions bareglobqual noglobdots
  local f base key
  local -a keyed
  for f in "$1"/**/*.md(N.); do
    [[ "/$f/" == */node_modules/* ]] && continue
    base="${(L)f:t}"
    if [[ "$base" == readme.md || "$base" == index.md ]]; then
      key="${f:h}/"$'\x01'"${f:t}"
    else
      key="$f"
    fi
    keyed+=("$key"$'\t'"$f")
  done
  (( ${#keyed} )) || return 0
  local LC_ALL=C
  print -rl -- "${(@)${(@o)keyed}#*$'\t'}"
}

# _md-to-pdf-merger: print the merge tool's name, or fail
function _md-to-pdf-merger() {
  local join="${MD_TO_PDF_JOIN:-/System/Library/Automator/Combine PDF Pages.action/Contents/MacOS/join}"
  if is available qpdf; then
    print -r -- qpdf
  elif is available pdfunite; then
    print -r -- pdfunite
  elif [[ -x "$join" ]]; then
    print -r -- join
  else
    return 1
  fi
}

# _md-to-pdf-merge <tool> <output> <pdfs...>
function _md-to-pdf-merge() {
  local tool="$1" output="$2"
  shift 2
  case "$tool" in
    qpdf) command qpdf --empty --pages "$@" -- "$output" ;;
    pdfunite) command pdfunite "$@" "$output" ;;
    join) "${MD_TO_PDF_JOIN:-/System/Library/Automator/Combine PDF Pages.action/Contents/MacOS/join}" -o "$output" "$@" ;;
  esac
}

function md-to-pdf() {
  cheat-help md-to-pdf "$@" && return 0
  autoload -Uz cli-init say problem fix problems
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  local combine=0 force=0
  local -a dirs files
  while (( $# )); do
    case "$1" in
      --combine) combine=1 ;;
      -f|--force) force=1 ;;
      -r|--recursive)
        if (( $# < 2 )) || is empty "$2"; then
          say fail "md-to-pdf: $1 needs a folder: md-to-pdf -r [dir]"
          return 2
        fi
        if is not dir "$2"; then
          say fail "md-to-pdf: not a folder: $2"
          return 2
        fi
        dirs+=("$2")
        shift
        ;;
      --) shift; files+=("$@"); break ;;
      *) files+=("$1") ;;
    esac
    shift
  done

  local d found
  for d in $dirs; do
    found="$(_md-to-pdf-find "${d%/}")"
    if is empty "$found"; then
      say fail "md-to-pdf: no .md files under $d"
      return 1
    fi
    files+=("${(@f)found}")
  done
  set -- "${files[@]}"

  if (( $# == 0 )); then
    _md-to-pdf-report error "no input file given" "md-to-pdf path/to/file.md" "convert a file"
    problems
    return 2
  fi

  # --combine checks everything it needs before the first conversion
  local combined="" merger=""
  if (( combine )); then
    combined="$PWD/${PWD:t}.pdf"
    local f
    for f in "$@"; do
      if [[ "${f:A:h}/${${f:t}:r}.pdf" == "$combined" ]]; then
        say fail "md-to-pdf: $f would be written to ${combined:t}, the combined file; rename it or run from another folder"
        return 2
      fi
    done
    if is existing "$combined" && (( ! force )); then
      _md-to-pdf-report error "${combined:t} already exists here" "md-to-pdf --force ${(q)@}" "replace it"
      problems
      return 1
    fi
    if ! merger="$(_md-to-pdf-merger)"; then
      _md-to-pdf-report error "no tool to combine pdfs (qpdf, pdfunite)" "$(_md-to-pdf-install qpdf qpdf)" "install qpdf"
      problems
      return 1
    fi
  fi

  # A start line so a long run is visibly working.
  if (( $# == 1 )); then
    say info "converting $1"
  else
    say info "converting $# files"
  fi

  local file result failed=() done_pdfs=() count=0
  for file in "$@"; do
    (( count += 1 ))
    if (( $# > 1 )); then
      say info "[$count/$#] $file"
    fi
    # An empty argument usually means an unset variable; name it in the
    # summary rather than leaving a blank.
    if is empty "$file"; then
      _md-to-pdf-report error "an empty file name was given; check the variable or quotes that produced it"
      failed+=("(empty name)")
      continue
    fi
    _md-to-pdf-one "$file"
    result=$?
    # An interrupt stops the whole batch.
    if (( result == 130 || result == 143 )); then
      return $result
    fi
    if (( result != 0 )); then
      failed+=("$file")
    else
      done_pdfs+=("${file:h}/${${file:t}:r}.pdf")
    fi
  done

  if (( $# > 1 && ${#failed} == 0 )); then
    say ok "md-to-pdf converted all $# files"
  fi

  if (( combine )); then
    if (( ${#failed} )); then
      _md-to-pdf-report error "${#failed} files failed, so ${combined:t} was not made" "md-to-pdf --combine ${(q)@}" "rerun once they convert"
    elif _md-to-pdf-merge "$merger" "$combined" "${done_pdfs[@]}" >/dev/null 2>&1 || (( $? == 3 )); then
      say ok "combined ${#done_pdfs} pdfs into $combined"
    else
      _md-to-pdf-report error "$merger could not combine the pdfs into ${combined:t}" "$merger --help" "check the tool"
    fi
  fi

  local -i rc=0
  (( ${#failed} )) && rc=1
  problems || rc=1
  return $rc
}

# Converts one file to a pdf beside it.
function _md-to-pdf-one() {
  local input="$1"

  if is empty "$input"; then
    _md-to-pdf-report error "an empty file name was given" "md-to-pdf path/to/file.md" "convert a file"
    return 1
  fi

  # A folder that does not exist is left to md-to-html, which says so.
  if is dir "${input:h}" && is not writeable "${input:h}"; then
    _md-to-pdf-report error "could not write to ${input:h}" "ls -ld ${(q)${input:h}}" "check the folder"
    return 1
  fi

  local name="${${input:t}:r}"
  if is empty "$name"; then
    name="${input:t}"
  fi
  local output="${input:h}/$name.pdf"
  local workdir
  workdir="$(mktemp -d "${${TMPDIR:-/tmp}%/}/md-to-pdf.XXXXXX")"
  if (( $? != 0 )) || is empty "$workdir"; then
    _md-to-pdf-report error "could not create a temp dir under ${TMPDIR:-/tmp}" "df -h ${(q)${TMPDIR:-/tmp}}" "check free space and permissions"
    return 1
  fi

  # The temp dir goes however this ends: success, failure or interrupt. A
  # signal that lands while a command substitution is running does not
  # survive a `return` issued from inside the trap, so the trap only
  # records the interrupt in a variable; each step below checks it once
  # its command substitution has returned control, before trusting that
  # command's own exit status.
  local interrupted=0
  setopt local_options local_traps
  trap 'interrupted=1' INT TERM

  {
    # md-to-html checks the input and pandoc, and labels its errors as ours.
    local MD_CALLER=md-to-pdf
    md-to-html -o "$workdir/$name.html" -- "$input"
    local html_status=$?
    if (( interrupted )); then
      return 130
    elif (( html_status != 0 )); then
      return 1
    fi

    if is not available weasyprint; then
      _md-to-pdf-report error "weasyprint is not installed" "$(_md-to-pdf-install weasyprint weasyprint)" "install it"
      return 1
    fi

    local pdf="$workdir/$name.pdf"
    local messages
    messages="$(weasyprint "$workdir/$name.html" "$pdf" 2>&1)"
    local weasyprint_status=$?
    if (( interrupted )); then
      return 130
    elif (( weasyprint_status != 0 )); then
      _md-to-pdf-report error "weasyprint could not print $input" "weasyprint --verbose file.html out.pdf" "run it by hand to see why"
      print -u2 -r -- "$messages"
      return 1
    fi

    # Drop the producer and creator tags and keep the title. exiftool only
    # marks old values as superseded, so qpdf rewrites the file to remove
    # them; its deterministic id makes an unchanged document render
    # byte-identical. qpdf exits 3 when it succeeds with warnings.
    if is available exiftool && is available qpdf; then
      command exiftool -q -q -overwrite_original -all:all= -PDF:Title="$name" "$pdf" >/dev/null 2>&1 \
        && command qpdf --linearize --deterministic-id "$pdf" "$workdir/clean.pdf" >/dev/null 2>&1
      local scrub=$?
      if (( interrupted )); then
        return 130
      elif (( scrub == 0 || scrub == 3 )) && is file "$workdir/clean.pdf"; then
        pdf="$workdir/clean.pdf"
      else
        _md-to-pdf-report warning "the metadata scrub failed, so the pdf keeps its producer tags; run exiftool and qpdf on the pdf by hand to see why"
      fi
    else
      _md-to-pdf-report warning "exiftool or qpdf is missing, so the pdf keeps its producer tags; install with $(_md-to-pdf-install 'exiftool qpdf' 'libimage-exiftool-perl qpdf')"
    fi

    if (( interrupted )); then
      return 130
    fi

    if ! command mv -f -- "$pdf" "$output" 2>/dev/null; then
      _md-to-pdf-report error "could not write $output" "ls -ld ${(q)${output:h}}" "check that the folder is writable"
      return 1
    fi

    if (( interrupted )); then
      return 130
    fi

    say ok "wrote $output"
  } always {
    rm -rf -- "$workdir"
  }
}

md-to-pdf "$@"
