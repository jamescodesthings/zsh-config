#!/usr/bin/env zsh

FN_DIR=${FN_DIR:=$CUSTOM_DIR/functions}

function _reload_do() {
  local FN="$1"
  unfunction "$FN" 2>/dev/null
  autoload -Uz "$FN"
  echo "$c[success]reloaded:$c[reset] $FN"
}

function reload() {
  cheat-help reload "$@" && return 0
  local DEPS=(is)
  if ! deps $DEPS; then
    return 1
  fi

  if is empty "$1"; then
    echo "$c[error]error:$c[reset] reload needs a function name or all"
    echo "see: cheat reload"
    return 0
  fi

  local FN="$1"

  if is equal "$FN" "all"; then
    local FNS=$(ls $FN_DIR)
    while IFS= read -r FN; do
      _reload_do "$FN"
    done <<< "$FNS"
    return $?
  fi

  _reload_do "$FN"
}

reload "$@"
