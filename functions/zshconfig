#!/usr/bin/env zsh

function zshconfig() {
  cheat-help zshconfig "$@" && return 0

  if is empty "$1"; then
    if is available realpath; then
      cd "$(realpath $CUSTOM_DIR)"
      return 0
    fi
    cd "$CUSTOM_DIR"
    return 0
  fi

  if is equal "$1" "-e" || is equal "$1" "--edit"; then
    if is available code; then
      code "$CUSTOM_DIR"
      return 0
    fi

    if is available micro; then
      micro "$CUSTOM_DIR/.zshrc"
      return 0
    fi

    echo "$c[warn]warning:$c[reset] no editor found"
    echo "run $c[em]$CUSTOM_DIR/installers/micro$c[reset] to install micro"
    return 1
  fi
}

zshconfig "$@"
