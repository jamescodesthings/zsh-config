#!/usr/bin/env zsh

function install-link() {
  cheat-help install-link "$@" && return 0
  autoload -Uz cli-init say problem fix problems
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  if is not equal "$#" "2"; then
    problem "install-link needs a source and a target"
    fix "cheat install-link" "how to use it"
    problems
    return 2
  fi

  local FROM="$1"
  local TO="$2"
  local PARENT="${TO:h}"

  # Only reach for sudo when the target's folder is not ours to write: links
  # made with sudo are owned by root, which breaks editing and removing them
  # on a box where the account is not a full admin.
  if ! command mkdir -p "$PARENT" 2>/dev/null && ! sudo mkdir -p "$PARENT"; then
    say fail "could not create folder $PARENT"
    return 1
  fi
  local AS=command
  if [[ ! -w "$PARENT" ]]; then
    say info "$PARENT is not writable, using sudo"
    AS=sudo
  fi

  if is link "$TO"; then
    say info "removing existing link $TO"
    if ! $AS rm "$TO"; then
      say fail "could not remove existing link $TO"
      return 1
    fi
  fi

  if is file "$TO"; then
    say info "backing up $TO → $TO.bak"
    if ! $AS mv "$TO" "$TO.bak"; then
      say fail "could not back up existing file $TO"
      return 1
    fi
  fi

  if is dir "$TO"; then
    say info "backing up $TO → ${TO}_bak"
    if ! $AS mv "$TO" "${TO}_bak"; then
      say fail "could not back up existing directory $TO"
      return 1
    fi
  fi

  say info "linking $FROM → $TO"
  if ! $AS ln -s "$FROM" "$TO"; then
    say fail "could not create link $FROM → $TO"
    return 1
  fi
}

install-link "$@"
