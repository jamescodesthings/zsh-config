#!/usr/bin/env zsh

# Opens a folder in the file manager: QSpace Pro when it is installed,
# otherwise Finder on macOS and the desktop's default on Linux.
function oh() {
  cheat-help oh "$@" && return 0
  autoload -Uz cli-init say problem fix problems
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  local target="${1:-$PWD}"

  if is not existing "$target"; then
    say fail "oh: $target does not exist"
    return 1
  fi

  if is not dir "$target"; then
    target="${target:A:h}"
  fi
  target="${target:A}"

  if is osx; then
    local qspace="/Applications/QSpace Pro.app"
    if is existing "$qspace"; then
      open -a "$qspace" "$target"
    else
      open "$target"
    fi
    return $?
  fi

  if is available xdg-open; then
    xdg-open "$target" > /dev/null 2>&1 &!
    return 0
  fi

  problem "oh: no file manager opener found"
  fix "sudo apt install xdg-utils" "install an opener"
  problems
  return 1
}

oh "$@"
