#!/usr/bin/env zsh

function git-prune-local_list() {
  git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}'
}

function git-prune-local() {
  cheat-help git-prune-local "$@" && return 0
  local DEPS=(git grep awk xargs confirm)
  if ! deps $DEPS; then
    return 1
  fi


  echo "$c[info]the following branches will be deleted:$c[reset]"
  git-prune-local_list

  if confirm "$c[warn]are you sure you want to delete these branches?$c[reset]"; then
    echo "$c[info]deleting:$c[reset] stale branches"
    git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs git branch -D
    echo "$c[success]success:$c[reset] stale branches deleted"
  fi
}

git-prune-local "$@"
