#!/usr/bin/env zsh

function gcom() {
  cheat-help gcom "$@" && return 0
  cli-init "$@"

  local DEPS=(git)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  local MAIN_BRANCH=$(git config gitflow.branch.main)
  if is empty "$MAIN_BRANCH"; then
    MAIN_BRANCH=main
  fi

  if ! git checkout "$MAIN_BRANCH"; then
    say fail "could not checkout $MAIN_BRANCH"
    say info "set it with: git config gitflow.branch.main main"
    return 1
  fi
}

gcom "$@"
