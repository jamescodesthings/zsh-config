#!/usr/bin/env zsh

function md() {
  cheat-help md "$@" && return 0
  autoload -Uz cli-init say problem fix problems
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"
  local DEPS=(is)
  if ! deps $DEPS; then
    return 1
  fi

  if is empty "$1"; then
    problem "md needs a path"
    fix "cheat md" "how to use it"
    problems
    return 2
  fi

  local NO_FOLLOW=0
  local DIRPATH

  if is equal "$1" "--no-follow"; then
    NO_FOLLOW=1
    DIRPATH="$2"
  else
    DIRPATH="$1"
  fi

  if is empty "$DIRPATH"; then
    problem "no path provided"
    fix "cheat md" "how to use it"
    problems
    return 2
  fi

  if ! mkdir -p "$DIRPATH"; then
    say fail "could not create $DIRPATH"
    return 1
  fi

  if is equal $NO_FOLLOW 0; then
    cd "$DIRPATH"
    say ok "created $DIRPATH"
  else
    say ok "created $DIRPATH (no follow)"
  fi
}

md "$@"
