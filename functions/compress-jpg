#!/usr/bin/env zsh

compress-jpg() {
  cheat-help compress-jpg "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  if [[ -z "$1" ]]; then
    say fail "provide a JPEG file name"
    say info "usage: compress-jpg image.jpg"
    return 2
  fi
  if [[ "$1" == -* ]]; then
    say fail "unknown option: $1"
    return 2
  fi

  # Extract the base name and extension
  local base_name="${${1:t}%.*}"
  local ext="${1##*.}"

  # Create output directory
  mkdir -p compressed

  # Compress using native macOS sips tool
  # -Z 1200 downsizes the largest side to 1200px while locking the aspect ratio
  # formatOptions 80 drops quality to 80% to shave off MBs
  if ! sips -Z 1200 -s formatOptions 80 "$1" --out "compressed/${base_name}.${ext}" &> /dev/null; then
    say fail "could not compress $1"
    return 1
  fi

  say ok "created compressed/${base_name}.${ext}"
}

compress-jpg "$@"
