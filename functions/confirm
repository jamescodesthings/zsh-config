#!/usr/bin/env zsh

function confirm() {
  autoload -Uz cheat-help
  cheat-help confirm "$@" && return 0

  # -y|--yes or CLI_YES=1: yes without asking.
  if [[ "$1" == (-y|--yes) ]] || [[ -n "$CLI_YES" && "$CLI_YES" != 0 ]]; then
    return 0
  fi

  autoload -Uz col
  local warn dim off MESSAGE=${1:-are you sure?}
  col -v warn warn
  col -v dim dim
  [[ -n "$warn" ]] && off=$'\e[0m'
  read "confirmed?${warn}${MESSAGE}${off} ${dim}[y/n]${off} "
  if [[ "$confirmed" =~ ^[Yy]$ ]]; then
    return 0
  else
    return 1
  fi
}

confirm "$@"
