#!/usr/bin/env zsh

function asdf-cleanup() {
  cheat-help asdf-cleanup "$@" && return 0
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  if is not empty "$1"; then
    say fail "unknown argument: $1"
    return 2
  fi

  say info "asdf cleanup"
  local global_versions=$(cat ~/.tool-versions)
  local plugin version versions no_versions global_version
  local -a versions_to_remove

  for plugin in $(asdf plugin list); do
    versions=$(asdf list $plugin 2>/dev/null)
    no_versions="No compatible versions installed ($plugin)"
    if is equal "$versions" "$no_versions"; then
      problem "$plugin: no versions installed"
      fix "asdf plugin remove $plugin" "the plugin has nothing installed"
      continue
    fi

    global_version=$(echo "$global_versions" | grep "^$plugin " | awk '{print $2}' 2>/dev/null)
    if is empty "$global_version"; then
      problem "$plugin: no global version set"
      fix "asdf plugin remove $plugin" "or set a global version with asdf set -u $plugin <version>"
      continue
    fi
    say info "$plugin: keeping $global_version"

    versions_to_remove=()
    for version in ${(f)versions}; do
      if is not substring "$global_version" "$version"; then
        versions_to_remove+=("$version")
      fi
    done

    if is not empty "$versions_to_remove"; then
      for version in $versions_to_remove; do
        say info "$plugin: removing $version"
        if ! asdf uninstall "$plugin" "$version" 2>/dev/null; then
          problem "$plugin: could not remove $version"
          fix "asdf uninstall $plugin $version" "remove it by hand"
        fi
      done
    else
      say ok "$plugin: already clean"
    fi
  done

  problems
}

asdf-cleanup "$@"
