#!/usr/bin/env zsh

function compress-pdf() {
  local DEPS=(gs)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  # Check if a file was provided
  if [ -z "$1" ]; then
    echo "Error: Please provide a PDF file name."
    echo "Usage: compress_pdf input.pdf"
    return 1
  fi

  # Extract the base name without the extension
  local base_name="${${1:t}%.*}"

  # Create output directory
  mkdir -p compressed

  # Run the compression
  gs -q -dNOPAUSE -dBATCH -dSAFER -sDEVICE=pdfwrite \
    -dCompatibilityLevel=1.5 -dPDFSETTINGS=/screen \
    -dEmbedAllFonts=true -dSubsetFonts=true \
    -sOutputFile="compressed/${base_name}.pdf" "$1"

  echo "Done! Created: compressed/${base_name}.pdf"
}

compress-pdf "$@"