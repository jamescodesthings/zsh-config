#!/usr/bin/env zsh

function compress-pdf() {
  cheat-help compress-pdf "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  local DEPS=(gs)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  if [[ -z "$1" ]]; then
    say fail "provide a PDF file name"
    say info "usage: compress-pdf input.pdf"
    return 2
  fi
  if [[ "$1" == -* ]]; then
    say fail "unknown option: $1"
    return 2
  fi

  # Extract the base name without the extension
  local base_name="${${1:t}%.*}"

  # Create output directory
  mkdir -p compressed

  # Run the compression
  if ! gs -q -dNOPAUSE -dBATCH -dSAFER -sDEVICE=pdfwrite \
    -dCompatibilityLevel=1.5 -dPDFSETTINGS=/screen \
    -dEmbedAllFonts=true -dSubsetFonts=true \
    -sOutputFile="compressed/${base_name}.pdf" "$1"; then
    say fail "could not compress $1"
    return 1
  fi

  say ok "created compressed/${base_name}.pdf"
}

compress-pdf "$@"
