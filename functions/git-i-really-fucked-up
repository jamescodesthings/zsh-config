#!/usr/bin/env zsh

function git-i-really-fucked-up() {
  cheat-help git-i-really-fucked-up "$@" && return 0
  autoload -Uz cli-init say problem fix problems
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"
  local DEPS=(
    confirm
    git
  )

  if ! deps $DEPS; then
    return
  fi

  local BRANCH="origin/$(git-branch)"
  if confirm "are you sure you want to reset to $BRANCH?"; then
    git reset --hard $BRANCH || { say fail "could not reset to $BRANCH"; return 1 }
    say ok "reset to $BRANCH"
  fi
}

git-i-really-fucked-up "$@"
