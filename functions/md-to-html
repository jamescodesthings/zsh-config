#!/usr/bin/env zsh

# Prints an error block to stderr: what failed, how to fix it, and where this
# tool lives. md-to-pdf sets MD_CALLER so its own name appears instead.
function _md-to-html-fail() {
  local caller="${MD_CALLER:-md-to-html}"
  print -u2 -r -- "${c[error]}error:${c[reset]} $caller: $1"
  if is not empty "$2"; then
    print -u2 -r -- "${c[info]}try:${c[reset]} $2"
  fi
  print -u2 -r -- "${c[info]}source:${c[reset]} ${CUSTOM_DIR:-$HOME/.custom}/functions/$caller"
}

# The command that installs a tool on this machine.
function _md-to-html-install() {
  if is osx; then
    print -r -- "brew install $1"
  else
    print -r -- "sudo apt install $2"
  fi
}

# --embed-resources only exists from pandoc 2.19; older pandoc needs
# --self-contained. Falls back to --embed-resources when the version can't
# be parsed, since that is the modern default.
function _md-to-html-embed-flag() {
  local line major minor
  line="$(pandoc --version 2>/dev/null | head -n1)"
  if [[ "$line" =~ 'pandoc ([0-9]+)\.([0-9]+)' ]]; then
    major="$match[1]"
    minor="$match[2]"
    if (( major < 2 || (major == 2 && minor < 19) )); then
      print -r -- "--self-contained"
      return
    fi
  fi
  print -r -- "--embed-resources"
}

function md-to-html() {
  if is equal "$1" "-h" || is equal "$1" "--help"; then
    echo "${c[h1]}md-to-html${c[reset]}"
    echo ""
    echo "${c[lead]}converts a markdown file to a styled, self-contained html page next to it.${c[reset]}"
    echo ""
    echo "${c[h2]}usage${c[reset]}"
    echo "  md-to-html ${c[param]}file.md${c[reset]}                writes file.html beside it, overwriting"
    echo "  md-to-html ${c[param]}a.md b.md${c[reset]} / ${c[param]}*.md${c[reset]}     converts each, beside its input"
    echo "  md-to-html ${c[param]}file.md${c[reset]} ${c[flag]}-o${c[reset]} ${c[param]}out.html${c[reset]}    one file only; writes to out.html (must end in .html/.htm, and not be the input)"
    echo ""
    echo "  a file that fails is reported and the rest carry on; the exit status is 1 if any failed."
    echo ""
    echo "${c[h2]}needs${c[reset]}"
    echo "  pandoc, file"
    echo "  stylesheet: ${CUSTOM_DIR:-$HOME/.custom}/configs/md/md.css"
    return 0
  fi

  local caller="${MD_CALLER:-md-to-html}"
  local output="" files=()
  while (( $# )); do
    case "$1" in
      -o|--output)
        if (( $# < 2 )) || is empty "$2"; then
          _md-to-html-fail "-o needs an output path" "$caller file.md -o out.html"
          return 1
        fi
        output="$2"
        shift 2
        ;;
      --)
        shift
        files+=("$@")
        break
        ;;
      *)
        files+=("$1")
        shift
        ;;
    esac
  done

  if (( ${#files} == 0 )); then
    _md-to-html-fail "no input file given" "$caller path/to/file.md"
    return 1
  fi

  if is not empty "$output" && (( ${#files} > 1 )); then
    _md-to-html-fail "-o names one output, but ${#files} files were given" "drop -o to write each file beside its input"
    return 1
  fi

  local file result failed=()
  for file in "${files[@]}"; do
    # An empty argument usually means an unset variable; name it in the
    # summary rather than leaving a blank.
    if is empty "$file"; then
      _md-to-html-fail "an empty file name was given" "check the variable or quotes that produced it"
      failed+=("(empty name)")
      continue
    fi
    _md-to-html-one "$file" "$output"
    result=$?
    # An interrupt stops the whole batch.
    if (( result == 130 || result == 143 )); then
      return $result
    fi
    if (( result != 0 )); then
      failed+=("$file")
    fi
  done

  if (( ${#files} > 1 )); then
    if (( ${#failed} == 0 )); then
      echo "${c[success]}success:${c[reset]} $caller converted all ${#files} files"
    else
      print -u2 -r -- "${c[error]}error:${c[reset]} $caller: ${#failed} of ${#files} files failed: ${(j:, :)failed}"
    fi
  fi

  (( ${#failed} == 0 ))
}

# Converts one file. The output path is optional; without it the html is
# written beside the input.
function _md-to-html-one() {
  local input="$1"
  local caller="${MD_CALLER:-md-to-html}"

  # A name starting with a dash would be read as an option by pandoc and file.
  if [[ "$input" == -* ]]; then
    input="./$input"
  fi

  if is empty "$input"; then
    _md-to-html-fail "no input file given" "$caller path/to/file.md"
    return 1
  fi

  if [[ -d "$input" ]]; then
    _md-to-html-fail "$input is a folder, not a file" "pass the markdown file inside it"
    return 1
  fi

  if is not file "$input"; then
    _md-to-html-fail "$input does not exist" "check the path; ls -la ${(q)${input:h}}"
    return 1
  fi

  if is not readable "$input"; then
    _md-to-html-fail "$input is not readable" "chmod u+r ${(q)input}"
    return 1
  fi

  if is not empty "$2"; then
    if [[ "${2:a}" == "${input:a}" ]]; then
      _md-to-html-fail "the output would overwrite the input" "$caller file.md -o out.html"
      return 1
    fi
    if [[ "$2" != *.html && "$2" != *.htm ]]; then
      _md-to-html-fail "the output $2 does not end in .html or .htm" "$caller file.md -o out.html"
      return 1
    fi
  fi

  if [[ ! -s "$input" ]]; then
    _md-to-html-fail "$input is empty" "add some markdown to it first"
    return 1
  fi

  if is not available file; then
    _md-to-html-fail "the file command is not installed, so the input type cannot be checked" "$(_md-to-html-install file file)"
    return 1
  fi

  local mime
  mime="$(command file --mime-type -b -- "$input")"
  if [[ "$mime" != text/* ]]; then
    _md-to-html-fail "$input is $mime, not markdown or plain text" "pass a .md or .txt file; check it with: file ${(q)input}"
    return 1
  fi

  if is not available pandoc; then
    _md-to-html-fail "pandoc is not installed" "$(_md-to-html-install pandoc pandoc)"
    return 1
  fi

  local repo="${CUSTOM_DIR:-$HOME/.custom}"
  local stylesheet="$repo/configs/md/md.css"
  if is not file "$stylesheet"; then
    _md-to-html-fail "the stylesheet is missing: $stylesheet" "restore it with: git -C ${(q)repo} checkout -- configs/md/md.css"
    return 1
  fi

  local name="${${input:t}:r}"
  if is empty "$name"; then
    name="${input:t}"
  fi
  local output="${2:-${input:h}/$name.html}"
  # The helper always prints a flag, so an empty result means the version
  # check was interrupted.
  local embed_flag
  embed_flag="$(_md-to-html-embed-flag)"
  if is empty "$embed_flag"; then
    return 130
  fi

  # pandoc writes the file itself, so anything it prints is a message.
  local messages
  messages="$(pandoc "$input" \
    --from=gfm+task_lists+pipe_tables+strikeout \
    --to=html5 \
    --standalone \
    "$embed_flag" \
    --resource-path="${input:h}:." \
    --metadata title="$name" \
    --css="$stylesheet" \
    --output="$output" 2>&1)"
  local pandoc_status=$?
  # Interrupted (INT or TERM): stay quiet, the caller reports it.
  if (( pandoc_status == 130 || pandoc_status == 143 )); then
    return $pandoc_status
  fi
  if (( pandoc_status > 128 )); then
    _md-to-html-fail "pandoc crashed (exit status $pandoc_status) while converting $input" "run it by hand to see the crash: pandoc ${(q)input} -o /tmp/test.html; update it with: $(_md-to-html-install pandoc pandoc)"
    print -u2 -r -- "$messages"
    return 1
  fi
  if (( pandoc_status != 0 )); then
    _md-to-html-fail "pandoc could not convert $input" "read pandoc's message below; check that the folder is writable: ls -ld ${(q)${output:h}}"
    print -u2 -r -- "$messages"
    return 1
  fi

  if is not empty "$messages"; then
    print -u2 -r -- "${c[warn]}warning:${c[reset]} $caller: pandoc reported problems with $input"
    print -u2 -r -- "$messages"
  fi

  if is empty "$MD_CALLER"; then
    echo "${c[success]}success:${c[reset]} wrote $output"
  fi
}

md-to-html "$@"
