#!/usr/bin/env zsh

# Records a failure for the problems block: what failed, then the command that
# fixes or explains it. md-to-pdf sets MD_CALLER so its own name appears
# instead, and prints the block itself.
function _md-to-html-fail() {
  local caller="${MD_CALLER:-md-to-html}"
  problem "$caller: $1"
  if is not empty "$2"; then
    fix "$2" "$3"
  fi
}

# The command that installs a tool on this machine.
function _md-to-html-install() {
  if is osx; then
    print -r -- "brew install $1"
  else
    print -r -- "sudo apt install $2"
  fi
}

# --embed-resources only exists from pandoc 2.19; older pandoc needs
# --self-contained. Falls back to --embed-resources when the version can't
# be parsed, since that is the modern default.
function _md-to-html-embed-flag() {
  local line major minor
  line="$(pandoc --version 2>/dev/null | head -n1)"
  if [[ "$line" =~ 'pandoc ([0-9]+)\.([0-9]+)' ]]; then
    major="$match[1]"
    minor="$match[2]"
    if (( major < 2 || (major == 2 && minor < 19) )); then
      print -r -- "--self-contained"
      return
    fi
  fi
  print -r -- "--embed-resources"
}

function md-to-html() {
  cheat-help md-to-html "$@" && return 0
  autoload -Uz cli-init say problem fix problems
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  local caller="${MD_CALLER:-md-to-html}"
  local output="" files=()
  while (( $# )); do
    case "$1" in
      -o|--output)
        if (( $# < 2 )) || is empty "$2"; then
          _md-to-html-fail "-o needs an output path" "$caller file.md -o out.html" "name the output"
          is empty "$MD_CALLER" && problems
          return 2
        fi
        output="$2"
        shift 2
        ;;
      --)
        shift
        files+=("$@")
        break
        ;;
      *)
        files+=("$1")
        shift
        ;;
    esac
  done

  if (( ${#files} == 0 )); then
    _md-to-html-fail "no input file given" "$caller path/to/file.md" "convert a file"
    is empty "$MD_CALLER" && problems
    return 2
  fi

  if is not empty "$output" && (( ${#files} > 1 )); then
    _md-to-html-fail "-o names one output, but ${#files} files were given; drop -o to write each file beside its input"
    is empty "$MD_CALLER" && problems
    return 2
  fi

  # A start line so a long run is visibly working. md-to-pdf prints its own.
  if is empty "$MD_CALLER"; then
    if (( ${#files} == 1 )); then
      say info "converting ${files[1]}"
    else
      say info "converting ${#files} files"
    fi
  fi

  local file result failed=() count=0
  for file in "${files[@]}"; do
    (( count += 1 ))
    if (( ${#files} > 1 )); then
      say info "[$count/${#files}] $file"
    fi
    # An empty argument usually means an unset variable; name it in the
    # summary rather than leaving a blank.
    if is empty "$file"; then
      _md-to-html-fail "an empty file name was given; check the variable or quotes that produced it"
      failed+=("(empty name)")
      continue
    fi
    _md-to-html-one "$file" "$output"
    result=$?
    # An interrupt stops the whole batch.
    if (( result == 130 || result == 143 )); then
      return $result
    fi
    if (( result != 0 )); then
      failed+=("$file")
    fi
  done

  if (( ${#files} > 1 && ${#failed} == 0 )); then
    say ok "$caller converted all ${#files} files"
  fi

  local -i rc=0
  (( ${#failed} )) && rc=1
  # md-to-pdf prints the block for its own run.
  if is empty "$MD_CALLER"; then
    problems || rc=1
  fi
  return $rc
}

# Converts one file. The output path is optional; without it the html is
# written beside the input.
function _md-to-html-one() {
  local input="$1"
  local caller="${MD_CALLER:-md-to-html}"

  # A name starting with a dash would be read as an option by pandoc and file.
  if [[ "$input" == -* ]]; then
    input="./$input"
  fi

  if is empty "$input"; then
    _md-to-html-fail "no input file given" "$caller path/to/file.md" "convert a file"
    return 1
  fi

  if [[ -d "$input" ]]; then
    _md-to-html-fail "$input is a folder, not a file; pass the markdown file inside it"
    return 1
  fi

  if is not file "$input"; then
    _md-to-html-fail "$input does not exist" "ls -la ${(q)${input:h}}" "check the path"
    return 1
  fi

  if is not readable "$input"; then
    _md-to-html-fail "$input is not readable" "chmod u+r ${(q)input}" "make it readable"
    return 1
  fi

  if is not empty "$2"; then
    if [[ "${2:a}" == "${input:a}" ]]; then
      _md-to-html-fail "the output would overwrite the input" "$caller file.md -o out.html" "name a different output"
      return 1
    fi
    if [[ "$2" != *.html && "$2" != *.htm ]]; then
      _md-to-html-fail "the output $2 does not end in .html or .htm" "$caller file.md -o out.html" "name an .html output"
      return 1
    fi
  fi

  if [[ ! -s "$input" ]]; then
    _md-to-html-fail "$input is empty; add some markdown to it first"
    return 1
  fi

  if is not available file; then
    _md-to-html-fail "the file command is not installed, so the input type cannot be checked" "$(_md-to-html-install file file)" "install it"
    return 1
  fi

  local mime
  mime="$(command file --mime-type -b -- "$input")"
  if [[ "$mime" != text/* ]]; then
    _md-to-html-fail "$input is $mime, not markdown or plain text" "file ${(q)input}" "pass a .md or .txt file"
    return 1
  fi

  if is not available pandoc; then
    _md-to-html-fail "pandoc is not installed" "$(_md-to-html-install pandoc pandoc)" "install it"
    return 1
  fi

  local repo="${CUSTOM_DIR:-$HOME/.custom}"
  local stylesheet="$repo/configs/md/md.css"
  if is not file "$stylesheet"; then
    _md-to-html-fail "the stylesheet is missing: $stylesheet" "git -C ${(q)repo} checkout -- configs/md/md.css" "restore it"
    return 1
  fi

  local name="${${input:t}:r}"
  if is empty "$name"; then
    name="${input:t}"
  fi
  local output="${2:-${input:h}/$name.html}"
  # The helper always prints a flag, so an empty result means the version
  # check was interrupted.
  local embed_flag
  embed_flag="$(_md-to-html-embed-flag)"
  if is empty "$embed_flag"; then
    return 130
  fi

  # pandoc writes the file itself, so anything it prints is a message.
  local messages
  messages="$(pandoc "$input" \
    --from=gfm+task_lists+pipe_tables+strikeout \
    --to=html5 \
    --standalone \
    "$embed_flag" \
    --resource-path="${input:h}:." \
    --metadata title="$name" \
    --css="$stylesheet" \
    --output="$output" 2>&1)"
  local pandoc_status=$?
  # Interrupted (INT or TERM): stay quiet, the caller reports it.
  if (( pandoc_status == 130 || pandoc_status == 143 )); then
    return $pandoc_status
  fi
  if (( pandoc_status > 128 )); then
    _md-to-html-fail "pandoc crashed (exit status $pandoc_status) while converting $input" "pandoc ${(q)input} -o /tmp/test.html" "run it by hand to see the crash"
    print -u2 -r -- "$messages"
    return 1
  fi
  if (( pandoc_status != 0 )); then
    _md-to-html-fail "pandoc could not convert $input" "ls -ld ${(q)${output:h}}" "check that the folder is writable"
    print -u2 -r -- "$messages"
    return 1
  fi

  if is not empty "$messages"; then
    say warn "$caller: pandoc reported problems with $input"
    print -u2 -r -- "$messages"
  fi

  if is empty "$MD_CALLER"; then
    say ok "wrote $output"
  fi
}

md-to-html "$@"
