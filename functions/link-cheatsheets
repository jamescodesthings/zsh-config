#!/usr/bin/env zsh

function link-cheatsheets() {
  if is empty "$c"; then
    source "${CUSTOM_DIR:-$HOME/.custom}/zpm-zsh-colors"
  fi

  if is not equal "$#" "1" || [[ "$1" == "--help" ]] || is not dir "$1"; then
    echo "$c[h1]link-cheatsheets$c[reset]"
    echo ""
    echo "$c[lead]links every *.md in a folder into \$CHEATSHEET_DIR, so cheat can find the sheets.$c[reset]"
    echo ""
    echo "$c[h2]usage$c[reset]"
    echo "  link-cheatsheets $c[param]<dir>$c[reset]"
    echo ""
    echo "$c[h2]examples$c[reset]"
    echo "  link-cheatsheets $c[param]~/projects/personal/pkms/cheatsheets$c[reset]"
    return 1
  fi

  local dir="${1:A}"

  if is empty "$CHEATSHEET_DIR"; then
    echo "$c[info]skipping:$c[reset] CHEATSHEET_DIR is not set"
    return 0
  fi

  if [[ "${CHEATSHEET_DIR:A}" == "$dir" || "${CHEATSHEET_DIR:A}" == "$dir"/* || "${CHEATSHEET_DIR:A}" == "${CUSTOM_DIR:A}/cheatsheets" ]]; then
    echo "$c[error]error:$c[reset] CHEATSHEET_DIR ($CHEATSHEET_DIR) points inside $dir; open a new shell so it picks up ~/cheatsheets"
    return 1
  fi

  if ! mkdir -p "$CHEATSHEET_DIR"; then
    echo "$c[error]error:$c[reset] cannot create $CHEATSHEET_DIR"
    return 1
  fi

  local l target src dest name
  local -i linked=0 already=0 clashes=0

  # Sweep: remove dangling links that point into this folder
  for l in "$CHEATSHEET_DIR"/*(N@); do
    target="$(readlink "$l")"
    if [[ "$target" == "$dir"/* && ! -e "$l" ]]; then
      rm "$l"
    fi
  done

  for src in "$dir"/*.md(N); do
    name="${src:t}"
    dest="$CHEATSHEET_DIR/$name"
    if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
      already+=1
    elif [[ ! -e "$dest" ]]; then
      # no dest, or a dangling link
      echo "$c[info]linking:$c[reset] $src → $dest"
      if ln -sfn "$src" "$dest"; then
        linked+=1
      else
        echo "$c[warn]warning:$c[reset] could not link $name"
        clashes+=1
      fi
    else
      if [[ -L "$dest" ]]; then
        target="$(readlink "$dest")"
      else
        target="a real file"
      fi
      echo "$c[warn]warning:$c[reset] $name taken by $target"
      clashes+=1
    fi
  done

  echo "linked $linked, already linked $already, clashes $clashes"
  (( clashes == 0 ))
}

link-cheatsheets "$@"
