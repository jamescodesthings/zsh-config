#!/usr/bin/env zsh

function link-cheatsheets() {
  setopt localoptions bareglobqual
  cheat-help link-cheatsheets "$@" && return 0
  autoload -Uz cli-init say problem fix problems
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  if is not equal "$#" "1"; then
    problem "link-cheatsheets needs one folder"
    fix "cheat link-cheatsheets" "how to use it"
    problems
    return 2
  elif is not dir "$1"; then
    problem "not a folder: $1"
    fix "cheat link-cheatsheets" "how to use it"
    problems
    return 2
  fi

  local dir="${1:A}"

  if is empty "$CHEATSHEET_DIR"; then
    say info "skipping: CHEATSHEET_DIR is not set"
    return 0
  fi

  if [[ "${CHEATSHEET_DIR:A}" == "$dir" || "${CHEATSHEET_DIR:A}" == "$dir"/* || "${CHEATSHEET_DIR:A}" == "${CUSTOM_DIR:A}/cheatsheets" ]]; then
    problem "CHEATSHEET_DIR ($CHEATSHEET_DIR) points inside $dir"
    fix "exec zsh" "open a new shell so it picks up ~/cheatsheets"
    problems
    return 1
  fi

  if ! command mkdir -p "$CHEATSHEET_DIR"; then
    say fail "cannot create $CHEATSHEET_DIR"
    return 1
  fi

  local l target src dest name
  local -i linked=0 already=0 clashes=0

  # Sweep: remove dangling links that point into this folder
  for l in "$CHEATSHEET_DIR"/*(N@); do
    target="$(readlink "$l")"
    if [[ "$target" == "$dir"/* && ! -e "$l" ]]; then
      command rm "$l"
    fi
  done

  for src in "$dir"/*.md(N); do
    name="${src:t}"
    dest="$CHEATSHEET_DIR/$name"
    if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
      already+=1
    elif [[ ! -e "$dest" ]]; then
      # no dest, or a dangling link
      say info "linking $src → $dest"
      if command ln -sfn "$src" "$dest"; then
        linked+=1
      else
        say warn "warning: could not link $name"
        clashes+=1
      fi
    else
      if [[ -L "$dest" ]]; then
        target="$(readlink "$dest")"
      else
        target="a real file"
      fi
      say warn "warning: $name taken by $target"
      clashes+=1
    fi
  done

  if (( clashes )); then
    say warn "linked $linked, already linked $already, clashes $clashes"
    return 1
  fi
  say ok "linked $linked, already linked $already, clashes $clashes"
}

link-cheatsheets "$@"
