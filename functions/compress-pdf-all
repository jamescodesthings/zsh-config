#!/usr/bin/env zsh

compress-pdf-all() {
  setopt localoptions bareglobqual
  cheat-help compress-pdf-all "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  if [[ -n "$1" ]]; then
    say fail "unknown argument: $1"
    return 2
  fi

  # Find all PDFs using the (N) flag to prevent errors if empty
  local pdfs=( *.pdf(N) )

  # Filter out files that are already compressed
  local target_pdfs=() f file
  for f in "${pdfs[@]}"; do
    if [[ ! -f "compressed/$f" ]]; then
      target_pdfs+=("$f")
    fi
  done

  if (( ${#target_pdfs} == 0 )); then
    say info "no uncompressed PDFs found in this folder"
    return 0
  fi

  # Hand off each file to compress-pdf; a failure is recorded and the loop
  # carries on.
  for file in "${target_pdfs[@]}"; do
    if ! compress-pdf "$file"; then
      problem "could not compress $file"
      fix "compress-pdf $file" "run it alone to see the error"
    fi
  done

  problems && say ok "all PDFs processed"
}

compress-pdf-all "$@"
