#!/usr/bin/env zsh

compress-pdf-all() {
  setopt localoptions bareglobqual
  cheat-help compress-pdf-all "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  local recursive=0 root="."
  while (( $# )); do
    case "$1" in
      -r|--recursive)
        recursive=1
        if (( $# > 1 )) && [[ "$2" != -* ]]; then
          root="$2"
          shift
        fi
        ;;
      *)
        say fail "unknown argument: $1"
        return 2
        ;;
    esac
    shift
  done
  if is not dir "$root"; then
    say fail "not a folder: $root"
    return 2
  fi

  # The folders to look in: this one, or with -r every folder below the
  # root too, skipping hidden folders, node_modules and compressed/ itself
  local -a folders=("${root%/}")
  local d
  if (( recursive )); then
    setopt localoptions noglobdots
    for d in "${root%/}"/**/*(N/); do
      [[ "/$d/" == */node_modules/* || "/$d/" == */compressed/* ]] && continue
      folders+=("$d")
    done
  fi

  # Every pdf in those folders with no copy in its folder's compressed/
  local target_pdfs=() f file
  for d in $folders; do
    for f in "$d"/*.pdf(N.); do
      [[ -f "$d/compressed/${f:t}" ]] || target_pdfs+=("$f")
    done
  done

  if (( ${#target_pdfs} == 0 )); then
    if (( recursive )); then
      say info "no uncompressed PDFs found under $root"
    else
      say info "no uncompressed PDFs found in this folder"
    fi
    return 0
  fi

  # compress-pdf writes compressed/ in the folder it runs in, so each file is
  # compressed from its own folder, in a subshell. A failure is recorded and
  # the loop carries on.
  for file in "${target_pdfs[@]}"; do
    if ! ( cd -- "${file:h}" && compress-pdf "${file:t}" ); then
      problem "could not compress $file"
      fix "cd ${(q)file:h} && compress-pdf ${(q)file:t}" "run it alone to see the error"
    fi
  done

  problems && say ok "all PDFs processed"
}

compress-pdf-all "$@"
