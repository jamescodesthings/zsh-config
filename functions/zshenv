#!/usr/bin/env zsh

function zshenv() {
  cheat-help zshenv "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  if is available micro; then
    micro "$CUSTOM_DIR/env.$(get-hostname).zsh"
    return 0
  fi
  say fail "no editor found: run $CUSTOM_DIR/install-micro to install micro"
  return 1
}

zshenv "$@"
