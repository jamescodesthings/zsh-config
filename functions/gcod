#!/usr/bin/env zsh

function gcod() {
  cheat-help gcod "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"

  local DEPS=(git)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  local DEV_BRANCH=$(git config gitflow.branch.develop)
  if is empty "$DEV_BRANCH"; then
    say fail "no gitflow develop branch configured"
    say info "set it with: git config gitflow.branch.develop develop"
    return 1
  fi

  if ! git checkout "$DEV_BRANCH"; then
    say fail "could not checkout $DEV_BRANCH"
    return 1
  fi
}

gcod "$@"
