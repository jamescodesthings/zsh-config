#!/usr/bin/env zsh

function aptr() {
  cheat-help aptr "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  local DEPS=(apt)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  if is empty "$1"; then
    say fail "package name required"
    say info "usage: aptr <package-name>"
    return 2
  fi
  if [[ "$1" == -* ]]; then
    say fail "unknown option: $1"
    return 2
  fi

  sudo apt remove -y "$1" && sudo apt autoremove -y
}

aptr "$@"
