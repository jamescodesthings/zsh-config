#!/usr/bin/env zsh

function _cheat_expand_vars() {
  local file="$1"
  awk '
    function expand_vars(s,    result, rest, tok, name, val) {
      result = ""
      rest = s
      while (match(rest, /\$\{?[A-Za-z_][A-Za-z0-9_]*\}?/)) {
        result = result substr(rest, 1, RSTART-1)
        tok  = substr(rest, RSTART, RLENGTH)
        rest = substr(rest, RSTART+RLENGTH)
        name = tok; gsub(/[${}]/, "", name)
        val  = ENVIRON[name]
        result = result (val != "" ? val : tok)
      }
      return result rest
    }
    /^```/ { fence = !fence; print; next }
    fence  { print; next }
    {
      line = $0; out = ""
      n = split(line, parts, "`")
      for (i = 1; i <= n; i++) {
        if (i % 2 == 1 || (i == n && n % 2 == 0)) {
          out = out expand_vars(parts[i])
        } else {
          out = out "`" parts[i] "`"
        }
      }
      print out
    }
  ' "$file"
}

function cheat() {
  setopt localoptions bareglobqual
  autoload -Uz is cheat-render link-cheatsheets
  autoload -Uz cli-init say problem fix problems col
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"
  local _H _F _T _N _W _O _P _D _R
  col -v _H heading; col -v _F flag; col -v _T target; col -v _N num
  col -v _W warn; col -v _O ok; col -v _P prose; col -v _D dim
  [[ -n "$_H" ]] && _R=$'\e[0m'
  if is empty "$CHEATSHEET_DIR"; then
    say fail "CHEATSHEET_DIR not set, run zsh-config/install to install it"
    return 1
  fi

  # Local sheets render through cheat-render in the shared palette; plain
  # when stdout is not a terminal. Local, so the caller's shell is untouched.
  local CLI_PLAIN="$CLI_PLAIN"
  # CLICOLOR_FORCE (set, not 0) keeps colour for a parent capturing the output
  if [[ -n "$NO_COLOR" ]]; then
    CLI_PLAIN=1
  elif [[ ! -t 1 ]] && [[ -z "$CLICOLOR_FORCE" || "$CLICOLOR_FORCE" == 0 ]]; then
    CLI_PLAIN=1
  fi

  # Auto-update tldr cache (silent, background, every 7 days)
  if is available tldr; then
    local _stamp="$CHEATSHEET_DIR/.tldr-last-update"
    local _now; _now=$(date +%s)
    local _last=0
    is file "$_stamp" && _last=$(cat "$_stamp" 2>/dev/null || echo 0)
    if (( _now - _last > 604800 )); then
      tldr --update &>/dev/null &!
      echo "$_now" >| "$_stamp"
    fi
  fi

  # No args → list
  if [[ $# -eq 0 ]]; then
    print -r -- "${_H}Local Cheatsheets:${_R}"
    for f in "$CHEATSHEET_DIR"/*.md(N-.); do
      echo "  $(basename "$f" .md)"
    done | sort
    return 0
  fi

  local subcmd="$1"
  shift

  case "$subcmd" in

    -h|--help|help)
      # The word help shows the index of our own sheets when there is one;
      # -h and --help always show cheat's own sheet
      if [[ "$subcmd" == help ]] && is file "$CHEATSHEET_DIR/help.md"; then
        cheat-render "$CHEATSHEET_DIR/help.md"
        return $?
      fi
      if is file "$CHEATSHEET_DIR/cheat.md"; then
        cheat cheat
        return $?
      fi
      print -r -- "${_H}cheat${_R}"
      echo ""
      echo "${_P}Personal cheatsheet viewer with tldr fallback. Cheatsheets are links in \$CHEATSHEET_DIR.${_R}"
      echo ""
      print -r -- "${_H}Usage:${_R}"
      echo "  cheat                          list all local cheatsheets"
      echo "  cheat ${_T}<name>${_R}                   show a cheatsheet"
      echo "  cheat ${_T}<word> <word>${_R}             multi-word: 'cheat git commit' → git-commit.md"
      echo "  cheat ${_T}<name>${_R} ${_F}--raw${_R}              print raw markdown"
      echo ""
      print -r -- "${_H}Subcommands:${_R}"
      echo "  ${_F}list${_R}                           list local cheatsheets"
      echo "  ${_F}search${_R} ${_T}<query>${_R}                search local + tldr by name"
      echo "  ${_F}edit${_R} ${_T}<name>${_R}                  open in \$EDITOR"
      echo "  ${_F}new${_R} ${_T}<name>${_R}                   create from template"
      echo "  ${_F}refresh${_R}                        refresh the tldr cache"
      echo "  ${_F}raw${_R} ${_T}<name>${_R}                   print raw markdown"
      echo "  ${_F}help${_R}, ${_F}-h${_R}, ${_F}--help${_R}             show this help"
      ;;

    list)
      print -r -- "${_H}Local Cheatsheets:${_R}"
      for f in "$CHEATSHEET_DIR"/*.md(N-.); do
        echo "  $(basename "$f" .md)"
      done | sort
      ;;

    search)
      local query="$1"
      if is empty "$query"; then
        say fail "search requires a query"
        return 1
      fi
      local -a local_results=() tldr_only=()
      for f in "$CHEATSHEET_DIR"/*.md(N-.); do
        local name; name=$(basename "$f" .md)
        [[ "$name" == *"$query"* ]] && local_results+=("$name")
      done
      if is available tldr; then
        while IFS= read -r page; do
          is empty "$page" && continue
          (( ${local_results[(Ie)$page]} )) || tldr_only+=("$page")
        done < <(tldr --list-all 2>/dev/null | grep -i "$query" | sort)
      fi
      if (( ${#local_results[@]} + ${#tldr_only[@]} > 0 )); then
        for r in "${local_results[@]}"; do
          printf "  %-30s %s\n" "$r" "${_O}[cheatsheet]${_R}"
        done
        for r in "${tldr_only[@]}"; do
          printf "  %-30s %s\n" "$r" "${_N}[tldr]${_R}"
        done
      else
        say warn "nothing found for \"$query\""
      fi
      ;;

    edit)
      if is empty "$1"; then
        say fail "edit requires a sheet name"
        return 1
      fi
      local sheet_name="${(j:-:)@}"
      sheet_name="${sheet_name%.md}"
      local edit_file="$CHEATSHEET_DIR/$sheet_name.md"
      if ! is file "$edit_file"; then
        say fail "'$sheet_name' not found - use cheat new $sheet_name to create it"
        return 1
      fi
      ${EDITOR:-micro} "$edit_file"
      ;;

    new)
      if is empty "$1"; then
        say fail "new requires a name"
        return 1
      fi
      local new_name="${1%.md}"
      local new_file="$CUSTOM_DIR/cheatsheets/$new_name.md"
      if is existing "$new_file" || is existing "$CHEATSHEET_DIR/$new_name.md" || [[ -L "$CHEATSHEET_DIR/$new_name.md" ]]; then
        say fail "'$new_name' already exists - use cheat edit $new_name to edit it"
        return 1
      fi
      cat >| "$new_file" <<TEMPLATE
# $new_name

> What it is for, in one line.

# Getting started

- The first thing to run:

\`$new_name\`

- Next: what to do once that works

# Everyday

- \`$new_name <command> [target] [--flag]\`: what it does

# See also

- \`cheat $new_name <command>\`: every option of a command
- \`cheat zsh-config\`: everything zsh-config gives you
TEMPLATE
      say ok "created $new_file"
      if ! link-cheatsheets "$CUSTOM_DIR/cheatsheets"; then
        say warn "$new_name was created but not linked into $CHEATSHEET_DIR"
      fi
      echo "run ${_F}cheat edit $new_name${_R} to fill it in, then ${_F}cheatsheet-test $new_file${_R}"
      ;;

    refresh)
      if ! is available tldr; then
        say warn "tldr not available"
        return 1
      fi
      tldr --update
      date +%s >| "$CHEATSHEET_DIR/.tldr-last-update"
      ;;

    raw)
      if is empty "$1"; then
        say fail "raw requires a sheet name"
        return 1
      fi
      cheat "$@" --raw
      return $?
      ;;

    *)
      # Any other words name a sheet, joined with -. Flags are dropped, so
      # `<tool> <words> --help` can hand everything to `cheat <tool> <words>`.
      # A missing sheet falls back to its nearest parent: `cheat hub join all`
      # shows hub-join.md when there is no hub-join-all.md.
      local -a words=()
      local raw_mode=0 part
      for part in "$subcmd" "$@"; do
        case "$part" in
          --raw|-r) raw_mode=1 ;;
          -*) ;;
          *) words+=("${part%.md}") ;;
        esac
      done
      if (( ! $#words )); then
        cheat list
        return $?
      fi

      local -i n
      local sheet=""
      for (( n = $#words; n > 0; n-- )); do
        if is file "$CHEATSHEET_DIR/${(j:-:)words[1,n]}.md"; then
          sheet="$CHEATSHEET_DIR/${(j:-:)words[1,n]}.md"
          break
        fi
      done

      # A local parent loses to tldr's page for the exact words, so
      # `cheat git commit` still finds tldr's git-commit beside a local git.md
      if is not empty "$sheet" && (( n < $#words )) && is available tldr; then
        local -a exact_args=()
        (( raw_mode )) && exact_args=(--raw)
        if tldr "${exact_args[@]}" "${words[@]}" 2> /dev/null; then
          return 0
        fi
      fi

      if is not empty "$sheet"; then
        if (( n < $#words )); then
          print -r -u2 -- "${_D}no sheet for \"${words[*]}\", showing \"${words[1,n]}\"${_R}"
        fi
        if (( raw_mode )); then
          cat "$sheet"
        else
          local _cheat_tmp; _cheat_tmp=$(mktemp)
          _cheat_expand_vars "$sheet" > "$_cheat_tmp"
          cheat-render "$_cheat_tmp"
          rm -f "$_cheat_tmp"
        fi
        return 0
      fi

      # No local sheet: tldr's own pages, with the same parent fallback
      if is available tldr; then
        local -a tldr_args=()
        (( raw_mode )) && tldr_args=(--raw)
        for (( n = $#words; n > 0; n-- )); do
          if tldr "${tldr_args[@]}" "${words[1,n]}" 2> /dev/null; then
            return 0
          fi
        done
      fi
      say fail "no sheet for \"${words[*]}\""
      return 1
      ;;
  esac
}

cheat "$@"
