#!/usr/bin/env zsh

function _cheat_expand_vars() {
  local file="$1"
  awk '
    function expand_vars(s,    result, rest, tok, name, val) {
      result = ""
      rest = s
      while (match(rest, /\$\{?[A-Za-z_][A-Za-z0-9_]*\}?/)) {
        result = result substr(rest, 1, RSTART-1)
        tok  = substr(rest, RSTART, RLENGTH)
        rest = substr(rest, RSTART+RLENGTH)
        name = tok; gsub(/[${}]/, "", name)
        val  = ENVIRON[name]
        result = result (val != "" ? val : tok)
      }
      return result rest
    }
    /^```/ { fence = !fence; print; next }
    fence  { print; next }
    {
      line = $0; out = ""
      n = split(line, parts, "`")
      for (i = 1; i <= n; i++) {
        if (i % 2 == 1 || (i == n && n % 2 == 0)) {
          out = out expand_vars(parts[i])
        } else {
          out = out "`" parts[i] "`"
        }
      }
      print out
    }
  ' "$file"
}

function cheat() {
  if is empty "$CHEATSHEET_DIR"; then
    echo "${c[error]}error:${c[reset]} CHEATSHEET_DIR not set, run zsh-config/install to install it"
    return 1
  fi

  # Renderer: tldr → glow → bat → cat
  local render_cmd render_args=()
  if is available tldr; then
    render_cmd="tldr"; render_args=("--render")
    # cheat's own tlrc settings (compact, heading styles); tldr's pages and
    # the user's tlrc config are left alone
    if is file "${CUSTOM_DIR:-$HOME/.custom}/configs/tlrc/cheat.toml"; then
      render_args=("--config" "${CUSTOM_DIR:-$HOME/.custom}/configs/tlrc/cheat.toml" "--render")
    fi
  elif is available glow; then
    render_cmd="glow"; render_args=("-w" "120")
  elif is available bat; then
    render_cmd="bat"; render_args=("-p" "--color=always")
  else
    render_cmd="cat"
  fi

  # Auto-update tldr cache (silent, background, every 7 days)
  if is available tldr; then
    local _stamp="$CHEATSHEET_DIR/.tldr-last-update"
    local _now; _now=$(date +%s)
    local _last=0
    is file "$_stamp" && _last=$(cat "$_stamp" 2>/dev/null || echo 0)
    if (( _now - _last > 604800 )); then
      tldr --update &>/dev/null &!
      echo "$_now" >| "$_stamp"
    fi
  fi

  # No args → list
  if [[ $# -eq 0 ]]; then
    echo "${c[h1]}Local Cheatsheets:${c[reset]}"
    for f in "$CHEATSHEET_DIR"/*.md(N-.); do
      echo "  $(basename "$f" .md)"
    done | sort
    return 0
  fi

  local subcmd="$1"
  shift

  case "$subcmd" in

    -h|--help|help)
      if is file "$CHEATSHEET_DIR/cheat.md"; then
        cheat cheat
        return $?
      fi
      echo "${c[h1]}cheat${c[reset]}"
      echo ""
      echo "${c[lead]}Personal cheatsheet viewer with tldr fallback. Cheatsheets are links in \$CHEATSHEET_DIR.${c[reset]}"
      echo ""
      echo "${c[h2]}Usage:${c[reset]}"
      echo "  cheat                          list all local cheatsheets"
      echo "  cheat ${c[param]}<name>${c[reset]}                   show a cheatsheet"
      echo "  cheat ${c[param]}<word> <word>${c[reset]}             multi-word: 'cheat git commit' → git-commit.md"
      echo "  cheat ${c[param]}<name>${c[reset]} ${c[flag]}--raw${c[reset]}              print raw markdown"
      echo ""
      echo "${c[h2]}Subcommands:${c[reset]}"
      echo "  ${c[flag]}list${c[reset]}                           list local cheatsheets"
      echo "  ${c[flag]}search${c[reset]} ${c[param]}<query>${c[reset]}                search local + tldr by name"
      echo "  ${c[flag]}edit${c[reset]} ${c[param]}<name>${c[reset]}                  open in \$EDITOR"
      echo "  ${c[flag]}new${c[reset]} ${c[param]}<name>${c[reset]}                   create from template"
      echo "  ${c[flag]}refresh${c[reset]}                        refresh the tldr cache"
      echo "  ${c[flag]}raw${c[reset]} ${c[param]}<name>${c[reset]}                   print raw markdown"
      echo "  ${c[flag]}help${c[reset]}, ${c[flag]}-h${c[reset]}, ${c[flag]}--help${c[reset]}             show this help"
      ;;

    list)
      echo "${c[h1]}Local Cheatsheets:${c[reset]}"
      for f in "$CHEATSHEET_DIR"/*.md(N-.); do
        echo "  $(basename "$f" .md)"
      done | sort
      ;;

    search)
      local query="$1"
      if is empty "$query"; then
        echo "${c[error]}error:${c[reset]} search requires a query"
        return 1
      fi
      local -a local_results=() tldr_only=()
      for f in "$CHEATSHEET_DIR"/*.md(N-.); do
        local name; name=$(basename "$f" .md)
        [[ "$name" == *"$query"* ]] && local_results+=("$name")
      done
      if is available tldr; then
        while IFS= read -r page; do
          is empty "$page" && continue
          (( ${local_results[(Ie)$page]} )) || tldr_only+=("$page")
        done < <(tldr --list-all 2>/dev/null | grep -i "$query" | sort)
      fi
      if (( ${#local_results[@]} + ${#tldr_only[@]} > 0 )); then
        for r in "${local_results[@]}"; do
          printf "  %-30s %s\n" "$r" "${c[success]}[cheatsheet]${c[reset]}"
        done
        for r in "${tldr_only[@]}"; do
          printf "  %-30s %s\n" "$r" "${c[info]}[tldr]${c[reset]}"
        done
      else
        echo "${c[warn]}nothing found for \"$query\"${c[reset]}"
      fi
      ;;

    edit)
      if is empty "$1"; then
        echo "${c[error]}error:${c[reset]} edit requires a sheet name"
        return 1
      fi
      local sheet_name="${(j:-:)@}"
      sheet_name="${sheet_name%.md}"
      local edit_file="$CHEATSHEET_DIR/$sheet_name.md"
      if ! is file "$edit_file"; then
        echo "${c[error]}error:${c[reset]} '$sheet_name' not found — use ${c[flag]}cheat new $sheet_name${c[reset]} to create it"
        return 1
      fi
      ${EDITOR:-micro} "$edit_file"
      ;;

    new)
      if is empty "$1"; then
        echo "${c[error]}error:${c[reset]} new requires a name"
        return 1
      fi
      local new_name="${1%.md}"
      local new_file="$CUSTOM_DIR/cheatsheets/$new_name.md"
      if is existing "$new_file" || is existing "$CHEATSHEET_DIR/$new_name.md" || [[ -L "$CHEATSHEET_DIR/$new_name.md" ]]; then
        echo "${c[error]}error:${c[reset]} '$new_name' already exists — use ${c[flag]}cheat edit $new_name${c[reset]} to edit it"
        return 1
      fi
      cat >| "$new_file" <<TEMPLATE
# $new_name

> What it is for, in one line.

# Getting started

- The first thing to run:

\`$new_name\`

- Next: what to do once that works

# Everyday

- \`$new_name <command> [target] [--flag]\`: what it does

# More

- \`cheat $new_name <command>\`: every option of a command
- \`cheat zsh-config\`: everything zsh-config gives you
TEMPLATE
      echo "${c[success]}created:${c[reset]} $new_file"
      if ! link-cheatsheets "$CUSTOM_DIR/cheatsheets"; then
        echo "${c[warn]}warning:${c[reset]} $new_name was created but not linked into $CHEATSHEET_DIR"
      fi
      echo "run ${c[flag]}cheat edit $new_name${c[reset]} to fill it in, then ${c[flag]}cheatsheet-test $new_file${c[reset]}"
      ;;

    refresh)
      if ! is available tldr; then
        echo "${c[warn]}warn:${c[reset]} tldr not available"
        return 1
      fi
      tldr --update
      date +%s >| "$CHEATSHEET_DIR/.tldr-last-update"
      ;;

    raw)
      if is empty "$1"; then
        echo "${c[error]}error:${c[reset]} raw requires a sheet name" >&2
        return 1
      fi
      cheat "$@" --raw
      return $?
      ;;

    *)
      # Any other words name a sheet, joined with -. Flags are dropped, so
      # `<tool> <words> --help` can hand everything to `cheat <tool> <words>`.
      # A missing sheet falls back to its nearest parent: `cheat hub join all`
      # shows hub-join.md when there is no hub-join-all.md.
      local -a words=()
      local raw_mode=0 part
      for part in "$subcmd" "$@"; do
        case "$part" in
          --raw|-r) raw_mode=1 ;;
          -*) ;;
          *) words+=("${part%.md}") ;;
        esac
      done
      if (( ! $#words )); then
        cheat list
        return $?
      fi

      local -i n
      local sheet=""
      for (( n = $#words; n > 0; n-- )); do
        if is file "$CHEATSHEET_DIR/${(j:-:)words[1,n]}.md"; then
          sheet="$CHEATSHEET_DIR/${(j:-:)words[1,n]}.md"
          break
        fi
      done

      # A local parent loses to tldr's page for the exact words, so
      # `cheat git commit` still finds tldr's git-commit beside a local git.md
      if is not empty "$sheet" && (( n < $#words )) && is available tldr; then
        local -a exact_args=()
        (( raw_mode )) && exact_args=(--raw)
        if tldr "${exact_args[@]}" "${words[@]}" 2> /dev/null; then
          return 0
        fi
      fi

      if is not empty "$sheet"; then
        if (( n < $#words )); then
          echo "${c[info-small]}no sheet for \"${words[*]}\", showing \"${words[1,n]}\"${c[reset]}" >&2
        fi
        if (( raw_mode )); then
          cat "$sheet"
        else
          local _cheat_tmp; _cheat_tmp=$(mktemp)
          _cheat_expand_vars "$sheet" > "$_cheat_tmp"
          $render_cmd "${render_args[@]}" "$_cheat_tmp"
          rm -f "$_cheat_tmp"
        fi
        return 0
      fi

      # No local sheet: tldr's own pages, with the same parent fallback
      if is available tldr; then
        local -a tldr_args=()
        (( raw_mode )) && tldr_args=(--raw)
        for (( n = $#words; n > 0; n-- )); do
          if tldr "${tldr_args[@]}" "${words[1,n]}" 2> /dev/null; then
            return 0
          fi
        done
      fi
      echo "${c[error]}error:${c[reset]} no sheet for \"${words[*]}\"" >&2
      return 1
      ;;
  esac
}

cheat "$@"
