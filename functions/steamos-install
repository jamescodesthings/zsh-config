#!/usr/bin/env zsh

DESKTOP="${DESKTOP:-"$HOME/Desktop"}"
CUSTOM_STEAM="${CUSTOM_STEAM:-"$CUSTOM_DIR/steamos"}"

# _steamos_try <label> <command...>: run a step; a failure is recorded with
# the command to retry and the run carries on.
function _steamos_try() {
  local label="$1"
  shift
  if ! "$@"; then
    problem "$label failed"
    fix "${(j: :)${(q)@}}" "retry $label"
    return 1
  fi
}

function _steamos_install_subfn() {
  say info "installing SteamOS stuff (needs sudo)"

  say info "readonly disable"
  _steamos_try "readonly disable" sudo steamos-readonly disable

  say info "install script desktop entry"
  if is not link "$DESKTOP/steamos-install.desktop"; then
    _steamos_try "install script desktop entry" sudo ln -s "$CUSTOM_STEAM/steamos-install.desktop" "$DESKTOP/steamos-install.desktop" && say ok "done"
  else
    say ok "already installed"
  fi

  say info "VNC desktop entry"
  if is not link "$DESKTOP/start-vnc.desktop"; then
    _steamos_try "VNC desktop entry" sudo ln -s "$CUSTOM_STEAM/start-vnc.desktop" "$DESKTOP/start-vnc.desktop" && say ok "done"
  else
    say ok "already installed"
  fi

  say info "pacman keys"
  _steamos_try "pacman-key init" sudo pacman-key --init
  _steamos_try "pacman-key populate" sudo pacman-key --populate archlinux && say ok "done"

  say info "update pacman"
  _steamos_try "pacman update" sudo pacman -Syu --overwrite \* --noconfirm && say ok "done"

  say info "konsole"
  if is not available "konsole"; then
    _steamos_try "konsole install" sudo pacman -S --overwrite \* konsole --noconfirm && say ok "done"
  else
    say ok "already installed"
  fi

  say info "zsh"
  if is not available "zsh"; then
    if _steamos_try "zsh install" sudo pacman -S --overwrite \* zsh --noconfirm; then
      ZSH=$(which zsh)
      cat /etc/shells | grep $(which zsh)
      if is not equal "$?" "0"; then
        sudo echo "$ZSH" >> /etc/shells
      fi
      chsh -s "$ZSH"
      sudo chsh -s "$ZSH"
      say ok "done"
    fi
  else
    say ok "already installed"
  fi

  say info "sublime"
  if is not available "sublime"; then
    _steamos_try "sublime install" sudo pacman -S --overwrite \* sublime-text --noconfirm && say ok "done"
  else
    say ok "already installed"
  fi

  say info "VNC"
  if is not available "x0vncserver"; then
    _steamos_try "tigervnc install" sudo pacman -S --overwrite \* tigervnc --noconfirm
    _steamos_try "xorg-xinit install" sudo pacman -S --overwrite \* xorg-xinit --noconfirm && say ok "done"
  else
    say ok "already installed"
  fi

  say info "VNC password"
  if is not existing "$HOME/.vnc/passwd"; then
    _steamos_try "VNC password" sudo vncpasswd ~/.vnc/passwd && say ok "done"
  else
    say ok "already installed"
  fi

  say info "base-devel"
  _steamos_try "base-devel install" sudo pacman -S base-devel --overwrite \* --noconfirm && say ok "done"

  say info "fzf"
  _steamos_try "fzf install" sudo pacman -S fzf --overwrite \* --noconfirm && say ok "done"

  say info "yay"
  if is not existing "$HOME/projects/yay-bin"; then
    _steamos_try "yay clone" git clone https://aur.archlinux.org/yay-bin.git "$HOME/projects/yay-bin"
  fi
  (cd "$HOME/projects/yay-bin" && makepkg -si) || {
    problem "yay build failed"
    fix "cd $HOME/projects/yay-bin && makepkg -si" "retry the build"
  }

  if problems; then
    say ok "finished running all post-install steps"
  else
    return 1
  fi
}

function steamos-install() {
  cheat-help steamos-install "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init "$@"
  set -- "${@:#(--plain|-q|--quiet|-v|--verbose)}"

  if is not empty "$1"; then
    say fail "unknown argument: $1"
    return 2
  fi

  local DEPS=(is)
  if ! deps $DEPS; then
    return 1
  fi

  _steamos_install_subfn
  return $?
}

steamos-install "$@"
