#!/usr/bin/env zsh

function dsp() {
  cheat-help dsp "$@" && return 0
  local CLI_PLAIN="$CLI_PLAIN" CLI_QUIET="$CLI_QUIET" CLI_VERBOSE="$CLI_VERBOSE"
  cli-init ${(M)@:#--plain}
  set -- "${@:#--plain}"

  local DEPS=(docker)
  if ! deps "${DEPS[@]}"; then
    return 1
  fi

  say info "stopping all containers"
  docker stop $(docker ps -q) 2>/dev/null
  say info "pruning system"
  docker system prune -f "$@"
  local volumes
  volumes=$(docker volume ls -qf dangling=true)
  if is not empty "$volumes"; then
    say info "removing dangling volumes"
    docker volume rm $volumes
  else
    say info "no dangling volumes"
  fi
}

dsp "$@"
