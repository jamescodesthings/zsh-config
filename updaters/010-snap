#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available snap; then
  say info "skipping: snap not installed"
  exit 0
fi

say info "updating snap packages"
sudo snap refresh
if is not equal "$?" "0"; then
  say fail "snap refresh failed"
  exit 1
fi

say ok "snap packages updated"

exit 0
}
