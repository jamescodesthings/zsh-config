#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available flatpak; then
  echo "$c[info]skipping:$c[reset] flatpak not installed"
  exit 0
fi

echo "$c[info]updating:$c[reset] flatpak apps"
flatpak update -y --noninteractive
if is not equal "$?" "0"; then
  echo "$c[error]error:$c[reset] flatpak update failed"
  exit 1
fi

echo "$c[success]success:$c[reset] flatpak apps updated"

exit 0
}
