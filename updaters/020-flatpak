#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available flatpak; then
  say info "skipping: flatpak not installed"
  exit 0
fi

say info "updating flatpak apps"
flatpak update -y --noninteractive
if is not equal "$?" "0"; then
  say fail "flatpak update failed"
  exit 1
fi

say ok "flatpak apps updated"

exit 0
}
