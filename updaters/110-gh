#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available gh; then
  echo "$c[info]skipping:$c[reset] github cli not installed"
  exit 0
fi

echo "$c[info]updating:$c[reset] github cli extensions"
gh extension upgrade --all
if is not equal "$?" "0"; then
  echo "$c[error]error:$c[reset] gh extension upgrade failed"
  exit 1
fi

echo "$c[success]success:$c[reset] github cli extensions updated"

exit 0
}
