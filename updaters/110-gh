#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available gh; then
  say info "skipping: github cli not installed"
  exit 0
fi

say info "updating github cli extensions"
gh extension upgrade --all
if is not equal "$?" "0"; then
  say fail "gh extension upgrade failed"
  exit 1
fi

say ok "github cli extensions updated"

exit 0
}
