#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

VAULT_DIR="${OBSIDIAN_VAULT_DIR:-$HOME/projects/personal/obsidian}"

if is not dir "$VAULT_DIR/.git"; then
  echo "$c[info]skipping:$c[reset] no obsidian vault at $VAULT_DIR"
  exit 0
fi

# Notes are edited on more than one machine, so local work is stashed and
# replayed on top of the pull. A conflict is backed out again so the vault is
# never left half way through a rebase.
#
# The Obsidian app updates itself on launch, and its cli (1.12) can install
# and remove community plugins but has no command that updates them, so the
# vault is the only part of Obsidian this script can keep current.
echo "$c[info]updating:$c[reset] obsidian vault"
OUTPUT=$(git -C "$VAULT_DIR" pull --rebase --autostash 2>&1)

if is not equal "$?" "0"; then
  git -C "$VAULT_DIR" rebase --abort 2> /dev/null
  echo "$c[error]error:$c[reset] could not pull the vault, left as it was"
  echo "$OUTPUT"
  exit 1
fi

echo "$c[success]success:$c[reset] obsidian vault updated"

exit 0
}
