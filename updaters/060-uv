#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available uv; then
  echo "$c[info]skipping:$c[reset] uv not installed"
  exit 0
fi

# self update only works for the standalone installer; a uv that came from a
# package manager refuses it and is updated by that package manager instead.
echo "$c[info]updating:$c[reset] uv"
uv self update
if is not equal "$?" "0"; then
  echo "$c[warn]warning:$c[reset] uv self update refused, leaving uv to its package manager"
fi

echo "$c[info]updating:$c[reset] uv tools"
uv tool upgrade --all
if is not equal "$?" "0"; then
  echo "$c[error]error:$c[reset] uv tool upgrade failed"
  exit 1
fi

echo "$c[success]success:$c[reset] uv updated"

exit 0
}
