#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

# uv is an asdf tool (configs/asdf/update-policy), so 040-asdf installs and
# upgrades it. This updater only runs after it: it never installs uv and never
# runs `uv self update`, which would fight asdf.
if is not available uv; then
  say info "skipping: uv is not installed, 040-asdf installs it"
  exit 0
fi

# One-off cleanup of the copies uv had before asdf took it over. It waits
# until the asdf uv works, so a machine is never left without uv.
if asdf which uv > /dev/null 2>&1; then
  for old in "$HOME/.local/bin/uv" "$HOME/.local/bin/uvx" "$HOME/.config/uv/uv-receipt.json"; do
    if is existing "$old" || [[ -L "$old" ]]; then
      say info "removing $old, the standalone installer's copy"
      rm -f "$old"
    fi
  done
  if is osx && is available brew && brew list uv > /dev/null 2>&1; then
    say info "removing the homebrew uv"
    brew-isolated uninstall uv
    if is not equal "$?" "0"; then
      say warn "could not uninstall the homebrew uv"
    fi
  fi
  rehash
fi

say info "updating uv tools"
uv tool upgrade --all
if is not equal "$?" "0"; then
  say fail "uv tool upgrade failed"
  exit 1
fi

say ok "uv tools updated"

exit 0
}
