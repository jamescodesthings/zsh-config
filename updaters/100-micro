#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available micro; then
  say info "skipping: micro not installed"
  exit 0
fi

say info "updating micro plugins"
micro -plugin update
if is not equal "$?" "0"; then
  say fail "micro plugin update failed"
  exit 1
fi

say ok "micro plugins updated"

exit 0
}
