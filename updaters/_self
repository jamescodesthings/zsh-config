#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

say info "updating zsh-config"
OUTPUT=$(git -C "$REPO_DIR" pull --ff-only 2>&1)

if is not equal "$?" "0"; then
  say fail "git pull failed"
  echo "$OUTPUT"
  exit 1
fi

say ok "zsh-config updated"

check-or-load link-cheatsheets
# Stale-shell migration shim: a shell opened before the move still exports the old CHEATSHEET_DIR.
if is empty "$CHEATSHEET_DIR" || [[ "${CHEATSHEET_DIR:A}" == "${REPO_DIR:A}"/* ]]; then
  export CHEATSHEET_DIR="$HOME/cheatsheets"
fi
if ! link-cheatsheets "$REPO_DIR/cheatsheets"; then
  say warn "link-cheatsheets reported a problem, see above"
fi

exit 0
}
