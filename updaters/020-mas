#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available mas; then
  echo "$c[info]skipping:$c[reset] mas not installed (brew install mas)"
  exit 0
fi

# mas 2 and later refuse to upgrade without root; mas 1 refuses to run with it.
MAS=(mas)
if mas upgrade --help 2>&1 | grep -q 'Requires root'; then
  MAS=(sudo mas)
fi

# mas finds App Store apps through Spotlight and cannot check one that is not
# in the index, which happens to every app after a macOS upgrade and to single
# apps after they are replaced. Listing costs nothing and names the apps mas
# cannot see, so those are handed to mdimport, which indexes them on the spot.
SPOTLIGHT_PHRASE='not indexed in Spotlight'
SPOTLIGHT_WARNING="Warning: Found a likely App Store app that is $SPOTLIGHT_PHRASE in "
UNINDEXED_APPS=(${(f)"$(mas list 2>&1 | grep -F "$SPOTLIGHT_WARNING")"})
UNINDEXED_APPS=(${UNINDEXED_APPS#$SPOTLIGHT_WARNING})

if is not empty "$UNINDEXED_APPS" && is available mdimport; then
  echo "$c[info]indexing:$c[reset] ${#UNINDEXED_APPS} apps that spotlight had lost track of"
  mdimport $UNINDEXED_APPS
fi

# Anything still not indexed after that is counted and reported once, rather
# than once per app.
echo "$c[info]updating:$c[reset] mac app store apps"
MAS_OUTPUT=$(mktemp)
$MAS upgrade 2>&1 | tee "$MAS_OUTPUT" | grep -v "$SPOTLIGHT_PHRASE"
RESULT=${pipestatus[1]}
UNINDEXED=$(grep -c "$SPOTLIGHT_PHRASE" "$MAS_OUTPUT")
rm -f "$MAS_OUTPUT"

if is gt "$UNINDEXED" "0"; then
  echo "$c[warn]warning:$c[reset] mas could not check $UNINDEXED apps because Spotlight has not indexed them yet; it clears once indexing finishes"
fi

if is not equal "$RESULT" "0"; then
  echo "$c[error]error:$c[reset] mas upgrade failed"
  exit 1
fi

echo "$c[success]success:$c[reset] mac app store apps updated"

exit 0
}
