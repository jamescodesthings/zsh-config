#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

# 040-asdf installs node itself and makes it the global version; this looks
# after npm and the global packages that live inside that node.
if is not available npm; then
  say info "skipping: npm not installed"
  exit 0
fi

say info "updating npm"
npm install -g npm
if is not equal "$?" "0"; then
  say fail "npm self-update failed"
  exit 1
fi

say info "updating global npm packages"
npm update -g
if is not equal "$?" "0"; then
  say warn "could not update global npm packages"
fi

if is available asdf; then
  asdf reshim nodejs
fi

say ok "npm and global packages updated"

exit 0
}
