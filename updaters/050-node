#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

# 040-asdf installs node itself and makes it the global version; this looks
# after npm and the global packages that live inside that node.
if is not available npm; then
  echo "$c[info]skipping:$c[reset] npm not installed"
  exit 0
fi

echo "$c[info]updating:$c[reset] npm"
npm install -g npm
if is not equal "$?" "0"; then
  echo "$c[error]error:$c[reset] npm self-update failed"
  exit 1
fi

echo "$c[info]updating:$c[reset] global npm packages"
npm update -g
if is not equal "$?" "0"; then
  echo "$c[warn]warning:$c[reset] could not update global npm packages"
fi

if is available asdf; then
  asdf reshim nodejs
fi

echo "$c[success]success:$c[reset] npm and global packages updated"

exit 0
}
