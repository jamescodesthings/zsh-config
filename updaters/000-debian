#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is osx; then
  say info "skipping: debian updater is linux only"
  exit 0
fi

if is not available apt-get; then
  say info "skipping: apt not available"
  exit 0
fi

# --force-confold keeps the config file already on disk when a package ships
# a new one, which is the question dpkg would otherwise stop to ask.
# APT=(sudo DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
APT=(sudo DEBIAN_FRONTEND=noninteractive apt-get -y -o "Dpkg::Options::=--force-confdef" -o "Dpkg::Options::=--force-confold")

say info "updating apt packages"
# One broken third-party source makes apt-get update exit non-zero even
# though every other list refreshed, so that is a warning and the upgrade
# still runs on what it did fetch.
if ! "${APT[@]}" update; then
  say warn "apt-get update reported errors, a third-party apt source may be broken; upgrading from the lists it did fetch"
fi
"${APT[@]}" upgrade && "${APT[@]}" autoremove
if is not equal "$?" "0"; then
  say fail "apt upgrade failed"
  exit 1
fi

# The base list is shared with installers/02-apt-base, so tools added to it
# reach machines that were installed earlier.
BASE_PACKAGES=(${(f)"$(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$REPO_DIR/configs/apt/base")"})
if is not empty "$BASE_PACKAGES"; then
  say info "installing base packages"
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${BASE_PACKAGES[@]}"
  if is not equal "$?" "0"; then
    say fail "apt base package install failed"
    exit 1
  fi
fi

say ok "apt packages updated"

exit 0
}
