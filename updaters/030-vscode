#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available code; then
  say info "skipping: vscode cli not installed"
  exit 0
fi

say info "updating vscode extensions"
code --update-extensions
if is not equal "$?" "0"; then
  say fail "vscode extension update failed"
  exit 1
fi

say ok "vscode extensions updated"

exit 0
}
