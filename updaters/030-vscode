#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available code; then
  echo "$c[info]skipping:$c[reset] vscode cli not installed"
  exit 0
fi

echo "$c[info]updating:$c[reset] vscode extensions"
code --update-extensions
if is not equal "$?" "0"; then
  echo "$c[error]error:$c[reset] vscode extension update failed"
  exit 1
fi

echo "$c[success]success:$c[reset] vscode extensions updated"

exit 0
}
