#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not available tldr; then
  say info "skipping: tldr not installed"
  exit 0
fi

say info "updating tldr cache"
tldr --update
if is not equal "$?" "0"; then
  say fail "tldr update failed"
  exit 1
fi

say ok "tldr updated"

exit 0
}
