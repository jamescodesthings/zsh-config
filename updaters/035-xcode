#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

if is not osx; then
  echo "$c[info]skipping:$c[reset] xcode is macos only"
  exit 0
fi

if is not available xcodes; then
  echo "$c[info]skipping:$c[reset] xcodes not installed (it is in configs/brew/Brewfile)"
  exit 0
fi

# Lists the release versions of Xcode that are installed, one per line as
# "version<TAB>path". A beta has a word between the version and the build
# number, a release does not, which is how the two are told apart.
function installed-releases() {
  local line
  for line in ${(f)"$(xcodes installed --no-color 2> /dev/null)"}; do
    if [[ "$line" =~ '^([0-9]+(\.[0-9]+)*) \(' ]]; then
      print -r -- "$match[1]"$'\t'"${line##*$'\t'}"
    fi
  done
}

# --latest installs the newest release and does nothing when it is already
# here, which needs no Apple ID. A real download does need one: xcodes keeps
# the login in the keychain, and when that session runs out it wants a 2FA
# code, which it cannot ask for here. --no-superuser stops xcodes showing a
# password prompt of its own; the steps it skips are run below with sudo.
echo "$c[info]updating:$c[reset] xcode"
xcodes install --latest --no-superuser --experimental-unxip --empty-trash --no-color
if is not equal "$?" "0"; then
  echo "$c[error]error:$c[reset] xcodes could not install the latest xcode"
  echo "$c[warn]warning:$c[reset] if it asked to sign in, run this once by hand: xcodes install --latest"
  exit 1
fi

RELEASES=(${(f)"$(installed-releases)"})
LATEST=$(print -l ${RELEASES%%$'\t'*} | sort -V | tail -n 1)

if is empty "$LATEST"; then
  echo "$c[error]error:$c[reset] xcodes reports no installed release of xcode"
  exit 1
fi

for release in $RELEASES; do
  if is equal "${release%%$'\t'*}" "$LATEST"; then
    LATEST_APP="${release##*$'\t'}"
  fi
done

# The newest release becomes the selected one, with its licence accepted and
# its first-launch packages installed, so command line builds work untouched.
if is not equal "$(xcode-select -p 2> /dev/null)" "$LATEST_APP/Contents/Developer"; then
  echo "$c[info]selecting:$c[reset] xcode $LATEST"
  sudo xcode-select -s "$LATEST_APP"
  if is not equal "$?" "0"; then
    echo "$c[error]error:$c[reset] could not select $LATEST_APP"
    exit 1
  fi
fi

sudo xcodebuild -license accept
if is not equal "$?" "0"; then
  echo "$c[warn]warning:$c[reset] could not accept the xcode licence"
fi

xcodebuild -checkFirstLaunchStatus
if is not equal "$?" "0"; then
  echo "$c[info]installing:$c[reset] xcode first-launch packages"
  sudo xcodebuild -runFirstLaunch
  if is not equal "$?" "0"; then
    echo "$c[warn]warning:$c[reset] xcode first-launch setup failed"
  fi
fi

# Older releases go once the newest is in place. Betas are left alone.
for release in $RELEASES; do
  VERSION="${release%%$'\t'*}"
  if is equal "$VERSION" "$LATEST"; then
    continue
  fi
  echo "$c[info]removing:$c[reset] xcode $VERSION"
  xcodes uninstall "$VERSION" --empty-trash --no-color
  if is not equal "$?" "0"; then
    echo "$c[warn]warning:$c[reset] could not remove xcode $VERSION"
  fi
done

echo "$c[success]success:$c[reset] xcode $LATEST is installed and selected"

exit 0
}
