#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

# hub comes from agent-forge, on PATH through its projects/ drop-in.
# "hub project --update update" refreshes the GitHub repo cache, then pulls
# every installed project with git pull --ff-only and runs that project's
# installer, printing an ok or FAIL line for each and exiting 1 if any failed.
# It never prompts without a terminal. This is how agent-forge itself is
# updated: James runs `hub down`, then `update`, then `hub`. Never call
# `hub update` from here; `update` stays separate from agent-forge's cycle.
if ! whence hub > /dev/null; then
  echo "$c[info]skipping:$c[reset] hub not installed (it comes with agent-forge)"
  exit 0
fi

echo "$c[info]updating:$c[reset] every installed project"
hub project --update update
if is not equal "$?" "0"; then
  echo "$c[error]error:$c[reset] hub project update failed for at least one project, see the FAIL lines above"
  exit 1
fi

echo "$c[success]success:$c[reset] projects updated"

exit 0
}
