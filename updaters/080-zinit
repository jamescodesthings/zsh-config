#!/usr/bin/env zsh
# Wrapped in braces so zsh parses the whole file before running it; see ../update.
{
source "${0:a:h}/_stub"

# zinit is a shell function, so it only exists once zinit.zsh is sourced; a
# script does not inherit it from the interactive shell.
ZINIT_SCRIPT="$HOME/.zinit/zinit.git/zinit.zsh"

if is not file "$ZINIT_SCRIPT"; then
  say info "skipping: zinit not installed"
  exit 0
fi

source "$ZINIT_SCRIPT"

say info "updating zinit"
zinit self-update
if is not equal "$?" "0"; then
  say fail "zinit self-update failed"
  exit 1
fi

say info "updating zinit plugins"
zinit update --all --parallel
if is not equal "$?" "0"; then
  say fail "zinit plugin update failed"
  exit 1
fi

say ok "zinit updated"

exit 0
}
