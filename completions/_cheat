#compdef cheat

# Completes cheat's subcommands and sheet names word by word: after
# `cheat hub `, the words that follow hub in hub-*.md (join, status, ...).
_cheat() {
  local -a sheets next subcommands
  if [[ -n "$CHEATSHEET_DIR" && -d "$CHEATSHEET_DIR" ]]; then
    sheets=("$CHEATSHEET_DIR"/*.md(N-.:t:r))
  fi

  if (( CURRENT == 2 )); then
    subcommands=(
      'list:list local sheets'
      'search:search local sheets and tldr by name'
      'edit:open a sheet in $EDITOR'
      'new:create a sheet from the template'
      'refresh:refresh the tldr cache'
      'raw:print a sheet'"'"'s markdown'
      'help:show cheat'"'"'s own sheet'
    )
    _describe -t subcommands 'subcommand' subcommands
    compadd -- ${(u)sheets%%-*}
    return
  fi

  # The words typed so far, flags left out, joined as a sheet name prefix
  local -a typed
  typed=(${${words[2,CURRENT-1]}:#-*})
  case "$typed[1]" in
    list|refresh|help|search|new) return 1 ;;
    edit|raw) typed=("${(@)typed[2,-1]}") ;;
  esac

  local prefix="${(j:-:)typed}"
  if [[ -n "$prefix" ]]; then
    next=(${(M)sheets:#$prefix-*})
    next=(${${next#$prefix-}%%-*})
  else
    next=(${sheets%%-*})
  fi
  compadd -- ${(u)next}
  _arguments '--raw[print the markdown instead of rendering it]'
}

_cheat "$@"
