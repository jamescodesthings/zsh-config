#compdef md-to-pdf

_md-to-pdf() {
  _arguments \
    '*'{-r,--recursive}'[convert every .md under a folder]:folder:_files -/' \
    '--combine[also join the pdfs into <this folder>.pdf here]' \
    '(-f --force)'{-f,--force}'[replace an existing combined pdf]' \
    '--plain[no colour or animation]' \
    '(-q --quiet)'{-q,--quiet}'[print only warnings and errors]' \
    '(-h --help)'{-h,--help}'[show the sheet]' \
    '*:markdown file:_files -g "*.md"'
}

_md-to-pdf "$@"
