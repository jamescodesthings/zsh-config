#compdef hist

_hist() {
  local -a subcommands
  subcommands=(
    'list:list history, deduplicated'
    'search:search history by regex'
    'delete:delete matching lines'
    'open:open the history folder'
    'clean:remove history of missing folders'
    'move:carry history to a moved folder'
    'stats:line counts per folder'
    'help:show the sheet'
  )
  if (( CURRENT == 2 )); then
    _describe -t subcommands 'subcommand' subcommands
    return
  fi
  case "$words[2]" in
    list|search) _arguments '(-q --quiet)'{-q,--quiet}'[no headers]' '*: :' ;;
    move) _arguments '--dry-run[show the plan only]' '*:folder:_files -/' ;;
    *) _message 'no more arguments' ;;
  esac
}

_hist "$@"
