#compdef reload

_reload() {
  local -a names
  names=("${CUSTOM_DIR:-$HOME/.custom}"/functions/*(N:t))
  _arguments \
    '--plain[no colour or animation]' \
    '(-q --quiet)'{-q,--quiet}'[print only warnings and errors]' \
    '(-h --help)'{-h,--help}'[show the sheet]' \
    ':function:(all '"${names}"')'
}

_reload "$@"
