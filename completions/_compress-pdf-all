#compdef compress-pdf-all

_compress-pdf-all() {
  _arguments \
    '(-r --recursive)'{-r,--recursive}'[also every folder below, or below a given folder]::folder:_files -/' \
    '(-h --help)'{-h,--help}'[show help]' \
    '--plain[no colour]' \
    '(-q --quiet)'{-q,--quiet}'[say less]' '(-v --verbose)'{-v,--verbose}'[say more]'
}

_compress-pdf-all "$@"
