#compdef md

_md() {
  _arguments \
    '--plain[no colour or animation]' \
    '(-q --quiet)'{-q,--quiet}'[print only warnings and errors]' \
    '(-h --help)'{-h,--help}'[show the sheet]' \
    '(--no-follow)--no-follow[create the directory without cd-ing into it]' \
    ':directory:_files -/'
}

_md "$@"
