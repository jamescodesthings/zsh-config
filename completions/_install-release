#compdef install-release

_install_release_names() {
  local -a names
  names=(${(f)"$(awk '!/^#/ && NF {print $1}' "${CUSTOM_DIR:-$HOME/.custom}/configs/releases" 2>/dev/null)"})
  compadd -- $names
}

_install-release() {
  _arguments \
    '--plain[no colour or animation]' \
    '(-q --quiet)'{-q,--quiet}'[print only warnings and errors]' \
    '(-h --help)'{-h,--help}'[show the sheet]' \
    ':binary:_install_release_names'
}

_install-release "$@"
